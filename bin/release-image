#!/usr/bin/env bash
# Build the self-host image on a remote Docker host (the laptop has no
# daemon) and publish it to ghcr.io so install.sh can pull instead of build.
#
#   bin/release-image                 # version = YYYY.MM.DD-<sha7>, also tags :latest
#   bin/release-image 0.9.0           # explicit version
#   bin/release-image --no-push       # build + boot-check only (no registry login)
#
# Env: BUILD_HOST (ssh target, default the Tencent build box), GH_USER.
# Needs a gh token with write:packages for pushes:
#   gh auth refresh -h github.com -s write:packages,read:packages --user johannesdwicahyo
set -euo pipefail
cd "$(dirname "$0")/.."

PUSH=1
VERSION=""
for arg in "$@"; do
  case "$arg" in
    --no-push) PUSH=0 ;;
    -*) echo "unknown option $arg" >&2; exit 2 ;;
    *) VERSION="$arg" ;;
  esac
done
VERSION=${VERSION:-$(date -u +%Y.%m.%d)-$(git rev-parse --short=7 HEAD)}
[[ "$VERSION" =~ ^[0-9A-Za-z._-]+$ ]] || { echo "bad version: $VERSION" >&2; exit 2; }
HOST=${BUILD_HOST:-ubuntu@43.165.195.185}
GH_USER=${GH_USER:-johannesdwicahyo}
IMAGE=ghcr.io/johannesdwicahyo/wokku
DIR=wokku-image-build
SSH=(ssh -o ServerAliveInterval=30 "$HOST")

[ -z "$(git status --porcelain --untracked-files=no)" ] ||
  echo "note: uncommitted changes are NOT in the image (it builds from HEAD)" >&2

echo "→ shipping $(git rev-parse --short HEAD) to $HOST"
git archive HEAD | gzip -6 | "${SSH[@]}" "rm -rf ~/$DIR && mkdir ~/$DIR && tar -xz -C ~/$DIR"

echo "→ building $IMAGE:$VERSION"
"${SSH[@]}" "cd ~/$DIR && DOCKER_BUILDKIT=1 docker build -q --build-arg WOKKU_VERSION=$VERSION \
  -f harness/Dockerfile -t $IMAGE:$VERSION -t $IMAGE:latest ." >/dev/null
"${SSH[@]}" "docker image inspect $IMAGE:$VERSION --format 'size: {{.Size}} bytes'"

# Fresh-install gate: the image must boot on an EMPTY database and serve
# /up before it may be published (a fresh-install break shipped unnoticed
# from 2026-10-19 to 11-16). Only this test's containers/volumes are removed.
echo "→ boot test on an empty database"
"${SSH[@]}" "set -e; N=wokku-boottest-\$\$; IMG=$IMAGE:$VERSION
  cleanup() { docker rm -f -v \$N-web \$N-db >/dev/null 2>&1 || true; docker network rm \$N >/dev/null 2>&1 || true; }
  trap cleanup EXIT
  docker network create \$N >/dev/null
  docker run -d --name \$N-db --network \$N -e POSTGRES_USER=wokku -e POSTGRES_PASSWORD=wokku -e POSTGRES_DB=wokku_oss_harness_production postgres:16 >/dev/null
  for i in \$(seq 1 30); do docker exec \$N-db pg_isready -U wokku >/dev/null 2>&1 && break; sleep 2; done
  docker run -d --name \$N-web --network \$N -e PGHOST=\$N-db -e PGUSER=wokku -e PGPASSWORD=wokku -e WOKKU_FORCE_SSL=0 \
    -e SECRET_KEY_BASE=\$(openssl rand -hex 64) -e WOKKU_CANONICAL_DOMAIN=localhost \$IMG >/dev/null
  for i in \$(seq 1 60); do
    if docker exec \$N-web curl -fsS -o /dev/null -m 2 http://127.0.0.1:3000/up 2>/dev/null; then
      # Healthy once isn't enough: Solid Queue can die seconds later and take
      # Puma with it (stale recurring.yml, 2026-11-16). Must still be up.
      sleep 30
      [ \"\$(docker inspect -f '{{.State.Running}}' \$N-web)\" = true ] && docker exec \$N-web curl -fsS -o /dev/null -m 2 http://127.0.0.1:3000/up 2>/dev/null && { echo '  boot ok (still serving after 30s)'; exit 0; }
      break
    fi
    [ \"\$(docker inspect -f '{{.State.Running}}' \$N-web)\" = true ] || break
    sleep 3
  done
  echo '  BOOT FAILED — last log lines:'; docker logs --tail 15 \$N-web 2>&1 | cut -c1-200; exit 1"

if [ "$PUSH" = 1 ]; then
  echo "→ pushing to ghcr.io"
  gh auth token --user "$GH_USER" | "${SSH[@]}" "docker login ghcr.io -u $GH_USER --password-stdin >/dev/null"
  "${SSH[@]}" "docker push -q $IMAGE:$VERSION && docker push -q $IMAGE:latest; rc=\$?; docker logout ghcr.io >/dev/null; exit \$rc"
  echo "✓ published $IMAGE:$VERSION and :latest"
else
  echo "✓ built $IMAGE:$VERSION (not pushed)"
fi
"${SSH[@]}" "rm -rf ~/$DIR"
