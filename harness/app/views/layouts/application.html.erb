<%# The HOST owns the outer chrome (same contract as the root route):
    the cloud's application layout is its marketing shell; this is the
    self-host's minimal one. Engine pages (devise, docs fallback, any
    view without a specific layout) render inside it. %>
<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Wokku" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-bg text-ink antialiased" style="font-family: var(--font-sans-brutal);">
    <%= yield %>
  </body>
</html>
