# Minimal host app that boots the Wokku engine standalone (null providers).
# Gems here are the engine's effective runtime deps — promoting them into
# wokku.gemspec with curated versions is a tracked P2 follow-up.
source "https://rubygems.org"

gem "wokku", path: ".."

gem "rails", "~> 8.1"
gem "pg"
gem "puma"
gem "propshaft"
gem "tailwindcss-rails"
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "chartkick"
gem "view_component"
gem "commonmarker"
gem "rouge"
gem "rqrcode"
gem "devise"
gem "devise-two-factor"
gem "omniauth"
gem "omniauth-rails_csrf_protection"
gem "pundit"
gem "solid_queue"
gem "net-ssh"
gem "ed25519"
gem "bcrypt_pbkdf"
gem "sentry-ruby"
gem "sentry-rails"
gem "rack-attack"
# GithubApp (repo connect/deploys) drives Octokit; faraday-retry because
# Faraday 2 split retry middleware into its own gem and octokit expects it.
gem "octokit"
gem "faraday-retry"
# PushNotificationService (mobile app push) — Expo server SDK.
gem "expo-server-sdk"
gem "csv"
gem "bootsnap", require: false
