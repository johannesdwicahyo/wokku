#!/usr/bin/env bash
# Wokku connect-a-server installer — served by your control plane.
#
#   curl -sSL <%= control_url %>/install/wokkud.sh | sudo bash -s -- <INGEST_TOKEN> [--no-harden]
#
# Phase 1 hardens a fresh Ubuntu/Debian host (security auto-updates,
# firewall, fail2ban, SSH hardening — with lockout guards). Phase 2
# installs the Wokku runtime: Docker + Swarm, local registry, Caddy,
# nixpacks, and the wokkud agent pointing at this control plane.
# Idempotent — safe to re-run.
set -euo pipefail

TOKEN="${1:?usage: ... | sudo bash -s -- <ingest-token> [--no-harden]}"
HARDEN=1
[ "${2:-}" = "--no-harden" ] && HARDEN=0
# install.sh (same box) sets WOKKU_CONTROL_URL=http://127.0.0.1:3000: under
# force_ssl the URL baked in here is https://, which loopback can't speak.
CONTROL_URL="${WOKKU_CONTROL_URL:-<%= control_url %>}"

[ "$(id -u)" = "0" ] || { echo "run with sudo"; exit 1; }
export DEBIAN_FRONTEND=noninteractive

log() { printf "\n→ %s\n" "$*"; }

# ── Phase 1: prepare + harden ────────────────────────────────────────────
if [ "$HARDEN" = "1" ]; then
  log "security auto-updates (unattended-upgrades, security pocket)"
  apt-get update -qq
  apt-get install -y -qq unattended-upgrades >/dev/null
  cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

  log "firewall (ufw): allow ssh/80/443, deny the rest"
  apt-get install -y -qq ufw >/dev/null
  # awk consumes all input (no early exit): an exiting consumer SIGPIPEs
  # sshd under pipefail and kills the whole script (exit 141).
  SSH_PORT=$(sshd -T 2>/dev/null | awk '/^port /{if(!p)p=$2} END{print p}')
  SSH_PORT="${SSH_PORT:-22}"
  ufw allow "${SSH_PORT}/tcp" >/dev/null
  ufw allow 80/tcp >/dev/null
  ufw allow 443/tcp >/dev/null
  ufw --force enable >/dev/null

  log "fail2ban (sshd jail)"
  apt-get install -y -qq fail2ban >/dev/null
  cat > /etc/fail2ban/jail.d/wokku-sshd.local <<EOF
[sshd]
enabled = true
port = ${SSH_PORT}
EOF
  systemctl enable --now fail2ban >/dev/null 2>&1 || true
  systemctl restart fail2ban || true

  # SSH key-only — ONLY when the invoking user actually has a key
  # installed, so this can never lock you out.
  REAL_USER="${SUDO_USER:-root}"
  REAL_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
  if [ -s "${REAL_HOME}/.ssh/authorized_keys" ]; then
    log "ssh hardening: key-only auth (authorized_keys present for ${REAL_USER})"
    cat > /etc/ssh/sshd_config.d/50-wokku.conf <<'EOF'
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
EOF
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
  else
    log "ssh hardening SKIPPED: no authorized_keys for ${REAL_USER} (would lock you out)"
  fi
else
  log "hardening skipped (--no-harden)"
fi

# ── Phase 2: wokku runtime ───────────────────────────────────────────────
# Small servers: npm/bundler builds can exceed RAM with no swap and get
# OOM-killed. Add 2 GB of swap once on boxes under 4 GB that have none
# (some VPS types forbid swap — warn and carry on).
if [ -z "$(swapon --noheadings)" ] && [ "$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)" -lt 4096 ] && [ ! -e /swapfile ]; then
  log "swap: 2 GB /swapfile (under 4 GB RAM, no swap)"
  if fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile >/dev/null && swapon /swapfile; then
    grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
  else
    echo "  ! could not enable swap on this server — large builds may run out of memory"
    rm -f /swapfile
  fi
fi

log "docker"
command -v docker >/dev/null 2>&1 || { apt-get update -qq; apt-get install -y -qq docker.io >/dev/null; }
# nixpacks builds need buildx; Ubuntu/Debian docker.io ships without it
# (Docker's own docker-ce packages include it, so this is a no-op there).
docker buildx version >/dev/null 2>&1 || { apt-get update -qq; apt-get install -y -qq docker-buildx >/dev/null || echo "  ! could not install docker-buildx — source builds will fail until buildx is installed"; }
systemctl enable --now docker >/dev/null 2>&1 || true

log "docker swarm"
# Not `docker info | grep -q`: under pipefail grep's early exit SIGPIPEs
# docker (141) and a re-run tried to init an existing swarm.
[ "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = active ] || \
  docker swarm init --advertise-addr "$(hostname -I | awk '{print $1}')" >/dev/null

# Deployed apps are published on Swarm ingress ports (20000-29999). Docker's
# own iptables chains bypass ufw, so those ports would be reachable on the
# public interface, skirting Caddy's TLS/redirects/maintenance pages. Caddy
# dials apps on 127.0.0.1, so dropping EXTERNAL new connections to the range
# in DOCKER-USER (Docker's user-owned chain, evaluated before its ACCEPTs)
# closes the hole without touching loopback or the Swarm mesh ports. A tiny
# oneshot re-applies it after docker on boot (plain iptables rules don't
# survive a reboot).
log "firewall: block external access to app ports (Caddy dials loopback)"
cat > /usr/local/bin/wokku-app-port-firewall <<'FW'
#!/usr/bin/env bash
set -uo pipefail
EXT_IF=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'dev \K\S+' || echo eth0)
# $1 = iptables|ip6tables, $2 = required(1)|optional(0). Returns non-zero on
# a genuine failure so the oneshot fails LOUD (never fail-open silently).
apply() {
  local ipt="$1" required="$2"
  if ! "$ipt" -L DOCKER-USER -n >/dev/null 2>&1; then
    # v4 DOCKER-USER must exist post-docker.service; v6 legitimately absent
    # when Docker's IPv6 is off.
    [ "$required" = 1 ] && { echo "$ipt: DOCKER-USER chain missing" >&2; return 1; }
    return 0
  fi
  "$ipt" -C DOCKER-USER -i "$EXT_IF" -p tcp --dport 20000:29999 -m conntrack --ctstate NEW -j DROP 2>/dev/null && return 0
  "$ipt" -I DOCKER-USER -i "$EXT_IF" -p tcp --dport 20000:29999 -m conntrack --ctstate NEW -j DROP
}
# Apps bind on :::<port> (IPv6 wildcard), so a box with public IPv6 would be
# reachable over v6 even with the v4 rule in place — cover both families.
apply iptables 1 || exit 1
apply ip6tables 0 || exit 1
FW
chmod +x /usr/local/bin/wokku-app-port-firewall
cat > /etc/systemd/system/wokku-app-port-firewall.service <<'FW'
[Unit]
Description=Wokku: drop external access to Swarm-published app ports
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/wokku-app-port-firewall
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
FW
systemctl daemon-reload
systemctl enable --now wokku-app-port-firewall >/dev/null 2>&1 || \
  { echo "app-port firewall failed to apply"; journalctl -u wokku-app-port-firewall --no-pager | tail -5; exit 1; }

log "local registry (127.0.0.1:5000)"
docker inspect wokku-registry >/dev/null 2>&1 || docker run -d --restart=always --name wokku-registry \
  -p 127.0.0.1:5000:5000 \
  -e REGISTRY_STORAGE_DELETE_ENABLED=true \
  -v /var/lib/wokku-registry:/var/lib/registry \
  registry:2 >/dev/null

# Pins duplicated from wokkud/deploy/install.sh — keep in sync.
NIXPACKS_VERSION="1.41.0"
NIXPACKS_SHA256="0f55de7874507b9cf7502113120bd96f2ab6979f78d10eaf2eb2ade9207b3af6"
if ! command -v nixpacks >/dev/null 2>&1; then
  log "nixpacks ${NIXPACKS_VERSION} (pinned + checksummed)"
  curl -sL -o /tmp/nixpacks.tar.gz "https://github.com/railwayapp/nixpacks/releases/download/v${NIXPACKS_VERSION}/nixpacks-v${NIXPACKS_VERSION}-x86_64-unknown-linux-musl.tar.gz"
  echo "${NIXPACKS_SHA256}  /tmp/nixpacks.tar.gz" | sha256sum -c - >/dev/null
  tar -xzf /tmp/nixpacks.tar.gz -C /usr/local/bin nixpacks && rm /tmp/nixpacks.tar.gz
fi

CADDY_VERSION="2.11.4"
CADDY_SHA512="8220d1f013b6f27510247b2360c9e0ca9f018feebd82515f07635318b34ff9777ccc8fd0b6e6f2486ce3a33fe389fbb7db12d05baa474f4587509fb4f5ebf1c9"
if ! command -v caddy >/dev/null 2>&1; then
  log "caddy ${CADDY_VERSION} (pinned + checksummed)"
  curl -sL -o /tmp/caddy.tar.gz "https://github.com/caddyserver/caddy/releases/download/v${CADDY_VERSION}/caddy_${CADDY_VERSION}_linux_amd64.tar.gz"
  echo "${CADDY_SHA512}  /tmp/caddy.tar.gz" | sha512sum -c - >/dev/null
  tar -xzf /tmp/caddy.tar.gz -C /usr/local/bin caddy && rm /tmp/caddy.tar.gz
fi

log "wokkud agent from ${CONTROL_URL}"
curl -fsSL -o /usr/local/bin/wokkud.new "${CONTROL_URL}/install/wokkud"
chmod +x /usr/local/bin/wokkud.new

mkdir -p /etc/wokkud /etc/wokku/caddy/certs
chmod 700 /etc/wokku/caddy /etc/wokku/caddy/certs
umask 077
printf 'WOKKUD_URL=%s\nWOKKUD_TOKEN=%s\n' "${CONTROL_URL}" "${TOKEN}" > /etc/wokkud/env
umask 022
[ -f /etc/wokku/caddy/config.json ] || printf '%s\n' '{"admin":{"listen":"127.0.0.1:2019"}}' > /etc/wokku/caddy/config.json

cat > /etc/systemd/system/wokkud.service <<'WOKKU_UNIT'
<%= wokkud_unit -%>
WOKKU_UNIT
cat > /etc/systemd/system/wokku-caddy.service <<'WOKKU_UNIT'
<%= caddy_unit -%>
WOKKU_UNIT

# mv (not enable --now): --now no-ops when already running, silently
# leaving an OLD binary live.
mv /usr/local/bin/wokkud.new /usr/local/bin/wokkud
systemctl daemon-reload
systemctl enable --now wokku-caddy || { echo "wokku-caddy failed to start (is port 80/443 in use?)"; journalctl -u wokku-caddy --no-pager | tail -5; exit 1; }
systemctl enable wokkud >/dev/null 2>&1
systemctl restart wokkud

# Warm the build cache in the background, once: the first nixpacks build on
# a fresh box downloads nixpkgs + the Node toolchain (~10 min on 1 vCPU). A
# throwaway Node 22 build has the same package set as the Node templates
# (nodejs_22 + npm-9_x), so the user's first Node deploy reuses that layer.
if [ ! -f /var/lib/wokku/build-cache-warmed ] && command -v systemd-run >/dev/null; then
  log "warming the build cache in the background (~10 min; deploys work meanwhile)"
  WARM=$(mktemp -d)
  printf '{"name":"wokku-warmup","version":"1.0.0","engines":{"node":"22"},"scripts":{"start":"node -e 0"}}\n' > "$WARM/package.json"
  systemd-run --unit=wokku-build-warmup --quiet --collect sh -c \
    "nixpacks build '$WARM' --name wokku-build-warmup >/var/log/wokku-build-warmup.log 2>&1 \
     && mkdir -p /var/lib/wokku && touch /var/lib/wokku/build-cache-warmed; \
     docker rmi wokku-build-warmup >/dev/null 2>&1; rm -rf '$WARM'" || true
fi

log "done — the server should heartbeat within ~30s; watch its status in the dashboard."
