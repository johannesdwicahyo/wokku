<div data-controller="slide-panel">
  <div class="flex items-center justify-between gap-3 flex-wrap mb-6">
    <div>
      <h1 class="font-mono text-xl font-semibold tracking-tighter text-ink"># <%= t("dashboard.servers.title") %></h1>
      <p class="mt-0.5 font-mono text-sm text-dim">
        // <% if @can_manage %>manage your servers<% else %>pick a server when deploying — read-only for non-admins<% end %>
      </p>
    </div>
    <% if @can_manage %>
      <button data-action="click->slide-panel#open" class="inline-flex items-center px-3 py-1.5 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer">+ <%= t("dashboard.servers.add_server") %></button>
    <% end %>
  </div>

  <% if @servers.any? %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% @servers.each do |server| %>
        <%
          live = server.live_metrics_fresh?
          if live
            allocated = server.live_mem_used_mb
            total = server.live_mem_total_mb
            pct = server.live_mem_pct
            cpu_pct = server.live_cpu_pct
            cont_count = server.live_container_count
          else
            allocated = server.allocated_memory_mb
            total = server.capacity_total_mb_or_nil
            pct = server.capacity_pct
            cpu_pct = nil
            cont_count = nil
          end
          pct_color = pct.nil? ? "bg-dim" : (pct > 85 ? "bg-danger" : pct > 65 ? "bg-warn" : "bg-accent")
        %>
        <%= link_to admin_server_path(server), class: "block border-1.5 border-ink bg-paper hover:bg-bg-deep transition p-4 font-mono" do %>
          <div class="flex items-start justify-between mb-3">
            <div class="min-w-0">
              <p class="text-sm font-bold text-ink truncate"><%= server.name %></p>
              <p class="text-[11px] text-dim mt-0.5"><%= server.host %><% if server.region.present? %> · <%= server.region %><% end %></p>
            </div>
            <% case server.status %>
            <% when "connected" %>
              <span class="inline-flex items-center text-[10px] text-success"><span class="w-1.5 h-1.5 bg-success mr-1"></span><%= t("dashboard.servers.connected") %></span>
            <% when "unreachable" %>
              <span class="inline-flex items-center text-[10px] text-danger"><span class="w-1.5 h-1.5 bg-danger mr-1"></span><%= t("dashboard.servers.unreachable") %></span>
            <% when "auth_failed" %>
              <span class="inline-flex items-center text-[10px] text-warn"><span class="w-1.5 h-1.5 bg-warn mr-1"></span><%= t("dashboard.servers.auth_failed") %></span>
            <% when "syncing" %>
              <span class="inline-flex items-center text-[10px] text-warn"><span class="w-1.5 h-1.5 bg-warn animate-pulse mr-1"></span><%= t("dashboard.servers.syncing") %></span>
            <% end %>
          </div>

          <div class="space-y-2">
            <div>
              <div class="flex items-center justify-between text-[10px] text-dim mb-1">
                <span class="uppercase tracking-widest"><%= live ? "Memory (live)" : "Capacity" %></span>
                <span>
                  <% if pct %><%= pct %>% (<%= allocated %>MB / <%= total %>MB)<% else %><%= allocated %>MB allocated<% end %>
                </span>
              </div>
              <div class="h-1.5 bg-bg border border-rule-soft relative">
                <div class="absolute inset-0 <%= pct_color %>" style="width: <%= pct ? [pct, 100].min : 0 %>%"></div>
              </div>
            </div>

            <% if cpu_pct %>
              <div>
                <div class="flex items-center justify-between text-[10px] text-dim mb-1">
                  <span class="uppercase tracking-widest">CPU (live)</span>
                  <span><%= cpu_pct %>%</span>
                </div>
                <div class="h-1.5 bg-bg border border-rule-soft relative">
                  <% cpu_color = cpu_pct > 80 ? "bg-danger" : cpu_pct > 50 ? "bg-warn" : "bg-accent" %>
                  <div class="absolute inset-0 <%= cpu_color %>" style="width: <%= [cpu_pct, 100].min %>%"></div>
                </div>
              </div>
            <% end %>

            <div class="flex items-center justify-between text-[11px] text-dim">
              <span>
                <%= server.app_records.size %> apps
                <% if cont_count %><span class="text-dim"> · <%= cont_count %> containers</span><% end %>
              </span>
              <span>:<%= server.port %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 border-1.5 border-ink bg-paper">
      <h3 class="font-mono text-sm font-medium text-ink-soft">// <%= t("dashboard.servers.no_servers") %></h3>
      <% if @can_manage %>
        <p class="mt-1 font-mono text-xs text-dim">Connect your first server — one command, no SSH keys.</p>
        <div class="mt-4">
          <button data-action="click->slide-panel#open" class="inline-flex items-center px-3 py-1.5 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer">+ <%= t("dashboard.servers.add_server") %></button>
        </div>
      <% else %>
        <p class="mt-1 font-mono text-xs text-dim">No platform servers available yet — check back soon.</p>
      <% end %>
    </div>
  <% end %>

  <% if @can_manage %>
    <%= render layout: "dashboard/shared/slide_panel", locals: { title: t("dashboard.servers.add_server"), subtitle: "Register it, then connect with one command" } do %>
      <%= render "form", server: @server %>
    <% end %>
  <% end %>
</div>
