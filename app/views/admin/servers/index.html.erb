<div data-controller="slide-panel">
  <div class="flex items-center justify-between mb-5">
    <div>
      <h1 class="font-headline text-2xl font-extrabold tracking-tight"><%= t("dashboard.servers.title") %></h1>
      <p class="mt-0.5 text-sm text-dim">
        <% if @can_manage %><%= t("sweep.manage_servers") %><% else %><%= t("sweep.pick_server") %><% end %>
      </p>
    </div>
    <% if @can_manage %>
      <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, data: { action: "click->slide-panel#open" }) do %><%= t("dashboard.servers.add_server") %><% end %>
    <% end %>
  </div>

  <% if @servers.any? %>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% @servers.each do |server| %>
        <%
          live = server.live_metrics_fresh?
          if live
            allocated = server.live_mem_used_mb
            total = server.live_mem_total_mb
            pct = server.live_mem_pct
            cpu_pct = server.live_cpu_pct
            cont_count = server.live_container_count
          else
            allocated = server.allocated_memory_mb
            total = server.capacity_total_mb_or_nil
            pct = server.capacity_pct
            cpu_pct = nil
            cont_count = nil
          end
          pct_tone = pct.nil? ? "bg-dim" : (pct > 85 ? "bg-danger" : pct > 65 ? "bg-warn" : "bg-success")
          status_tone = { "connected" => :success, "unreachable" => :danger, "auth_failed" => :danger, "syncing" => :deploying }[server.status]
        %>
        <%= link_to admin_server_path(server), class: "block bg-paper border border-line-strong rounded-md shadow-brutal-sm hover:shadow-brutal transition-all p-4" do %>
          <div class="flex items-start justify-between gap-2 mb-3">
            <div class="min-w-0">
              <p class="text-sm font-bold text-ink truncate"><%= server.name %></p>
              <p class="text-[11px] text-dim mt-0.5 font-mono"><%= server.host %><% if server.region.present? %> · <%= server.region %><% end %></p>
            </div>
            <%= render Atoms::StatusPillComponent.new(label: t("dashboard.servers.#{server.status}"), tone: status_tone) %>
          </div>

          <div class="space-y-2">
            <div>
              <div class="flex items-center justify-between text-[10px] text-dim mb-1">
                <span class="uppercase tracking-widest font-semibold"><%= live ? t("sweep.memory_live") : t("sweep.capacity") %></span>
                <span>
                  <% if pct %><%= pct %>% (<%= allocated %>MB / <%= total %>MB)<% else %><%= t("sweep.allocated", mb: allocated) %><% end %>
                </span>
              </div>
              <div class="h-1.5 bg-bg border border-line rounded-full relative overflow-hidden">
                <div class="absolute inset-0 rounded-full <%= pct_tone %>" style="width: <%= pct ? [pct, 100].min : 0 %>%"></div>
              </div>
            </div>

            <% if cpu_pct %>
              <div>
                <div class="flex items-center justify-between text-[10px] text-dim mb-1">
                  <span class="uppercase tracking-widest font-semibold">CPU (live)</span>
                  <span><%= cpu_pct %>%</span>
                </div>
                <div class="h-1.5 bg-bg border border-line rounded-full relative overflow-hidden">
                  <% cpu_tone = cpu_pct > 80 ? "bg-danger" : cpu_pct > 50 ? "bg-warn" : "bg-success" %>
                  <div class="absolute inset-0 rounded-full <%= cpu_tone %>" style="width: <%= [cpu_pct, 100].min %>%"></div>
                </div>
              </div>
            <% end %>

            <div class="flex items-center justify-between text-[11px] text-dim">
              <span>
                <%= t("sweep.n_apps", count: server.app_records.size) %>
                <% if cont_count %><span class="text-dim"> · <%= cont_count %> containers</span><% end %>
              </span>
              <span class="font-mono">:<%= server.port %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-paper border border-line rounded-md shadow-brutal-sm">
      <h3 class="text-sm font-medium text-ink-soft"><%= t("dashboard.servers.no_servers") %></h3>
      <% if @can_manage %>
        <p class="mt-1 text-xs text-dim">Connect your first server — one command, no SSH keys.</p>
        <div class="mt-4">
          <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, data: { action: "click->slide-panel#open" }) do %><%= t("dashboard.servers.add_server") %><% end %>
        </div>
      <% else %>
        <p class="mt-1 text-xs text-dim">No platform servers available yet — check back soon.</p>
      <% end %>
    </div>
  <% end %>

  <% if @can_manage %>
    <%= render layout: "dashboard/shared/slide_panel", locals: { title: t("dashboard.servers.add_server"), subtitle: t("sweep.register_hint") } do %>
      <%= render "form", server: @server %>
    <% end %>
  <% end %>
</div>
