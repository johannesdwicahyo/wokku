<%
  inp = "w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent"
  lbl = "block font-mono text-[10px] font-medium text-dim mb-1.5 uppercase tracking-widest"
%>
<div class="max-w-lg">
  <div class="mb-4 font-mono">
    <div class="flex items-center gap-2 text-sm mb-4">
      <%= link_to t("dashboard.servers.title"), admin_servers_path, class: "text-dim hover:text-accent transition cursor-pointer" %>
      <span class="text-dim">/</span>
      <span class="text-ink-soft">New</span>
    </div>
    <h1 class="text-xl font-semibold tracking-tighter text-ink"># <%= t("dashboard.servers.add_server") %></h1>
    <p class="mt-0.5 text-sm text-dim">// register it, then connect with one command</p>
  </div>

  <div class="border-1.5 border-ink bg-paper p-6">
    <%= render "form", server: @server %>
  </div>
</div>
