<% content_for(:title, "Cloud credentials") %>

<%# Slide-panel scope so both the header button and the empty-state CTA
    can dispatch click->slide-panel#open (consistent with apps / databases
    / admin/servers "+ New X"). %>
<div data-controller="slide-panel">
<div class="flex items-center justify-between mb-5">
  <div>
    <h1 class="font-headline text-2xl font-extrabold tracking-tight">Cloud credentials</h1>
    <p class="mt-0.5 text-sm text-dim">API keys used to provision servers across cloud providers (Hetzner, DigitalOcean, Linode)</p>
  </div>
  <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, data: { action: "click->slide-panel#open" }) do %>+ Add provider<% end %>
</div>

<div class="bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-hidden">
  <% if @credentials.any? %>
    <div class="divide-y divide-line">
      <% @credentials.each do |cred| %>
        <div class="px-3.5 py-3 flex items-center justify-between gap-3 flex-wrap hover:bg-bg-deep transition-colors">
          <div class="min-w-0">
            <div class="flex items-center gap-3 flex-wrap">
              <span class="text-sm font-semibold text-ink capitalize"><%= cred.provider %></span>
              <% if cred.name.present? %>
                <%= render Atoms::TagComponent.new(tone: :dim) do %><%= cred.name %><% end %>
              <% end %>
            </div>
            <div class="text-[11px] text-dim mt-0.5">
              owned by <%= cred.team&.name || "—" %> · added <%= time_ago_in_words(cred.created_at) %> ago
            </div>
          </div>

          <%# Danger-zone drawer for delete — destructive action so it
              gets the same confirm pattern as backup restore. %>
          <div data-controller="motion--drawer" class="inline-block">
            <button data-action="motion--drawer#open"
                    type="button"
                    class="inline-flex items-center justify-center gap-2 font-semibold cursor-pointer rounded-md transition-colors bg-transparent text-warn border-1.5 border-transparent hover:bg-bg-deep px-3 py-1.5 text-xs">
              Remove
            </button>
            <template data-motion--drawer-target="content">
              <div class="p-6 space-y-4">
                <div class="text-[11px] font-bold uppercase tracking-[.06em] text-warn">Destructive — cloud credential</div>
                <h2 class="font-headline text-xl font-extrabold">Remove <%= cred.provider.capitalize %> credential?</h2>
                <p class="text-ink-soft text-sm leading-relaxed">
                  Servers already provisioned with this credential
                  <strong class="text-ink">keep running</strong> — access isn't lost. But you won't be able to provision any new servers under
                  <span class="text-ink font-semibold"><%= cred.provider %></span> until you
                  add the credential back.
                </p>
                <%= button_to "Yes, remove credential",
                      admin_cloud_credential_path(cred),
                      method: :delete,
                      class: "w-full border-1.5 border-ink rounded-md bg-danger text-bg font-semibold text-sm px-4 py-3 shadow-brutal hover:bg-warn hover:text-ink transition cursor-pointer",
                      data: {
                        controller: "motion--optimistic-button",
                        "motion--optimistic-button-pending-label-value": "removing…"
                      } %>
                <button data-action="motion--drawer#close"
                        type="button"
                        class="w-full border-1.5 border-ink rounded-md bg-paper text-ink font-semibold text-sm px-4 py-3 hover:bg-bg-deep transition cursor-pointer">
                  Cancel
                </button>
              </div>
            </template>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-4">
      <%# EmptyStateComponent's cta_href/cta_label API only knows how to
          link to a page, not open a slide-panel — no cta_action param
          exists on it (see app/components/organisms/empty_state_component.rb).
          Lean path: render it with no CTA, then a plain ButtonComponent
          with the slide-panel action right below, in the same empty-state
          area. %>
      <%= render Organisms::EmptyStateComponent.new(
            headline: t("dashboard.cloud_credentials.empty_headline"),
            body: t("dashboard.cloud_credentials.empty_body")
          ) %>
      <div class="flex justify-center mt-4">
        <%= render Atoms::ButtonComponent.new(variant: :primary, size: :md, data: { action: "click->slide-panel#open" }) do %>+ Add provider<% end %>
      </div>
    </div>
  <% end %>
</div>

<%= render layout: "dashboard/shared/slide_panel",
           locals: { title: t("dashboard.cloud_credentials.panel_title"), subtitle: t("dashboard.cloud_credentials.panel_subtitle") } do %>
  <%= render "form" %>
<% end %>
</div>
