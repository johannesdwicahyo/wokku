<div class="max-w-5xl">
  <div class="flex items-center justify-between mb-6">
    <h1 class="font-mono text-2xl font-semibold tracking-tighter text-ink">
      # <%= t("admin.users.index_title", default: "Users") %>
      <span class="text-dim text-base font-normal ml-2">(<%= @total %>)</span>
    </h1>
  </div>

  <%# Search %>
  <%= form_with url: admin_users_path, method: :get, class: "mb-6 flex gap-2" do |f| %>
    <%= f.text_field :q, value: @query,
          placeholder: t("admin.users.search_placeholder", default: "Search by email…"),
          class: "flex-1 bg-bg border-1.5 border-ink text-ink font-mono text-sm px-3 py-2 focus:outline-none focus:border-accent" %>
    <%= f.submit "Search", class: "px-4 py-2 bg-ink text-bg font-mono text-sm font-semibold border-1.5 border-ink cursor-pointer hover:bg-ink-soft" %>
    <% if @query.present? %>
      <%= link_to "Clear", admin_users_path, class: "px-3 py-2 font-mono text-sm text-dim border-1.5 border-ink hover:text-ink transition" %>
    <% end %>
  <% end %>

  <div class="border-1.5 border-ink bg-paper overflow-x-auto">
    <table class="w-full font-mono text-sm">
      <thead class="border-b border-rule-soft">
        <tr class="text-xs text-dim uppercase tracking-widest">
          <th class="text-left px-4 py-3"><%= t("admin.users.columns.email", default: "Email") %></th>
          <th class="text-left px-4 py-3"><%= t("admin.users.columns.role", default: "Role") %></th>
          <th class="text-left px-4 py-3"><%= t("admin.users.columns.created_at", default: "Joined") %></th>
          <th class="text-left px-4 py-3"><%= t("admin.users.columns.balance", default: "Balance") %></th>
          <th class="text-left px-4 py-3"><%= t("admin.users.columns.status", default: "Status") %></th>
          <th class="text-left px-4 py-3"><%= t("admin.users.columns.apps", default: "Apps") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-rule-soft">
        <% @users.each do |user| %>
          <tr class="hover:bg-bg-deep transition-colors">
            <td class="px-4 py-3 text-xs text-ink"><%= user.email %></td>
            <td class="px-4 py-3">
              <span class="text-xs px-2 py-0.5 border <%= user.admin? ? 'border-accent text-accent' : 'border-rule-soft text-dim' %>">
                <%= user.role %>
              </span>
            </td>
            <td class="px-4 py-3 text-dim text-xs"><%= user.created_at.strftime("%b %-d, %Y") %></td>
            <td class="px-4 py-3 text-xs text-ink"><%= user.balance_formatted %></td>
            <td class="px-4 py-3">
              <% if user.deleted? %>
                <span class="text-xs px-2 py-0.5 border border-danger text-danger"><%= t("admin.users.status.deleted", default: "Deleted") %></span>
              <% elsif user.deletion_pending? %>
                <span class="text-xs px-2 py-0.5 border border-warn text-warn"><%= t("admin.users.status.pending_deletion", default: "Deletion pending") %></span>
              <% else %>
                <span class="text-xs px-2 py-0.5 border border-success text-success"><%= t("admin.users.status.active", default: "Active") %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-dim text-xs">
              <%= user.teams.flat_map(&:app_records).count %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("admin.users.actions.show", default: "View"),
                          admin_user_path(user),
                          class: "text-xs text-accent hover:underline" %>
            </td>
          </tr>
        <% end %>
        <% if @users.empty? %>
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-dim text-sm">// no users found</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Pagination %>
  <% if @total_pages > 1 %>
    <div class="flex items-center justify-between mt-4 font-mono text-sm text-dim">
      <span>Page <%= @page %> of <%= @total_pages %></span>
      <div class="flex gap-2">
        <% if @page > 1 %>
          <%= link_to "← Prev", admin_users_path(q: @query, page: @page - 1),
                class: "px-3 py-1.5 border-1.5 border-ink hover:text-ink transition" %>
        <% end %>
        <% if @page < @total_pages %>
          <%= link_to "Next →", admin_users_path(q: @query, page: @page + 1),
                class: "px-3 py-1.5 border-1.5 border-ink hover:text-ink transition" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
