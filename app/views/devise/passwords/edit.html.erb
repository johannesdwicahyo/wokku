<div class="min-h-screen flex items-center justify-center px-5 bg-bg text-ink font-sans">
  <div class="max-w-sm w-full">
    <div class="text-center mb-8">
      <h1 class="font-headline text-2xl font-semibold tracking-tight text-ink"><%= t("auth.change_password") %></h1>
    </div>

    <div class="border border-line bg-paper rounded-md p-6">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-3" }) do |f| %>
        <%= f.hidden_field :reset_password_token %>

        <% if resource.errors.any? %>
          <div class="border border-danger bg-danger-soft rounded-md p-4">
            <ul class="list-disc list-inside text-sm text-danger space-y-1">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :password, t("auth.new_password"), class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
          <p class="mt-1 text-[11px] text-dim"><%= @minimum_password_length %> characters minimum</p>
        </div>

        <div>
          <%= f.label :password_confirmation, t("auth.confirm_password"), class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
        </div>

        <div>
          <%= f.submit t("auth.change_password"), class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full").classes %>
        </div>
      <% end %>
    </div>

    <p class="mt-6 text-center text-xs text-dim">
      <%= link_to t("auth.sign_in"), new_session_path(resource_name), class: "text-accent hover:text-accent font-medium transition" %>
    </p>
  </div>
</div>
