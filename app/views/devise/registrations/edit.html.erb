<div class="min-h-screen flex items-center justify-center px-5 py-12 bg-bg text-ink font-sans">
  <div class="max-w-sm w-full">
    <div class="text-center mb-8">
      <h1 class="font-headline text-2xl font-semibold tracking-tight text-ink">Edit account</h1>
    </div>

    <div class="border border-line bg-paper rounded-md p-6">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-3" }) do |f| %>
        <% if resource.errors.any? %>
          <div class="border border-danger bg-danger-soft rounded-md p-4">
            <ul class="list-disc list-inside text-sm text-danger space-y-1">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :email, class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
        </div>

        <div>
          <%= f.label :password, "New password", class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
          <p class="mt-1 text-[11px] text-dim">Leave blank if you don't want to change it</p>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
        </div>

        <div class="border-t border-line pt-4">
          <%= f.label :current_password, class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
          <p class="mt-1 text-[11px] text-dim">Required to confirm changes</p>
        </div>

        <div>
          <%= f.submit "Update", class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full").classes %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 border border-danger bg-danger-soft rounded-md p-6">
      <h3 class="text-sm font-bold text-danger mb-2">Delete account</h3>
      <p class="text-xs text-ink-soft mb-3">This action cannot be undone.</p>
      <%= button_to "Delete my account", registration_path(resource_name), method: :delete, data: { turbo_confirm: "Are you sure? This cannot be undone." }, class: Atoms::ButtonComponent.new(variant: :danger, size: :sm).classes %>
    </div>
  </div>
</div>
