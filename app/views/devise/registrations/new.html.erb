<div class="min-h-screen flex items-center justify-center px-5 bg-bg text-ink font-sans">
  <div class="w-full max-w-sm">
    <div class="mb-6 flex justify-center">
      <%= link_to root_path, class: "inline-flex items-center gap-1.5 text-xs text-dim hover:text-accent transition" do %>
        ← Back to <%= request.host %>
      <% end %>
    </div>
    <div class="text-center mb-8">
      <h1 class="font-headline text-2xl font-semibold tracking-tight text-ink"><%= t("auth.sign_up") %></h1>
      <p class="mt-1 text-xs text-dim">Start deploying in seconds</p>
    </div>

    <div class="border border-line bg-paper rounded-md p-6">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-3" }) do |f| %>
        <% if resource.errors.any? %>
          <div class="border border-danger bg-danger-soft rounded-md p-4">
            <ul class="list-disc list-inside text-sm text-danger space-y-1">
              <% resource.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :email, class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full px-3 py-2.5 border border-dark-line bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-3 py-2.5 border border-dark-line bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
          <p class="mt-1 text-[11px] text-dim"><%= @minimum_password_length %> characters minimum</p>
        </div>

        <div>
          <%= f.label :password_confirmation, t("auth.confirm_password"), class: "block text-xs font-semibold text-ink-soft mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-3 py-2.5 border border-dark-line bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
        </div>

        <div>
          <%= f.submit t("auth.sign_up"), class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full").classes %>
        </div>
      <% end %>

      <%= render "devise/shared/oauth_buttons" %>
    </div>

    <p class="mt-6 text-center text-xs text-dim">
      <%= t("auth.have_account") %>
      <%= link_to t("auth.sign_in"), new_session_path(resource_name), class: "text-accent hover:text-accent font-medium ml-1 transition" %>
    </p>
  </div>
</div>
