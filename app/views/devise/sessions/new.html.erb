<%= render Organisms::AuthShellComponent.new do %>
  <% providers = Molecules::OauthButtonComponent::ORDER & configured_oauth_providers %>
  <div>
    <h1 class="text-[38px] font-normal tracking-[-.04em] leading-[1.05] m-0"><%= t("signin.title") %></h1>
    <p class="text-ink-soft text-base mt-1.5 mb-0"><%= t("signin.sub") %></p>
  </div>

  <%= render "devise/shared/auth_flash" %>

  <%# Providers only when the operator configured their credentials (cloud sets
      them all; a fresh self-host sets none and gets the password form). %>
  <% if providers.any? %>
    <div class="grid grid-cols-2 gap-2">
      <% providers.each do |p| %>
        <%= render Molecules::OauthButtonComponent.new(provider: p, wide: p == :github) %>
      <% end %>
    </div>
    <p class="text-[13px] text-muted m-0"><%= t("signin.reassure") %></p>
  <% else %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { id: "signin-form", class: "flex flex-col gap-[22px]" }) do |f| %>
      <div class="flex flex-col gap-2">
        <%= f.label :email, t("signin.email_label"), class: "font-mono text-[11px] uppercase tracking-[.12em] text-muted" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "auth-input" %>
      </div>
      <div class="flex flex-col gap-2">
        <%= f.label :password, t("signin.password_label"), class: "font-mono text-[11px] uppercase tracking-[.12em] text-muted" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true, class: "auth-input" %>
      </div>
      <%= f.button t("signin.submit"), type: "submit",
            class: Atoms::ButtonComponent.new(variant: :primary, class: "w-full h-[50px] text-[12px]").classes %>
    <% end %>
  <% end %>

  <% if wokku_cloud? %>
    <p class="text-[15px] text-ink-soft m-0"><%= t("signin.new_account") %></p>
  <% end %>

  <% if respond_to?(:terms_path) && respond_to?(:privacy_path) %>
    <p class="text-[13px] text-muted m-0">
      <%= t("signin.legal_html",
            terms: link_to(t("signin.terms"), terms_path, class: "text-ink underline underline-offset-[3px] decoration-live/60 hover:decoration-live"),
            privacy: link_to(t("signin.privacy"), privacy_path, class: "text-ink underline underline-offset-[3px] decoration-live/60 hover:decoration-live")) %>
    </p>
  <% end %>
<% end %>
