<div class="min-h-screen flex items-center justify-center px-5 bg-bg text-ink" style="font-family: var(--font-sans-brutal);">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="font-mono text-2xl font-semibold tracking-tighter text-ink"># <%= t('signin.title') %></h1>
      <p class="font-mono text-xs text-dim mt-2"><%= t('signin.sub') %></p>
    </div>
    <div class="border-1.5 border-ink bg-paper p-6 space-y-3">
      <% if flash[:alert] %>
        <div class="border-1.5 border-danger bg-danger-soft p-2.5 font-mono text-xs text-danger"><%= flash[:alert] %></div>
      <% end %>

      <% if flash[:notice] %>
        <div class="border-1.5 border-ink bg-bg p-2.5 font-mono text-xs text-dim"><%= flash[:notice] %></div>
      <% end %>

      <%# === PROVIDER BUTTONS — rendered only for providers whose credentials
          the operator configured (cloud sets all four; a fresh self-host sets
          none and gets the email+password form below). GitHub is primary
          (filled bg-ink) and FIRST. === %>
      <% providers = configured_oauth_providers %>
      <% if providers.include?(:github) %>
        <%= button_to user_github_omniauth_authorize_path, method: :post, data: { turbo: false },
              onclick: "window.posthog && posthog.capture('signup_started', {provider: 'github'})",
              class: "w-full flex items-center justify-center gap-2 px-4 py-3 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer" do %>
          <%= t('signin.continue_with', provider: 'GitHub') %>
        <% end %>
      <% end %>

      <% if providers.include?(:google_oauth2) %>
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false },
              onclick: "window.posthog && posthog.capture('signup_started', {provider: 'google'})",
              class: "w-full flex items-center justify-center gap-2 px-4 py-3 border-1.5 border-ink bg-paper text-ink font-mono text-sm hover:bg-bg transition cursor-pointer" do %>
          <%= t('signin.continue_with', provider: 'Google') %>
        <% end %>
      <% end %>

      <% if providers.include?(:gitlab) %>
        <%= button_to user_gitlab_omniauth_authorize_path, method: :post, data: { turbo: false },
              onclick: "window.posthog && posthog.capture('signup_started', {provider: 'gitlab'})",
              class: "w-full flex items-center justify-center gap-2 px-4 py-3 border-1.5 border-ink bg-paper text-ink font-mono text-sm hover:bg-bg transition cursor-pointer" do %>
          <%= t('signin.continue_with', provider: 'GitLab') %>
        <% end %>
      <% end %>

      <% if providers.include?(:bitbucket) %>
        <%= button_to user_bitbucket_omniauth_authorize_path, method: :post, data: { turbo: false },
              onclick: "window.posthog && posthog.capture('signup_started', {provider: 'bitbucket'})",
              class: "w-full flex items-center justify-center gap-2 px-4 py-3 border-1.5 border-ink bg-paper text-ink font-mono text-sm hover:bg-bg transition cursor-pointer" do %>
          <%= t('signin.continue_with', provider: 'Bitbucket') %>
        <% end %>
      <% end %>

      <% if providers.empty? %>
        <%# Self-host default: email + password (the installer seeds the
            admin's password; OAuth appears once its env creds are set).
            Email-code login is planned — see the sign-in-code backlog. %>
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="space-y-3">
            <div>
              <label class="font-mono text-[11px] text-dim block mb-1"><%= t('signin.email_label') %></label>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                    class: "w-full px-3 py-2.5 border-1.5 border-ink bg-bg font-mono text-sm focus:outline-none" %>
            </div>
            <div>
              <label class="font-mono text-[11px] text-dim block mb-1"><%= t('signin.password_label') %></label>
              <%= f.password_field :password, autocomplete: "current-password",
                    class: "w-full px-3 py-2.5 border-1.5 border-ink bg-bg font-mono text-sm focus:outline-none" %>
            </div>
            <%= f.submit t('signin.submit'),
                  class: "w-full px-4 py-3 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer" %>
          </div>
        <% end %>
      <% end %>

      <% if providers.any? %>
        <p class="font-mono text-[11px] text-dim text-center pt-1"><%= t('signin.reassure') %></p>
      <% end %>

      <p class="font-mono text-[10px] text-dim text-center pt-2">
        By signing in, you agree to our
        <%# Legal pages are cloud-host routes; a standalone engine skips the links. %>
        <% if respond_to?(:terms_path) && respond_to?(:privacy_path) %><%= link_to "Terms", terms_path, class: "underline hover:text-accent transition" %> and
        <%= link_to "Privacy Policy", privacy_path, class: "underline hover:text-accent transition" %>.<% end %>
      </p>
    </div>
    <p class="text-center mt-5 font-mono text-[11px] text-dim">
      <%= link_to "← wokku.cloud", root_path, class: "hover:text-accent" %>
    </p>
  </div>
</div>
