<div class="min-h-screen flex items-center justify-center px-5 bg-bg text-ink font-sans">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="font-headline text-2xl font-semibold tracking-tight text-ink"><%= t('signin.title') %></h1>
      <p class="text-xs text-dim mt-2"><%= t(wokku_cloud? ? 'signin.sub' : 'signin.sub_self_host') %></p>
    </div>
    <div class="border border-line bg-paper rounded-md p-6 space-y-3">
      <% if flash[:alert] %>
        <div class="border border-danger bg-danger-soft rounded-md p-2.5 text-xs text-danger"><%= flash[:alert] %></div>
      <% end %>

      <% if flash[:notice] %>
        <div class="border border-line bg-bg rounded-md p-2.5 text-xs text-dim"><%= flash[:notice] %></div>
      <% end %>

      <%# === PROVIDER BUTTONS — rendered only for providers whose credentials
          the operator configured (cloud sets all four; a fresh self-host sets
          none and gets the email+password form below). GitHub is primary
          (filled bg-ink) and FIRST. === %>
      <% providers = configured_oauth_providers %>
      <% if providers.include?(:github) %>
        <%= button_to user_github_omniauth_authorize_path, method: :post, data: { turbo: false, controller: "track", action: "click->track#capture",
                      track_event_value: "signup_started", track_props_value: { provider: "github" }.to_json },
              class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full").classes do %>
          <%= t('signin.continue_with', provider: 'GitHub') %>
        <% end %>
      <% end %>

      <% if providers.include?(:google_oauth2) %>
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false, controller: "track", action: "click->track#capture",
                      track_event_value: "signup_started", track_props_value: { provider: "google" }.to_json },
              class: Atoms::ButtonComponent.new(variant: :outline, size: :md, class: "w-full").classes do %>
          <%= t('signin.continue_with', provider: 'Google') %>
        <% end %>
      <% end %>

      <% if providers.include?(:gitlab) %>
        <%= button_to user_gitlab_omniauth_authorize_path, method: :post, data: { turbo: false, controller: "track", action: "click->track#capture",
                      track_event_value: "signup_started", track_props_value: { provider: "gitlab" }.to_json },
              class: Atoms::ButtonComponent.new(variant: :outline, size: :md, class: "w-full").classes do %>
          <%= t('signin.continue_with', provider: 'GitLab') %>
        <% end %>
      <% end %>

      <% if providers.include?(:bitbucket) %>
        <%= button_to user_bitbucket_omniauth_authorize_path, method: :post, data: { turbo: false, controller: "track", action: "click->track#capture",
                      track_event_value: "signup_started", track_props_value: { provider: "bitbucket" }.to_json },
              class: Atoms::ButtonComponent.new(variant: :outline, size: :md, class: "w-full").classes do %>
          <%= t('signin.continue_with', provider: 'Bitbucket') %>
        <% end %>
      <% end %>

      <% if providers.include?(:apple) %>
        <%= button_to user_apple_omniauth_authorize_path, method: :post, data: { turbo: false, controller: "track", action: "click->track#capture",
                      track_event_value: "signup_started", track_props_value: { provider: "apple" }.to_json },
              class: Atoms::ButtonComponent.new(variant: :outline, size: :md, class: "w-full").classes do %>
          <%= t('signin.continue_with', provider: 'Apple') %>
        <% end %>
      <% end %>

      <% if providers.empty? %>
        <%# Self-host default: email + password (the installer seeds the
            admin's password; OAuth appears once its env creds are set).
            Email-code login is planned — see the sign-in-code backlog. %>
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t('signin.email_label') %></label>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                    class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
            </div>
            <div>
              <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t('signin.password_label') %></label>
              <%= f.password_field :password, autocomplete: "current-password",
                    class: "w-full px-3 py-2.5 border border-line-strong bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
            </div>
            <%= f.submit t('signin.submit'),
                  class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full").classes %>
          </div>
        <% end %>
      <% end %>

      <% if providers.any? %>
        <p class="text-[11px] text-dim text-center pt-1"><%= t('signin.reassure') %></p>
      <% end %>

      <%# Legal pages are cloud-host routes; without them the sentence went too
          (it used to end at "you agree to our"). %>
      <% if respond_to?(:terms_path) && respond_to?(:privacy_path) %>
        <p class="text-[10px] text-dim text-center pt-2">
          By signing in, you agree to our
          <%= link_to "Terms", terms_path, class: "underline hover:text-accent transition" %> and
          <%= link_to "Privacy Policy", privacy_path, class: "underline hover:text-accent transition" %>.
        </p>
      <% end %>
    </div>
    <p class="text-center mt-5 text-[11px] text-dim">
      <%= link_to "← #{request.host}", root_path, class: "hover:text-accent" %>
    </p>
  </div>
</div>
