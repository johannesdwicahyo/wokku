<div class="min-h-screen flex items-center justify-center px-5 bg-bg text-ink font-sans">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="font-headline text-2xl font-semibold tracking-tight text-ink"><%= t('setup.title') %></h1>
      <p class="text-xs text-dim mt-2"><%= t('setup.sub') %></p>
    </div>
    <div class="border border-line bg-paper rounded-md p-6">
      <% if @user.errors.any? %>
        <div class="border border-danger bg-danger-soft rounded-md p-2.5 text-xs text-danger mb-3">
          <%= @user.errors.full_messages.first %>
        </div>
      <% end %>
      <%= form_with model: @user, url: setup_path, method: :post do |f| %>
        <%= hidden_field_tag :token, params[:token] if @setup_token %>
        <div class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t('signin.email_label') %></label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email",
                  class: "w-full px-3 py-2.5 border border-dark-line bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t('signin.password_label') %></label>
            <%= f.password_field :password, autocomplete: "new-password",
                  class: "w-full px-3 py-2.5 border border-dark-line bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
          </div>
          <div>
            <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t('setup.password_confirmation_label') %></label>
            <%= f.password_field :password_confirmation, autocomplete: "new-password",
                  class: "w-full px-3 py-2.5 border border-dark-line bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
          </div>
          <%# install.sh already registered + connected this box — the
              checkbox only matters for bare `docker compose up` installs. %>
          <% unless Server.exists? %>
          <label class="flex items-start gap-2 pt-1 cursor-pointer">
            <%= check_box_tag :connect_this_server, "1", true, class: "mt-0.5 accent-current" %>
            <span class="text-[11px] text-dim">
              <%= t('setup.connect_label') %><br>
              <span class="text-[10px]"><%= t('setup.connect_hint') %></span>
            </span>
          </label>
          <% end %>
          <%= f.submit t('setup.submit'),
                class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full").classes %>
        </div>
      <% end %>
    </div>
  </div>
</div>
