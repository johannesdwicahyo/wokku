<% content_for(:title, "Blog - Wokku") %>

<div class="min-h-screen bg-surface text-on-surface">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-12">
      <a href="/" class="text-sm text-primary hover:underline">← Back to Wokku</a>
      <h1 class="font-headline text-4xl font-bold text-on-surface mt-4 mb-3">Blog</h1>
      <p class="text-sm text-outline">Notes from building Wokku.</p>
    </div>

    <% if @posts.any? %>
      <ul class="space-y-10">
        <% @posts.each do |post| %>
          <li>
            <a href="<%= blog_post_path(post) %>" class="block group">
              <p class="text-xs text-outline font-mono mb-2"><%= post.date.strftime("%B %-d, %Y") %><% if post.author.present? %> · <%= post.author %><% end %></p>
              <h2 class="font-headline text-2xl font-bold text-on-surface group-hover:text-primary transition mb-2"><%= post.title %></h2>
              <% if post.description.present? %>
                <p class="text-sm text-on-surface-variant leading-relaxed"><%= post.description %></p>
              <% end %>
              <% if post.tags.any? %>
                <div class="mt-3 flex flex-wrap gap-2">
                  <% post.tags.each do |tag| %>
                    <span class="text-[10px] text-outline font-mono bg-surface-container-low border border-outline-variant/15 rounded px-2 py-0.5"><%= tag %></span>
                  <% end %>
                </div>
              <% end %>
            </a>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-outline">No posts yet.</p>
    <% end %>
  </div>
</div>
