<% content_for(:title, "Feedback — Wokku") %>

<div class="min-h-screen bg-surface text-on-surface">
  <div class="max-w-xl mx-auto px-6 py-16">
    <a href="/" class="text-sm text-primary hover:underline">← Back to Wokku</a>
    <h1 class="font-headline text-3xl font-bold text-on-surface mt-4 mb-2">Feedback</h1>
    <p class="text-sm text-outline mb-8">Bug? Missing feature? Just curious? Tell us — we read every message and reply where it makes sense.</p>

    <%= form_with model: @feedback, url: feedback_path, local: true, class: "space-y-4" do |f| %>
      <% if @feedback.errors.any? %>
        <div class="rounded-md bg-error-container/20 border border-error/20 p-3">
          <ul class="text-xs text-error space-y-1">
            <% @feedback.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-xs font-medium text-on-surface-variant mb-1.5 uppercase tracking-wider">Message</label>
        <%= f.text_area :message, rows: 6, required: true, autofocus: true, placeholder: "What's on your mind?",
              class: "w-full rounded-md bg-surface-container-low border border-outline-variant/15 px-4 py-2.5 text-sm text-on-surface placeholder-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" %>
      </div>

      <% unless user_signed_in? %>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-on-surface-variant mb-1.5 uppercase tracking-wider">Name <span class="text-outline normal-case font-normal">(optional)</span></label>
            <%= f.text_field :name, class: "w-full rounded-md bg-surface-container-low border border-outline-variant/15 px-4 py-2.5 text-sm text-on-surface placeholder-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" %>
          </div>
          <div>
            <label class="block text-xs font-medium text-on-surface-variant mb-1.5 uppercase tracking-wider">Email <span class="text-outline normal-case font-normal">(optional)</span></label>
            <%= f.email_field :email, placeholder: "you@example.com",
                  class: "w-full rounded-md bg-surface-container-low border border-outline-variant/15 px-4 py-2.5 text-sm text-on-surface placeholder-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition" %>
          </div>
        </div>
        <p class="text-[11px] text-outline">Email helps us follow up. Skip if you'd rather stay anonymous.</p>
      <% end %>

      <%= f.hidden_field :page, value: request.referer %>

      <button type="submit" class="px-5 py-2.5 bg-primary text-on-primary text-sm font-bold rounded-md hover:opacity-90 transition cursor-pointer">
        Send feedback
      </button>
    <% end %>
  </div>
</div>
