<!DOCTYPE html>
<html lang="<%= @docs_locale || 'en' %>"
      style="color-scheme: dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= docs_page_title %></title>
  <meta name="description" content="<%= @doc_summary || 'Wokku documentation — deploy and manage applications on your own servers.' %>">
  <%= csrf_meta_tags %>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag :app %>
  <%= stylesheet_link_tag "docs", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= optional_partial "shared/open_graph" %>
  <%= optional_partial "shared/analytics" %>
</head>
<body class="bg-bg text-ink font-sans antialiased">

  <%= render Organisms::DocsTopBarComponent.new(active: @path.to_s.start_with?("cli/") ? :cli : :guides, locale: @docs_locale || I18n.locale) %>

  <div class="docs-grid" data-controller="dropdown">
    <%# Phones: the sidebar is hidden below lg until opened. %>
    <button type="button" class="lg:hidden fixed bottom-4 right-4 z-40 bg-bg border border-line-strong text-ink w-12 h-12 flex items-center justify-center text-lg"
            data-action="click->dropdown#toggle"
            aria-label="<%= t("docs.top.toggle_sidebar") %>">≡</button>
    <div class="hidden lg:block docs-grid__side" data-dropdown-target="menu">
      <%= render Organisms::DocsSidebarComponent.new(sidebar: @sidebar, active_path: @path) %>
    </div>

    <main class="docs-main">
      <%= yield %>
    </main>

    <% if @toc.present? %>
      <%= render Organisms::DocsTocComponent.new(items: @toc) %>
    <% end %>
  </div>

    <%= render "shared/addon_scripts" %>
  </body>
</html>
