<!DOCTYPE html>
<html lang="<%= I18n.locale %>"
      style="color-scheme: dark">
  <head>
    <title>Admin · Wokku</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= optional_partial "shared/analytics" %>
  </head>

  <body class="bg-bg text-ink font-sans antialiased"
        data-controller="confirm-dialog nav-loading"
        data-action="turbo:visit@document->nav-loading#start turbo:load@document->nav-loading#stop turbo:fetch-request-error@document->nav-loading#stop">
    <%
      # Overview + jobs UI are cloud-host admin routes; standalone admin
      # starts at servers.
      admin_nav = [
        (if respond_to?(:admin_root_path)
          { label: t("console.admin.overview"), key: :admin, href: admin_root_path, active: request.path == "/admin" }
        end),
        { label: t("console.admin.servers"),           key: :servers,           href: admin_servers_path,           active: request.path.start_with?("/admin/servers") },
        { label: t("console.admin.cloud_credentials"), key: :cloud_credentials, href: admin_cloud_credentials_path, active: request.path.start_with?("/admin/cloud_credentials") },
        { label: t("console.admin.users"),             key: :users,             href: admin_users_path,             active: request.path.start_with?("/admin/users") },
        { label: t("console.admin.settings"),          key: :settings,          href: admin_settings_path,          active: request.path.start_with?("/admin/settings") },
        (if respond_to?(:admin_root_path)
          { label: t("console.admin.jobs"), key: :jobs, href: "/admin/jobs", active: request.path.start_with?("/admin/jobs") }
        end)
      ].compact

      # Back-to-dashboard footer link. Mirrors the "admin console →" entry
      # in dashboard sidebar; gives admins a clear exit from the admin
      # layout's context. Rendered via the account: slot so it sits at
      # the bottom of the sidebar with its own divider.
      admin_account = [
        { label: t("console.admin.back"), key: :back_to_dashboard, href: dashboard_apps_path, active: false }
      ]
    %>

    <div class="flex min-h-screen overflow-x-clip">
      <%= render Organisms::RailComponent.new(
            workspace_items: admin_nav,
            account_items: admin_account,
            user_email: current_user&.email,
            user_role: current_user&.role,
            sign_out_path: destroy_user_session_path,
            locale: I18n.locale,
            locale_toggle_path: dashboard_locale_path(locale: I18n.locale == :en ? :id : :en)
          ) %>

      <div class="flex-1 flex flex-col min-w-0 lg:pl-[248px]">
        <%= render Organisms::TopBarComponent.new(crumbs: [ t("console.admin.crumb") ], page: content_for(:title).presence || "Wokku") %>

        <main class="flex-1 bg-bg">
          <div class="px-6 py-5">
            <%= yield %>
          </div>
        </main>
      </div>
      <%
        admin_palette_nav = (admin_nav + admin_account).map { |i| { label: i[:label], href: i[:href] } }
        admin_palette_nav << { label: t("console.rail.language"), href: dashboard_locale_path(locale: I18n.locale == :en ? :id : :en), method: "post" }
        admin_palette_nav << { label: t("console.rail.sign_out"), href: destroy_user_session_path, method: "delete" }
      %>
      <%= render Organisms::CommandPaletteComponent.new(nav: admin_palette_nav) %>
    </div>
    <%= render Molecules::FlashToastComponent.new(flash: flash) %>
  </body>
</html>
