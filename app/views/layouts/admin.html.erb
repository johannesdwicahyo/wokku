<!DOCTYPE html>
<html lang="<%= I18n.locale %>"
      style="color-scheme: dark">
  <head>
    <title>Admin · Wokku</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= optional_partial "shared/analytics" %>
  </head>

  <body class="bg-bg text-ink font-sans antialiased"
        data-controller="confirm-dialog mobile-nav nav-loading"
        data-action="turbo:visit@document->nav-loading#start turbo:load@document->nav-loading#stop turbo:fetch-request-error@document->nav-loading#stop">
    <%
      # Overview + jobs UI are cloud-host admin routes; standalone admin
      # starts at servers.
      admin_nav = [
        (if respond_to?(:admin_root_path)
          { label: "Overview", key: :admin, href: admin_root_path, active: request.path == "/admin" }
        end),
        { label: "Servers",           key: :servers,           href: admin_servers_path,           active: request.path.start_with?("/admin/servers") },
        { label: "Cloud credentials", key: :cloud_credentials, href: admin_cloud_credentials_path, active: request.path.start_with?("/admin/cloud_credentials") },
        { label: "Users",             key: :users,             href: admin_users_path,             active: request.path.start_with?("/admin/users") },
        { label: "Settings",          key: :settings,          href: admin_settings_path,          active: request.path.start_with?("/admin/settings") },
        (if respond_to?(:admin_root_path)
          { label: "Jobs", key: :jobs, href: "/admin/jobs", active: request.path.start_with?("/admin/jobs") }
        end)
      ].compact

      # Back-to-dashboard footer link. Mirrors the "admin console →" entry
      # in dashboard sidebar; gives admins a clear exit from the admin
      # layout's context. Rendered via the account: slot so it sits at
      # the bottom of the sidebar with its own divider.
      admin_account = [
        { label: "← Back to dashboard", key: :back_to_dashboard, href: dashboard_apps_path, active: false }
      ]
    %>

    <div class="flex min-h-screen overflow-x-clip">
      <%= render Organisms::ConsoleSidebarComponent.new(
            groups: [
              { label: "admin", items: admin_nav },
              { label: nil, items: admin_account }
            ]
          ) %>

      <%# Off-canvas backdrop (mobile only). %>
      <div class="lg:hidden fixed inset-0 bg-black/70 z-20 hidden"
           data-mobile-nav-target="overlay"
           data-action="click->mobile-nav#close"></div>

      <div class="flex-1 flex flex-col min-w-0 lg:pl-[232px]">
        <%= render Organisms::ConsoleTopbarComponent.new %>

        <main class="flex-1 bg-bg">
          <div class="px-6 py-5">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
    <%= render Molecules::FlashToastComponent.new(flash: flash) %>
  </body>
</html>
