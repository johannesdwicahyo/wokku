<%#
  Brutalist console shell (P2 of redesign-c-full, 2026-05-17).
  Replaces the Material You dashboard chrome. The previous layout is
  preserved at dashboard.OLD_DESIGN.html.erb until P7 cleanup.

  Functional bits carried over verbatim from the old layout so nothing
  regresses: csrf/csp, Turbo morph refresh meta, xterm.js CSS (terminal
  pages use this layout), the analytics partial, the suspended /
  account-deletion / low-balance banners, the toast container, and the
  confirm-dialog Stimulus controllers.

  NOTE: until P3-P6 repaint the remaining dashboard pages, those pages
  still render their Material markup inside this brutalist shell. They
  stay functional; only their palette looks transitional.
%>
<%
  path = request.path

  workspace_items = [
    { label: t("console.sidebar.items.apps"),      key: :apps,      href: dashboard_apps_path,       count: current_team&.app_records&.size, active: path.start_with?("/dashboard/apps") },
    { label: t("console.sidebar.items.databases"), key: :databases, href: dashboard_addons_path,     active: Wokku.config.addon_path_prefixes.any? { |prefix| path.start_with?(prefix) } },
    { label: t("console.sidebar.items.templates"), key: :templates, href: dashboard_templates_path,  active: path.start_with?("/dashboard/templates") },
    { label: t("console.sidebar.items.activity"),  key: :activity,  href: dashboard_activities_path, active: path.start_with?("/dashboard/activities") },
    # Servers is admin-scoped in the engine; members have nothing to see there.
    (if current_user&.admin?
      { label: t("console.sidebar.items.servers"), key: :servers, href: admin_servers_path, count: Server.count, active: path.start_with?("/admin") }
    end)
  ].compact

  account_items = [
    { label: t("console.sidebar.items.settings"), key: :settings, href: dashboard_profile_path,
      active: path.start_with?("/dashboard/profile", "/dashboard/two_factor", "/dashboard/notifications", "/dashboard/account_deletion") },
    { label: t("console.sidebar.footer.docs"), key: :docs, href: "/docs", external: true }
  ]
  # Support is wokku.cloud's inbox; a self-host install has no such desk.
  account_items << { label: t("console.sidebar.footer.support"), key: :support, href: "mailto:support@wokku.cloud", external: false } if wokku_cloud?

  # Host-app extension point (group: :workspace | :account, unknown -> workspace);
  # a failing callable must never break the page.
  begin
    Array.wrap(Wokku.config.sidebar_extra_items.call(self)).each do |i|
      next unless i.is_a?(Hash)
      i = i.symbolize_keys
      next if i[:label].blank? || i[:href].blank?
      i[:key] ||= i[:label].to_s.parameterize.underscore.to_sym
      if i[:group].to_s == "account"
        account_items.insert(account_items.index { |a| a[:key] == :settings }, i)
      else
        workspace_items << i
      end
    end
  rescue StandardError => e
    Rails.logger.warn("sidebar_extra_items failed: #{e.class}: #{e.message}")
    Sentry.capture_exception(e, level: :warning) if defined?(Sentry)
  end

  palette_groups = [ { label: nil, items: workspace_items + account_items } ]
%>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>"
      style="color-scheme: dark">
  <head>
    <title><%= content_for(:title) || "Wokku" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Wokku">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Turbo morph refresh — diffs the DOM on Turbo Stream refreshes
        (e.g. addon status from CreateAddonJob) instead of repainting. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= yield :head %>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.min.css">
    <%= javascript_importmap_tags %>
    <%= optional_partial "shared/analytics" %>
  </head>

  <body class="bg-bg text-ink font-sans antialiased"
        data-controller="confirm-dialog nav-loading"
        data-action="turbo:visit@document->nav-loading#start turbo:load@document->nav-loading#stop turbo:fetch-request-error@document->nav-loading#stop">
    <% if user_signed_in? && current_user.billing_status == "suspended" %>
      <div class="border-b border-line bg-danger-soft px-4 py-2.5">
        <div class="flex items-center justify-center gap-2 text-xs text-ink">
          <span>// apps suspended — an invoice is unpaid.</span>
          <% if wokku_cloud? %>
            <%= link_to "pay_invoice()", dashboard_billing_path, class: "font-bold underline" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= render "shared/account_deletion_banner" %>
    <%= optional_partial "shared/low_balance_banner" %>
    <%= render "shared/host_down_banner" %>
    <%= render "shared/update_banner" %>
    <%= render "shared/recovery_codes_banner" %>

    <%# Public-beta strip — single source of truth (the topbar no longer
        carries its own). Cloud-only: it announces wokku.cloud's beta
        status, which is meaningless on a self-host install. %>
    <% if wokku_cloud? %>
      <div class="border-b border-line bg-warn-soft px-4 py-2">
        <div class="flex items-center justify-center gap-2 text-[11px] text-ink">
          <%= render Atoms::TagComponent.new(tone: :warn) do %>● public_beta<% end %>
          <span class="hidden sm:inline"><%= t("console.topbar.beta") %></span>
          <%= link_to t("console.topbar.beta_read"), "/docs/beta", class: "underline" %>
        </div>
      </div>
    <% end %>

    <%# overflow-x-clip (not hidden) stops the off-canvas slide-panel /
        sidebar — translated off-screen — from creating horizontal
        scroll on mobile, without breaking the sticky topbar the way
        an overflow scroll-container would. %>
    <div class="flex min-h-screen overflow-x-clip">
      <%= render Organisms::RailComponent.new(
            workspace_items: workspace_items,
            account_items: account_items,
            workspaces: current_user.teams.includes(:plan).order(:created_at),
            current_workspace: current_team,
            workspaces_index_path: dashboard_workspaces_path,
            workspace_new_path: new_dashboard_workspace_path,
            user_email: current_user.email,
            user_role: current_user.role,
            sign_out_path: destroy_user_session_path,
            locale: I18n.locale,
            locale_toggle_path: dashboard_locale_path(locale: I18n.locale == :en ? :id : :en),
            version_line: "wokku #{ENV["WOKKU_VERSION"].presence || "v#{Wokku::VERSION}"}" # image release (self-host) or gem version
          ) %>

      <div class="flex-1 flex flex-col min-w-0 lg:pl-[248px]">
        <%= render Organisms::TopBarComponent.new(crumbs: [ current_team&.name ].compact, page: content_for(:title).presence || "Wokku") do |bar| %>
          <% if content_for?(:top_actions) %>
            <% bar.with_action { content_for(:top_actions) } %>
          <% else %>
            <% bar.with_action { render Atoms::ButtonComponent.new(variant: :secondary, href: dashboard_templates_path) { t("console.top.from_template") } } %>
            <% bar.with_action { render Atoms::ButtonComponent.new(variant: :primary, href: new_dashboard_app_path) { t("console.top.new_app") } } %>
          <% end %>
        <% end %>

        <main class="flex-1 bg-bg">
          <div class="px-6 py-5">
            <%= yield %>
          </div>
        </main>
      </div>

      <%= render "dashboard/shared/onboarding_tour" %>
      <%= render "dashboard/shared/command_menu", sidebar_groups: palette_groups %>

      <%# Toast container — Turbo Stream broadcast target only.
          HTTP flash display is handled by FlashToastComponent below.
          Keep this div empty so background-job broadcasts still work. %>
      <div id="toasts" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>
    </div>
    <%= render Molecules::FlashToastComponent.new(flash: flash) %>
    <%= render "shared/addon_scripts" %>
  </body>
</html>
