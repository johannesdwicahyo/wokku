<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      /* schdl monochrome mailer base — inlined for email-client compat
         (Outlook, Gmail etc. strip <style> in some cases; templates also
         inline critical styles per-element). Email clients don't support
         CSS custom properties, so schdl hex values are hardcoded here
         rather than referencing tokens. */
      body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; background: #F6F6F5; color: #171717; margin: 0; padding: 0; }
      a { color: #171717; text-decoration: underline; }
      .wk-container { max-width: 560px; margin: 40px auto; background: #fff; border: 1.5px solid #171717; }
      .wk-header { padding: 24px 32px; border-bottom: 1.5px solid #171717; }
      .wk-header h1 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.15em; color: #888; margin: 0 0 8px; font-weight: bold; }
      .wk-header h2 { font-size: 28px; font-weight: 900; margin: 0; letter-spacing: -0.03em; line-height: 1.15; }
      .wk-body { padding: 32px; font-size: 14px; line-height: 1.55; color: #171717; }
      .wk-body p { margin: 0 0 14px; }
      .wk-label { color: #888; font-size: 10px; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 4px; }
      .wk-value { font-size: 14px; font-weight: bold; margin-bottom: 18px; }
      .wk-divider { border: none; border-top: 1.5px solid #171717; margin: 24px 0; }
      .wk-cta { display: inline-block; background: #171717; color: #fff !important; padding: 14px 28px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.12em; text-decoration: none; font-weight: bold; box-shadow: 3px 3px 0 #171717; }
      .wk-footer { padding: 20px 32px; border-top: 1.5px solid #171717; font-size: 11px; color: #888; }
      .wk-list { list-style: none; padding: 0; margin: 8px 0 24px; }
      .wk-list li { padding: 8px 0; border-bottom: 1px dashed #E6E6E4; font-size: 13px; }
      .wk-list li:before { content: "→ "; color: #171717; font-weight: bold; }
      .wk-list li:last-child { border-bottom: none; }
      .wk-alert { background: #FFF6E8; border-left: 4px solid #F2C94C; padding: 12px 16px; margin: 16px 0; font-size: 13px; }
      .wk-alert-danger { background: #FFEEED; border-left-color: #E5484D; }
    </style>
  </head>

  <body>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f5;">
      <tr><td align="center" style="padding:24px 16px 0;">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;"><tr><td align="left">
          <%= image_tag "#{root_url.chomp('/')}/wokku-tile.png", alt: "Wokku", width: 32, height: 32, style: "display:block;border:0;border-radius:7px;" %>
        </td></tr></table>
      </td></tr>
      <tr><td><%= yield %></td></tr>
    </table>
  </body>
</html>
