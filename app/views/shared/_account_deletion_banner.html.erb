<% if user_signed_in? && current_user.deletion_pending? %>
  <%
    locale_id = current_user.locale.to_s == "id"
    deletion_date = current_user.deletion_scheduled_at.in_time_zone("Asia/Jakarta").strftime("%-d %b %Y")
    label = locale_id ? "Akun kamu akan dihapus pada" : "Your account will be deleted on"
    cancel_label = locale_id ? "Batalkan penghapusan" : "Cancel deletion"
  %>
  <div class="bg-danger/10 border-b border-danger/30 text-bad-text px-4 py-2.5">
    <div class="flex items-center justify-center gap-3 text-sm flex-wrap">
      <span class="inline-block size-4"><%= render "shared/icons/warning" %></span>
      <span><%= label %> <strong><%= deletion_date %></strong>.</span>
      <%= button_to cancel_label,
                    dashboard_account_deletion_path,
                    method: :delete,
                    class: "font-bold underline ml-1 cursor-pointer",
                    data: { turbo_confirm: locale_id ? "Batalkan penghapusan akun?" : "Cancel account deletion?" } %>
    </div>
  </div>
<% end %>
