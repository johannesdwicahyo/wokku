<%# Open Graph + Twitter Card meta. Read by WhatsApp, Telegram, Slack,
    Discord, X / Twitter, LinkedIn — every link-preview surface. Without
    these, sharers fall back to the favicon (a small dot) and the page
    title only. Render this from every public-facing layout (landing,
    docs); skip on dashboard pages where shareability isn't useful. %>
<%
  page_title = content_for?(:title) ? "#{content_for(:title)} · Wokku" : "Wokku — PaaS open-source untuk developer Indonesia"
  page_desc  = content_for?(:og_description) ? content_for(:og_description) :
                "Deploy aplikasi pertamamu dalam 5 menit. Bayar pakai QRIS, server di Jakarta, harga rupiah. Open-source, dibangun di atas Dokku."
  page_url   = request.original_url
  page_image = content_for?(:og_image) ? content_for(:og_image) : "#{request.base_url}/icon.png"
%>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Wokku">
<meta property="og:title" content="<%= page_title %>">
<meta property="og:description" content="<%= page_desc %>">
<meta property="og:url" content="<%= page_url %>">
<meta property="og:image" content="<%= page_image %>">
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
<meta property="og:locale" content="id_ID">
<meta property="og:locale:alternate" content="en_US">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= page_title %>">
<meta name="twitter:description" content="<%= page_desc %>">
<meta name="twitter:image" content="<%= page_image %>">
