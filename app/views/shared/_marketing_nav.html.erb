<%# Shared marketing nav + beta banner. Used by both landing.html.erb
    (homepage, pricing, blog, etc.) and docs.html.erb so all top-level
    public pages have the same chrome. %>
<div class="bg-gradient-to-r from-tertiary/15 via-primary/15 to-tertiary/15 border-b border-tertiary/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
    <div class="flex items-center justify-center gap-2 text-xs">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-tertiary/20 text-tertiary rounded font-bold uppercase tracking-wider text-[10px]">
        <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
        Public Beta
      </span>
      <span class="text-on-surface-variant">
        Public Beta — actively shipping. Found a rough edge?
        <%= link_to "Tell us", feedback_path, class: "text-primary hover:underline font-medium" %>
        — we fix fast.
      </span>
    </div>
  </div>
</div>

<nav class="sticky top-0 z-50 border-b border-[#28283d]/30 bg-[#111125]/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-14 items-center">
      <div class="flex items-center space-x-8">
        <%= link_to root_path, class: "text-base font-semibold text-white tracking-tight", style: "font-family: 'Space Grotesk', sans-serif;" do %>
          Wokku
        <% end %>
        <div class="hidden sm:flex items-center space-x-6">
          <%= link_to "Templates", dashboard_templates_path, class: "text-sm text-[#958e9e] hover:text-white transition" %>
          <%= link_to "Deploy", "/deploy", class: "text-sm text-[#958e9e] hover:text-white transition" %>
          <%= link_to "Pricing", pricing_path, class: "text-sm text-[#958e9e] hover:text-white transition" %>
          <%= link_to "Docs", docs_path, class: "text-sm text-[#958e9e] hover:text-white transition" %>
          <%= link_to "Blog", blog_path, class: "text-sm text-[#958e9e] hover:text-white transition" %>
          <a href="https://github.com/johannesdwicahyo/wokku" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm text-[#958e9e] hover:text-white transition">
            GitHub
            <%# Tiny external-link glyph so users know this leaves the site. %>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-9 9M5 7v12h12"/></svg>
          </a>
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <%= button_to public_locale_path(locale: I18n.locale == :en ? :id : :en),
            method: :post,
            class: "text-on-surface-variant hover:text-on-surface text-xs font-mono font-bold px-2 py-1 rounded-md hover:bg-surface-container-high transition-colors cursor-pointer",
            title: I18n.locale == :en ? "Bahasa Indonesia" : "English" do %>
          <%= I18n.locale.to_s.upcase %>
        <% end %>
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_root_path, class: "inline-flex items-center px-3.5 py-1.5 technical-gradient text-[#282a64] text-sm font-semibold rounded-md hover:opacity-90 transition" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "inline-flex items-center px-3.5 py-1.5 technical-gradient text-[#282a64] text-sm font-semibold rounded-md hover:opacity-90 transition" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
