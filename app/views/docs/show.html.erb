<% content_for(:title, docs_page_title) %>

<%= render Molecules::BreadcrumbComponent.new(crumbs: @breadcrumb) %>

<%= render Organisms::DocHeaderComponent.new(
      eyebrow: @doc_eyebrow,
      title:   @doc_title,
      summary: @doc_summary,
      badges:  @doc_badges,
      edited:  @doc_edited,
      source:  @doc_edit_url
    ) %>

<%# Pages that mix how-to with prices (frontmatter cloud_prices: true). %>
<% if @frontmatter["cloud_prices"] && !wokku_cloud? %>
  <p data-cloud-prices-note class="mt-6 border-1.5 border-line bg-bg px-4 py-3 font-mono text-xs text-dim">
    <%= @docs_locale == "id" ? "Harga di halaman ini berlaku untuk wokku.cloud. Instalasi self-host tidak punya tagihan." : "Prices on this page are wokku.cloud's. A self-hosted install has no billing." %>
  </p>
<% end %>

<article class="prose-doc mt-10">
  <%# `@content` is the rendered HTML body; the doc's first H1 is
      already surfaced by DocHeaderComponent so strip it from the
      article body to avoid the double title. %>
  <%= raw strip_first_h1(@content) %>
</article>

<%= render Organisms::DocPagerComponent.new(prev_item: @prev_item, next_item: @next_item) %>
<%# Cloud-only feedback strip — skipped in a standalone engine. %>
<%= render Molecules::FeedbackStripComponent.new if defined?(Molecules::FeedbackStripComponent) %>
