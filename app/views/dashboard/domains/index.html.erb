<%#
  schdl domains (U5 Task 3). slide-panel, render tabs, the two
  turbo_stream_from subscriptions, render row + form_with all preserved
  1:1 from the pre-redesign body — presentation only.
%>
<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :settings) do %>
<%= render Organisms::AppSettingsComponent.new(app: @app, active: :domains) do %>
<div data-controller="slide-panel"<%= " data-slide-panel-auto-open-value=true" if @domain&.errors&.any? %>>

<%
  owned_suffixes = Wokku.config.owned_domains.map { |d| ".#{d}" }
  owned_domains  = @domains.select { |d| owned_suffixes.any? { |s| d.hostname.end_with?(s) } }
  # Prefer the canonical Wokku TLD (post-cutover that's wokku.app) for
  # the displayed/auto-assigned URL; fall back to any other owned domain
  # (e.g. legacy wokku.cloud) so apps backfilled long ago still show one.
  canonical_suffix = ".#{Wokku.config.canonical_domain}"
  wokku_domain   = owned_domains.find { |d| d.hostname.end_with?(canonical_suffix) } || owned_domains.first
  custom_domains = @domains - owned_domains
  fallback_hostname = "#{@app.name}.#{Wokku.config.canonical_domain}"
%>

<%# Wokku Domain (auto-assigned) %>
<div class="bg-paper border-1.5 border-ink rounded-md mb-6 overflow-hidden">
  <div class="px-6 py-4 border-b border-line">
    <h2 class="font-headline text-base font-bold text-ink">Wokku domain</h2>
    <p class="text-xs text-dim mt-1">Your app is available at this auto-assigned URL</p>
  </div>

  <% if wokku_domain %>
    <div class="px-6 py-4 flex items-center justify-between gap-3 flex-wrap">
      <div>
        <%= link_to "↗ #{wokku_domain.hostname}", "https://#{wokku_domain.hostname}", target: "_blank", rel: "noopener", class: "text-sm font-medium text-accent hover:underline transition font-mono" %>
        <div class="flex items-center gap-2 mt-1">
          <% if wokku_domain.ssl_enabled? %>
            <%= render Atoms::StatusPillComponent.new(label: "SSL", tone: :success) %>
          <% end %>
          <span class="text-xs text-dim">Auto-managed</span>
        </div>
      </div>
      <%= link_to "Open app ↗", "https://#{wokku_domain.hostname}", target: "_blank", rel: "noopener", class: Atoms::ButtonComponent.new(variant: :outline, size: :sm).classes %>
    </div>
  <% else %>
    <div class="px-6 py-4 text-sm text-dim">No Wokku domain assigned — sync the server to detect domains.</div>
  <% end %>
</div>

<%# Custom Domains %>
<div class="bg-paper border-1.5 border-ink rounded-md mb-6 overflow-hidden">
  <div class="px-6 py-4 border-b border-line flex items-center justify-between gap-3 flex-wrap">
    <div>
      <h2 class="font-headline text-base font-bold text-ink">Custom domains</h2>
      <p class="text-xs text-dim mt-1">Domains pointing to <span class="text-ink font-medium"><%= @app.name %></span></p>
    </div>
    <button data-action="click->slide-panel#open" class="<%= Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes %>">+ Add domain</button>
  </div>

  <%# Two streams: per-row replacement (frame swaps) + the app-level
      actions stream so toasts from EnableSslJob also surface here. %>
  <%= turbo_stream_from "app_#{@app.id}_domains" %>
  <%= turbo_stream_from @app.action_stream_name %>

  <% if custom_domains.any? %>
    <div class="divide-y divide-line">
      <% custom_domains.each do |domain| %>
        <%= render "row", domain: domain, app: @app %>
      <% end %>
    </div>
  <% else %>
    <div class="px-6 py-8 text-center text-sm text-dim">No custom domains configured.</div>
  <% end %>
</div>

<%= render layout: "dashboard/shared/slide_panel", locals: { title: "Add domain", subtitle: "Configure DNS at your registrar, then add the hostname below" } do %>
  <%# DNS spec forbids CNAME on apex/root domains — show both paths. %>
  <div class="space-y-3 mb-5 text-xs">
    <div class="border-1.5 border-ink bg-bg rounded-md p-3">
      <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-1">Subdomain (e.g. <code class="font-mono">app.example.com</code>)</p>
      <p class="text-ink-soft">Add a <span class="text-ink font-semibold">CNAME</span> → <span class="text-accent font-mono break-all"><%= wokku_domain&.hostname || fallback_hostname %></span></p>
    </div>
    <div class="border-1.5 border-ink bg-bg rounded-md p-3">
      <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-1">Root domain (e.g. <code class="font-mono">example.com</code>)</p>
      <p class="text-ink-soft">Add an <span class="text-ink font-semibold">A record</span> → <span class="text-accent font-mono"><%= @app.server&.host %></span></p>
      <p class="text-[10px] text-dim mt-1">Or <span class="font-medium">ALIAS</span>/<span class="font-medium">ANAME</span> to <span class="font-mono break-all"><%= wokku_domain&.hostname || fallback_hostname %></span> if your DNS provider supports CNAME flattening.</p>
    </div>
  </div>

  <%= render "dashboard/shared/form_errors", record: @domain, title: "Couldn't add domain" %>
  <%= form_with(model: @domain || Domain.new, url: dashboard_app_domains_path(@app), class: "space-y-4") do |f| %>
    <div>
      <%= f.label :hostname, class: "block text-xs font-semibold text-ink-soft mb-1" %>
      <%= f.text_field :hostname, class: "w-full bg-paper border-1.5 border-ink text-ink font-mono text-sm rounded-md px-3 py-2 focus:outline-none focus:shadow-brutal-sm", placeholder: "app.example.com", autofocus: true %>
    </div>
    <div class="flex items-center gap-3">
      <%= f.submit "Add domain", class: Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes %>
      <button type="button" data-action="click->slide-panel#close" class="<%= Atoms::ButtonComponent.new(variant: :ghost, size: :sm).classes %>">Cancel</button>
    </div>
  <% end %>
<% end %>
</div>
<% end %>
<% end %>
