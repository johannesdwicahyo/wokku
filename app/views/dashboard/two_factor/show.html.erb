<%= render Organisms::SettingsTabsComponent.new(active_tab: :security) do %>

<div class="max-w-lg mx-auto">
  <h1 class="font-mono text-2xl font-semibold tracking-tighter text-ink mb-2"><span class="text-dim"># </span><%= t("auth.two_factor.title") %></h1>
  <p class="font-mono text-sm text-dim mb-8">// <%= t("auth.two_factor.subtitle") %></p>

  <% if current_user.two_factor_enabled? %>
    <div class="border-1.5 border-success bg-success-soft p-6 mb-6">
      <h2 class="font-mono text-sm font-semibold text-ink mb-3">✓ <%= t("auth.two_factor.enabled") %></h2>
      <p class="font-mono text-xs text-dim mb-4"><%= t("auth.two_factor.enabled_desc") %></p>
      <%= form_with url: disable_dashboard_two_factor_path, method: :delete, class: "space-y-3" do |f| %>
        <div>
          <label class="block font-mono text-xs text-dim mb-1 uppercase tracking-widest font-bold"><%= t("auth.two_factor.enter_to_disable") %></label>
          <%= f.text_field :otp_code, class: "w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink focus:outline-none focus:border-accent", placeholder: "000000", maxlength: 6, autocomplete: "one-time-code" %>
        </div>
        <%= f.submit t("auth.two_factor.disable"), class: "px-4 py-2 font-mono text-sm font-semibold text-danger border-1.5 border-danger bg-danger-soft hover:opacity-90 transition cursor-pointer" %>
      <% end %>
    </div>
  <% else %>
    <div class="border-1.5 border-ink bg-paper p-6 mb-6">
      <h2 class="font-mono text-sm font-semibold text-ink mb-4">1. <%= t("auth.two_factor.scan_qr") %></h2>
      <p class="font-mono text-xs text-dim mb-4"><%= t("auth.two_factor.scan_qr_desc") %></p>
      <div class="bg-white border-1.5 border-ink p-4 inline-block mb-4">
        <%= sanitize @qr_code,
            tags: %w[svg g path rect circle title desc],
            attributes: %w[xmlns width height viewBox fill stroke stroke-width d x y rx ry cx cy r transform shape-rendering version] %>
      </div>
    </div>

    <div class="border-1.5 border-ink bg-paper p-6">
      <h2 class="font-mono text-sm font-semibold text-ink mb-4">2. <%= t("auth.two_factor.enter_code") %></h2>
      <%= form_with url: enable_dashboard_two_factor_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label class="block font-mono text-xs text-dim mb-1 uppercase tracking-widest font-bold"><%= t("auth.two_factor.six_digit") %></label>
          <%= f.text_field :otp_code, class: "w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink text-center text-lg tracking-[0.5em] focus:outline-none focus:border-accent", placeholder: "000000", maxlength: 6, autocomplete: "one-time-code" %>
        </div>
        <%= f.submit t("auth.two_factor.enable"), class: "w-full py-2 px-4 bg-ink text-bg font-mono text-sm font-semibold border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer text-center" %>
      <% end %>
    </div>
  <% end %>
</div>

<% end %>
