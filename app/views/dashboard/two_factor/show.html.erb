<%# schdl (U5 Task 7). form_with url/method + otp_code field name preserved
    1:1 — presentation only. Field-anatomy on both OTP forms. %>
<% content_for :title, "Two-factor authentication" %>

<%= render Organisms::SettingsTabsComponent.new(active_tab: :security, show_admin: current_user&.admin?) do %>

<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <h2 class="font-headline text-base font-bold text-ink"><%= t("auth.two_factor.title") %></h2>
    <p class="text-xs text-dim mt-1"><%= t("auth.two_factor.subtitle") %></p>
  </div>

  <% if current_user.two_factor_enabled? %>
    <div class="border-1.5 border-success bg-success-soft rounded-md p-6 mb-6">
      <h3 class="text-sm font-bold text-ink mb-3"><%= t("auth.two_factor.enabled") %></h3>
      <p class="text-xs text-ink-soft mb-4"><%= t("auth.two_factor.enabled_desc") %></p>
      <%= form_with url: disable_dashboard_two_factor_path, method: :delete, class: "space-y-3" do |f| %>
        <div>
          <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t("auth.two_factor.enter_to_disable") %></label>
          <%= f.text_field :otp_code, class: "w-full bg-paper border-1.5 border-ink rounded-md px-3 py-2 text-sm text-ink focus:outline-none focus:shadow-brutal-sm", placeholder: "000000", maxlength: 6, autocomplete: "one-time-code" %>
        </div>
        <%= f.submit t("auth.two_factor.disable"), class: Atoms::ButtonComponent.new(variant: :danger, size: :md).classes %>
      <% end %>
    </div>
  <% else %>
    <div class="border-1.5 border-ink bg-paper rounded-md p-6 mb-6">
      <h3 class="text-sm font-bold text-ink mb-4">1. <%= t("auth.two_factor.scan_qr") %></h3>
      <p class="text-xs text-dim mb-4"><%= t("auth.two_factor.scan_qr_desc") %></p>
      <div class="bg-white border-1.5 border-ink rounded-md p-4 inline-block mb-4">
        <%= sanitize @qr_code,
            tags: %w[svg g path rect circle title desc],
            attributes: %w[xmlns width height viewBox fill stroke stroke-width d x y rx ry cx cy r transform shape-rendering version] %>
      </div>
    </div>

    <div class="border-1.5 border-ink bg-paper rounded-md p-6">
      <h3 class="text-sm font-bold text-ink mb-4">2. <%= t("auth.two_factor.enter_code") %></h3>
      <%= form_with url: enable_dashboard_two_factor_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t("auth.two_factor.six_digit") %></label>
          <%= f.text_field :otp_code, class: "w-full bg-paper border-1.5 border-ink rounded-md px-3 py-2 text-sm text-ink text-center text-lg tracking-[0.5em] focus:outline-none focus:shadow-brutal-sm", placeholder: "000000", maxlength: 6, autocomplete: "one-time-code" %>
        </div>
        <%= f.submit t("auth.two_factor.enable"), class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full justify-center").classes %>
      <% end %>
    </div>
  <% end %>
</div>

<% end %>
