<%#
  Brutalist dashboard (P2 of redesign-c-full, 2026-05-17). Real Rails
  data wired into the brutalist console layout. Old Material view kept
  at show.OLD_DESIGN.html.erb until P7 cleanup.
%>
<%
  status_dot_state = ->(app) do
    case app.status
    when "running"   then :live
    when "crashed"   then :crashed
    when "sleeping", "stopped" then :sleeping
    else :building # deploying / created
    end
  end

  # estimated_daily_cost returns an already-currency-converted integer;
  # the brutalist tile renders via format_usd_for_user which expects USD
  # dollars, so derive the USD-dollar daily rate from the monthly cents.
  daily_cost_usd = current_user.estimated_monthly_cost_cents / 100.0 / 30.0
  runway_days = current_user.days_of_balance_remaining
  runway_str  = runway_days == Float::INFINITY ? "∞" : "#{runway_days}d"
  low_runway  = runway_days != Float::INFINITY && runway_days <= 3
%>

<div data-controller="slide-panel" class="flex flex-col gap-6">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <%= render Atoms::HashHeaderComponent.new(
          title: t("console.dashboard.title"),
          kicker: t("console.dashboard.kicker"),
          size: :md) %>
    <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, mono: true,
          data: { action: "click->slide-panel#open" }) do %>> new_app()<% end %>
  </div>

  <%# ── Stat tiles ───────────────────────────────────────────── %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <%= render Molecules::StatTileComponent.new(
          label: t("console.dashboard.stat.apps"), value: @stats[:total_apps],
          sub: "// #{@stats[:active]} running · #{@apps.size - @stats[:active]} idle", glyph: ">_") %>
    <%= render Molecules::StatTileComponent.new(
          label: t("console.dashboard.stat.resources"), value: @stats[:active],
          sub: "// across #{@servers.size} server#{'s' unless @servers.size == 1}", glyph: "▮▮") %>
    <%= render Molecules::StatTileComponent.new(
          label: t("console.dashboard.stat.errors"), value: @stats[:errors],
          sub: @stats[:errors].zero? ? "// all healthy" : "// needs attention",
          tone: @stats[:errors].zero? ? :success : :danger,
          glyph: @stats[:errors].zero? ? "✓" : "!") %>
    <%= render Molecules::StatTileComponent.new(
          label: t("console.dashboard.stat.cost"), value: format_usd_for_user(@stats[:cost_mtd]),
          sub: "// month to date", glyph: "Rp") %>
  </div>

  <%# ── Deposit + PR previews ────────────────────────────────── %>
  <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-3">
    <%= render Molecules::PanelComponent.new(
          label: t("console.dashboard.deposit"),
          kicker: "#{t('console.dashboard.runway')}: #{runway_str}") do %>
      <div class="px-5 py-5 flex flex-wrap items-baseline justify-between gap-6">
        <div>
          <div class="font-mono text-xs text-dim">// saldo deposit</div>
          <div class="font-mono text-3xl md:text-4xl text-ink font-semibold tracking-tighter mt-1.5"><%= current_user.balance_formatted %></div>
          <% if low_runway %>
            <div class="font-mono text-[11px] text-danger mt-1.5"><%= t("console.dashboard.low_runway") %></div>
          <% end %>
        </div>
        <% if respond_to?(:dashboard_billing_path) %>
          <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, mono: true, href: dashboard_billing_path) do %>> top_up()<% end %>
        <% end %>
      </div>
      <div class="px-5 py-3 border-t border-rule-soft font-mono text-[11px] text-dim flex flex-wrap gap-x-4 gap-y-1 justify-between">
        <span>// daily rate: <%= format_usd_for_user(daily_cost_usd) %> · next debit: 01:00 WIB</span>
        <span>qris · gopay · ovo · dana</span>
      </div>
    <% end %>

    <% if (team = current_user.teams.first) %>
      <% slots = AppRecord.previews.where(team: team).count %>
      <% cap = Preview::CapEnforcer.cap %>
      <%= render Molecules::PanelComponent.new(
            label: t("console.dashboard.pr_previews"), kicker: "slots: #{slots} / #{cap}") do %>
        <div class="px-5 py-5">
          <div class="font-mono text-3xl md:text-4xl text-ink font-semibold tracking-tighter"><%= slots %> / <%= cap %></div>
          <div class="font-mono text-[11px] text-dim mt-2">
            <%= slots.zero? ? t("console.dashboard.pr_idle") : "// #{slots} preview environment#{'s' unless slots == 1} running" %>
          </div>
          <div class="mt-4 flex gap-1">
            <% cap.times do |i| %>
              <div class="flex-1 h-2 border border-rule-soft <%= i < slots ? 'bg-accent' : 'bg-bg' %>"></div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @apps.any? %>
    <%# ── Recent apps + activity ────────────────────────────── %>
    <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-3 items-start">
      <%= render Molecules::PanelComponent.new(
            label: t("console.dashboard.apps_recent"), kicker: t("console.dashboard.view_all")) do %>
        <% @recent_apps.each_with_index do |app, i| %>
          <% primary_domain = app.domains.find { |d| d.hostname.end_with?(".wokku.cloud") } || app.domains.first %>
          <%= link_to dashboard_app_path(app),
                class: "grid grid-cols-[1.2fr_auto] md:grid-cols-[1.2fr_1.4fr_0.8fr_auto] items-center gap-3 md:gap-4 px-5 py-4 hover:bg-bg-deep transition-colors #{'border-b border-rule-soft' if i < @recent_apps.size - 1}" do %>
            <div class="min-w-0">
              <div class="font-mono text-sm text-ink font-semibold truncate"><%= app.name %></div>
              <div class="font-mono text-[11px] text-dim mt-1"><%= app.server&.name || "—" %></div>
            </div>
            <div class="hidden md:flex font-mono text-xs text-accent items-center gap-1.5 min-w-0">
              <span class="text-dim">↗</span>
              <span class="truncate"><%= primary_domain&.hostname || "no domain" %></span>
            </div>
            <div class="hidden md:block font-mono text-[11px] text-dim"><%= time_ago_in_words(app.updated_at) %> ago</div>
            <%= render Atoms::StatusDotComponent.new(state: status_dot_state.call(app)) %>
          <% end %>
        <% end %>
      <% end %>

      <%= render Molecules::PanelComponent.new(
            label: t("console.dashboard.activity"), kicker: t("console.dashboard.activity_window")) do %>
        <% if @activities.any? %>
          <% @activities.each_with_index do |a, i| %>
            <% count = a.respond_to?(:grouped_count) ? a.grouped_count : nil %>
            <div class="px-5 py-3 <%= 'border-b border-rule-soft' if i < @activities.size - 1 %> flex items-start gap-3">
              <span class="w-1.5 h-1.5 mt-1.5 flex-shrink-0 bg-accent"></span>
              <div class="flex-1 min-w-0">
                <div class="font-mono text-[10px] tracking-widest text-dim uppercase"><%= a.action.split(".").first %></div>
                <div class="font-mono text-xs text-ink mt-0.5 truncate">
                  <%= a.description %> <span class="text-accent"><%= a.target_name %></span><%= " ×#{count}" if count && count > 1 %>
                </div>
                <div class="font-mono text-[10px] text-dim mt-0.5"><%= time_ago_in_words(a.created_at) %> ago</div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="px-5 py-6 font-mono text-xs text-dim">// no recent activity</div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%# ── One-job first-deploy chooser ────────────────────────── %>
    <%
      registry = TemplateRegistry.new
      curated  = %w[astro ghost n8n nextjs].select { |s| registry.find(s) }
    %>
    <%= render Molecules::PanelComponent.new(label: t("onboarding2.title"), kicker: t("onboarding2.sub")) do %>
      <div class="p-6 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <% curated.each do |slug| %>
          <% tpl = registry.find(slug) %>
          <%= link_to dashboard_template_path(slug, prefill: 1),
                class: "border-1.5 border-ink bg-paper p-4 hover:bg-bg-deep transition font-mono block",
                data: (slug == "astro" ? { tour_target: "pick" } : {}) do %>
            <div class="text-sm font-semibold text-ink"><%= tpl[:name] %></div>
            <div class="text-[11px] text-dim mt-1 line-clamp-2"><%= tpl[:description] %></div>
            <div class="text-xs text-accent mt-3">&gt; deploy()</div>
          <% end %>
        <% end %>
      </div>
      <div class="px-6 pb-5">
        <button data-action="click->slide-panel#open" class="font-mono text-xs text-dim hover:text-ink underline">
          <%= t("onboarding2.push_own") %>
        </button>
        <p class="font-mono text-[11px] text-dim mt-2">// <%= t("onboarding2.building") %></p>
      </div>
    <% end %>
  <% end %>

  <%= render layout: "dashboard/shared/slide_panel", locals: { title: "New App", subtitle: "Deploy a new application" } do %>
    <%= render "dashboard/apps/form", app: AppRecord.new, servers: @servers %>
  <% end %>
</div>
