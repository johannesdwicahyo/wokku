<% content_for :title, "Apps" %>
<%# Wrap the apps index + Create-App slide-panel in one slide-panel
    scope so the "+ NEW APP" button in AppsIndexComponent can dispatch
    click->slide-panel#open (consistent with databases / admin/servers). %>
<div data-controller="slide-panel">
  <%= render Organisms::AppsIndexComponent.new(
        apps: @apps, plan: @plan, box_usage: @box_usage, recent_activity: @recent_activity
      ) %>

  <%= render layout: "dashboard/shared/slide_panel",
             locals: { title: "Create App", subtitle: "Deploy a new application to one of your servers", size: "lg" } do %>
    <%= render "form", app: @app, servers: @servers %>
  <% end %>
</div>
