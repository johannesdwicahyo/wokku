<%# schdl transfer (U5 Task 5). form_with post + cancel-transfer
    turbo_method/turbo_confirm preserved 1:1 — presentation only. %>
<% content_for :title, "Transfer #{@app.name}" %>

<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :settings) do %>
  <%= render Organisms::AppSettingsComponent.new(app: @app, active: :transfer) do %>

    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="px-6 py-4 border-b border-line">
        <h2 class="font-headline text-base font-bold text-ink">Transfer ownership</h2>
        <p class="text-xs text-dim mt-1">Hand off this app to another user — they pick up future billing once they accept.</p>
      </div>

      <% if @pending_transfer %>
        <div class="px-6 py-5 border-b border-line bg-warn-soft">
          <div class="mb-2"><%= render Atoms::StatusPillComponent.new(label: "Pending", tone: :warn) %></div>
          <p class="text-sm text-ink">
            Awaiting acceptance from <span class="font-medium"><%= @pending_transfer.to_user.email %></span>.
            Expires <%= time_ago_in_words(@pending_transfer.expires_at) %> from now.
          </p>
          <div class="mt-3">
            <%= link_to "Cancel transfer", dashboard_app_transfer_path(@pending_transfer),
                  data: { turbo_method: :delete, turbo_confirm: "Cancel the pending transfer to #{@pending_transfer.to_user.email}?" },
                  class: Atoms::ButtonComponent.new(variant: :outline, size: :sm).classes %>
          </div>
        </div>
      <% end %>

      <div class="px-6 py-5">
        <%= form_with url: transfer_dashboard_app_path(@app), method: :post, class: "space-y-4" do |f| %>
          <div>
            <label class="block text-xs font-semibold text-ink-soft mb-1" for="transfer_email">
              Recipient email
            </label>
            <input type="email" name="email" id="transfer_email" required
                   placeholder="someone@example.com"
                   <%= "disabled" if @pending_transfer %>
                   class="w-full border-1.5 border-ink bg-paper rounded-md px-3 py-2 text-sm text-ink placeholder:text-dim focus:outline-none focus:shadow-brutal-sm transition disabled:opacity-50">
            <p class="text-xs text-dim mt-2">
              The recipient must already have a Wokku account. They'll get an email and can accept from their inbox at /dashboard/app_transfers.
            </p>
          </div>

          <div class="flex items-center justify-between gap-4 flex-wrap">
            <p class="text-xs text-dim">Agency-friendly: hand the build to your client, they pick up the bill.</p>
            <%= f.submit @pending_transfer ? "Transfer pending" : "Send transfer request",
                  class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "disabled:opacity-50 disabled:cursor-not-allowed").classes,
                  disabled: @pending_transfer.present? %>
          </div>
        <% end %>
      </div>
    </div>

  <% end %>
<% end %>
