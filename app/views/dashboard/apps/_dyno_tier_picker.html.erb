<%
  # Card-style picker matching the addon "Plan" cards. Renders a grid of
  # DynoTiers with a hidden input that posts as app_record[dyno_tier_id].
  #
  # Defaults to Free so users on the no-money plan can ship without
  # picking; experienced users can pick up-front. Tiers with a per-user
  # cap (today: free, max_per_user=1) render disabled when the user is
  # already at the cap, with a note pointing to upgrade. If Free is
  # capped, the default selection falls through to the cheapest paid
  # tier so the form doesn't pre-select an unsubmittable card.
  tiers = DynoTier.order(:monthly_price_cents)
  capped_ids = tiers.select { |t| t.at_cap_for?(current_user) }.map(&:id)
  default_tier = tiers.reject { |t| capped_ids.include?(t.id) }.first
  selected_id = local_assigns[:selected_id] || default_tier&.id
%>
<div data-controller="dyno-tier-picker">
  <label class="block text-xs font-semibold text-on-surface-variant mb-1.5 uppercase tracking-wider">Container Size</label>
  <input type="hidden" name="app_record[dyno_tier_id]" value="<%= selected_id %>" data-dyno-tier-picker-target="input">
  <div class="grid grid-cols-1 gap-2">
    <% tiers.each do |tier| %>
      <% capped = capped_ids.include?(tier.id) %>
      <% is_selected = tier.id == selected_id && !capped %>
      <button type="button"
              data-tier-id="<%= tier.id %>"
              <%= capped ? "disabled" : "data-action=click->dyno-tier-picker#select".html_safe %>
              class="w-full text-left rounded-md border <%= is_selected ? "border-primary bg-primary/5" : "border-outline-variant/15 hover:border-outline-variant/40" %> px-3 py-2.5 transition <%= capped ? "opacity-50 cursor-not-allowed" : "cursor-pointer" %>">
        <div class="flex items-center justify-between mb-1">
          <span class="text-sm font-semibold text-on-surface uppercase"><%= tier.name %></span>
          <span class="text-xs font-mono text-on-surface-variant">
            <%= tier.free? ? "Free" : "#{format_usd_for_user(tier.monthly_price_dollars)}#{price_period}" %>
          </span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-xs text-outline">
            <%= tier.memory_mb %> MB · <%= vcpu_display(tier.cpu_shares) %> vCPU
          </span>
          <% if capped %>
            <span class="text-[10px] text-outline uppercase tracking-wider">
              Limit reached (<%= tier.max_per_user %>/user)
            </span>
          <% end %>
        </div>
      </button>
    <% end %>
  </div>
  <p class="mt-1 text-[11px] text-outline">You can change this anytime from the app's Resource Limits panel.</p>
</div>
