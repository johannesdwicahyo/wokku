<%# locals: (metric:, latest:, history:) %>
<div class="bg-paper border border-line rounded-md p-4">
  <div class="text-[10px] uppercase tracking-wide text-dim font-bold mb-1"><%= metric %></div>
  <% if latest %>
    <div class="text-2xl text-ink font-semibold tabular-nums"><%= latest.p75.round %><span class="text-xs text-dim ml-1 font-normal">p75</span></div>
    <div class="text-[10px] text-dim mt-1 tabular-nums">
      p50 <%= latest.p50.round %> · p95 <%= latest.p95.round %> · n=<%= latest.sample_count %>
    </div>
    <% if history.size >= 2 %>
      <div class="mt-3 flex items-end gap-0.5 h-8">
        <% max = history.map(&:p75).max %>
        <% history.last(24).each do |r| %>
          <div class="bg-ink w-1.5 rounded-t-sm" style="height: <%= ((r.p75 / max.to_f) * 100).round %>%"></div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="text-2xl text-dim">—</div>
    <div class="text-[10px] text-dim mt-1">No samples.</div>
  <% end %>
</div>
