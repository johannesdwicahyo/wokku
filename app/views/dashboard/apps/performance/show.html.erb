<% content_for :title, "#{@app.name} · Performance" %>

<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :performance) do %>
<%= render Organisms::PerformanceTabsComponent.new(app: @app, active: :vitals) do %>

<div class="p-6">
  <% if @latest.empty? %>
    <%= render "empty_state" %>
  <% else %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      <% VitalsEvent::METRICS.each do |metric| %>
        <%= render "metric_card",
                   metric:  metric,
                   latest:  @latest[metric],
                   history: (@series[metric] || []) %>
      <% end %>
    </div>

    <div class="mt-8 bg-paper border-1.5 border-ink p-4">
      <h2 class="font-mono text-xs uppercase tracking-wide text-ink mb-2">Install snippet</h2>
      <pre class="bg-bg-deep border-1.5 border-ink p-3 overflow-x-auto text-xs"><code><%= @snippet %></code></pre>
      <%= button_to t("dashboard.performance.rotate_token", default: "Rotate token"),
                    rotate_token_dashboard_app_performance_path(@app),
                    method: :post,
                    data: { confirm: t("dashboard.performance.rotate_confirm", default: "Rotating invalidates any deployed script tags. Continue?") },
                    class: "mt-3 inline-block px-3 py-1 bg-ink text-bg font-mono text-xs uppercase" %>
    </div>
  <% end %>
</div>
<% end %>
<% end %>
