<%# Phase 5 create page: sections 01-03 left, sticky summary right. POST goes
    to AppsController#create (params contract in Task 4 notes). %>
<% source_key = current_user.github_installation_id.present? ? "github" : "git" %>
<% content_for :title, t("new_app.page.title") %>
<div class="container py-6">
  <header class="mb-6">
    <h1 class="font-headline text-2xl font-extrabold text-ink"><%= t("new_app.page.title") %></h1>
    <p class="mt-1 text-sm text-muted"><%= t("new_app.page.intro") %></p>
  </header>

  <%= form_with(model: @app, url: dashboard_apps_path, data: Organisms::NewAppSizeComponent.root_data) do |f| %>
    <% if @app.errors.any? %>
      <div class="mb-4 border border-danger bg-danger-soft rounded-md p-3" role="alert">
        <ul class="text-xs text-bad-text space-y-1"><% @app.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px] items-start">
      <div class="space-y-6 min-w-0">
        <%= render Molecules::PanelComponent.new(label: t("new_app.page.source")) do %>
          <div class="p-4"><%= render Organisms::NewAppSourceComponent.new(user: current_user) %></div>
        <% end %>

        <%= render Molecules::PanelComponent.new(label: t("new_app.page.name_size")) do %>
          <div class="p-4 space-y-5">
            <% if @servers.size > 1 %>
              <div>
                <span id="server_label" class="<%= Organisms::NewAppSourceComponent::LABEL %>"><%= t("new_app.page.server") %></span>
                <%= combobox_tag "app_record[server_id]",
                      @servers.map { |s| { value: s.id, label: s.name, description: s.host } },
                      value: @server&.id, placeholder: t("new_app.page.server_placeholder"), required: true,
                      data: { action: "change->new-app#server" } %>
              </div>
            <% else %>
              <%= hidden_field_tag "app_record[server_id]", @server&.id %>
            <% end %>
            <%= render Organisms::NewAppSizeComponent.new(sleeping: @sleeping_default, sleeping_option: true,
                  box_quota: @box_quota) %>
          </div>
        <% end %>

        <%= render Molecules::PanelComponent.new(label: t("new_app.page.addons")) do %>
          <div class="p-4">
            <%= render "new_addons" %>
          </div>
        <% end %>
      </div>

      <%= render Organisms::NewAppSummaryComponent.new(app_name: @app.name, source: t("new_app.source.#{source_key}.title"), price_idr: @price_idr) %>
    </div>
  <% end %>
</div>
