<%# Standalone Create App page. Kept as a direct-link fallback;
    the apps index opens the same form inside a modal via the
    "+ NEW APP" button. %>
<div class="container py-6 max-w-xl">
  <div class="mb-6">
    <a href="<%= dashboard_apps_path %>"
       class="font-mono text-[11px] uppercase tracking-widest text-ink-soft hover:text-ink">
      ← back to apps
    </a>
    <h1 class="mt-2 font-headline text-2xl font-extrabold text-ink"><%= t("dashboard.apps.create_app") %></h1>
    <p class="mt-1 font-mono text-xs text-ink-soft">// deploy a new application to one of your servers</p>
  </div>

  <div class="border-1.5 border-ink bg-paper p-6">
    <%= render "form", app: @app, servers: @servers %>
  </div>
</div>
