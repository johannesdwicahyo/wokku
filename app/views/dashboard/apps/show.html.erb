<% content_for :title, @app.name %>
<%= render Molecules::CrashLoopBannerComponent.new(app: @app) %>
<%= render Organisms::AppHeaderComponent.new(app: @app, releases: @releases, can_update: policy(@app).update?) %>
<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :overview) do %>
  <%= render Organisms::AppOverviewComponent.new(app: @app, releases: @releases, current_release: @current_release,
        domains: @domains, stats: @stats, can_update: policy(@app).update?) %>
<% end %>
