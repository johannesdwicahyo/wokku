<%# target: "_top" — links in the rack break out to a full-page visit
    instead of navigating within this frame. Must match the placeholder.
    The live deploy log reloads this frame, so the track renders inside it
    and the shell's frame keeps its src. %>
<%= turbo_frame_tag "apps_list", target: "_top" do %>
  <div class="flex flex-col gap-5">
    <%= render Organisms::AppsOverviewComponent.new(fleet: @fleet, running: @fleet_running, total: @fleet_total, deploying: @fleet_deploying, readouts: @readouts) %>
    <%= render Organisms::DeployTrackComponent.new(deploy: @track_deploy, more: @track_more) %>
    <%= render Organisms::AppsRackComponent.new(apps: @apps, sparks: @sparks, last_deploys: @last_deploys, crashes: @crashes) %>
  </div>
<% end %>
