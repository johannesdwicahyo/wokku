<%# Populated frame for the CPU / Memory / Containers cards. Rendered from
    AppsController#runtime_metrics_frame. The enclosing <turbo-frame id=
    "runtime_metrics"> tag is critical — it matches the placeholder on #show
    so Turbo swaps this in once the SSH round-trip completes. %>
<%= turbo_frame_tag "runtime_metrics" do %>
  <% if @container_stats.any? %>
    <%
      total_cpu    = @container_stats.sum { |s| s[:cpu_percent] }
      total_mem_mb = @container_stats.sum do |s|
        u = s[:mem_usage].split("/").first.strip
        u.include?("GiB") ? u.to_f * 1024 : u.to_f
      end
      # Use the dyno tier as the authoritative memory cap. Docker's stats
      # "usage / limit" string can fall back to the host's total RAM when
      # the container has no enforced --memory flag (then we'd display
      # "122 MB / 128614 MB" — confusing for users who chose a 512 MB
      # tier). The tier the user is paying for is the right number to
      # show and to colour the bar against.
      web_alloc = @app.dyno_allocations.find_by(process_type: "web")
      tier_limit_mb = web_alloc&.dyno_tier&.memory_mb
      container_count = @container_stats.size
      total_limit = if tier_limit_mb && container_count.positive?
        tier_limit_mb * container_count
      end
      mem_pct = total_limit ? (total_mem_mb / total_limit * 100).round(1) : @container_stats.sum { |s| s[:mem_percent] }
      mem_bar = mem_pct > 80 ? "bg-danger" : mem_pct > 60 ? "bg-warn" : "bg-accent"
    %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div class="border-1.5 border-ink bg-paper px-5 py-5">
        <p class="font-mono text-[10px] text-dim uppercase tracking-widest">cpu_usage</p>
        <div class="font-mono text-3xl font-semibold text-ink tracking-tighter mt-2.5"><%= "%.1f" % total_cpu %> <span class="text-dim text-base">%</span></div>
        <div class="mt-3 h-1.5 bg-bg border border-rule-soft relative">
          <div class="absolute inset-0 bg-accent" style="width: <%= [total_cpu, 100].min %>%"></div>
        </div>
      </div>
      <div class="border-1.5 <%= mem_pct > 80 ? 'border-danger bg-danger-soft' : 'border-ink bg-paper' %> px-5 py-5">
        <p class="font-mono text-[10px] <%= mem_pct > 80 ? 'text-danger' : 'text-dim' %> uppercase tracking-widest">memory_usage</p>
        <div class="font-mono text-3xl font-semibold text-ink tracking-tighter mt-2.5">
          <%= "%.0f" % total_mem_mb %> <span class="text-dim text-base">MB<%= total_limit ? " / #{total_limit}" : "" %></span>
        </div>
        <% if total_limit %>
          <div class="mt-3 h-1.5 bg-bg border border-rule-soft relative">
            <div class="absolute inset-0 <%= mem_bar %>" style="width: <%= [mem_pct, 100].min %>%"></div>
          </div>
        <% end %>
      </div>
      <div class="border-1.5 border-ink bg-paper px-5 py-5">
        <p class="font-mono text-[10px] text-dim uppercase tracking-widest">containers</p>
        <div class="font-mono text-3xl font-semibold text-ink tracking-tighter mt-2.5"><%= @container_stats.size %></div>
        <p class="font-mono text-[11px] text-dim mt-1">
          <% @container_stats.each_with_index do |s, i| %><span><%= s[:name].sub("#{@app.name}.", "") %></span><%= i < @container_stats.size - 1 ? " · " : "" %><% end %>
        </p>
      </div>
    </div>
  <% else %>
    <div class="border-1.5 border-ink bg-paper px-5 py-6 text-center font-mono text-xs text-dim">// no running containers</div>
  <% end %>
<% end %>
