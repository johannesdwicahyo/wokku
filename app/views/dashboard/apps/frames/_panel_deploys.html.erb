<%# Record panel "Recent deploys" section — version/status/time rows,
    no card-in-card (the panel body is already the card). %>
<%= turbo_frame_tag "app_panel_deploys_#{@panel_app.id}" do %>
  <% if @panel_releases.any? %>
    <div class="space-y-1.5">
      <% @panel_releases.each do |release| %>
        <div class="flex justify-between gap-3 text-[13px]">
          <span class="text-dim font-medium">v<%= release.version %><% if release.deploy&.status %> · <%= release.deploy.status %><% end %></span>
          <span><%= time_ago(release.created_at) %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-[13px] text-dim"><%= t("dashboard.apps.panel.no_deploys") %></p>
  <% end %>
<% end %>
