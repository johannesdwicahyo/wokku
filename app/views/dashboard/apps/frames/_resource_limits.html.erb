<%= turbo_frame_tag "resource_limits" do %>
  <%
    mem_limit = @resources["default_limit_memory"]
    cpu_limit = @resources["default_limit_cpu"]
    any_limit = mem_limit.present? || cpu_limit.present?
  %>
  <div class="border-1.5 border-ink bg-paper">
    <div class="px-5 py-2.5 border-b border-rule-soft flex items-center justify-between font-mono text-[11px] text-dim tracking-widest uppercase">
      <span>resource_limits</span>
      <%= link_to "change_plan →", dashboard_app_resources_path(@app), class: "text-accent hover:underline normal-case tracking-tight", data: { turbo_frame: "_top" } %>
    </div>
    <% if any_limit %>
      <div class="grid grid-cols-2 divide-x divide-rule-soft">
        <div class="px-4 py-4 text-center">
          <p class="font-mono text-[10px] text-dim uppercase tracking-widest mb-1">memory</p>
          <span class="font-mono text-lg font-semibold text-ink"><%= mem_limit || "—" %> MB</span>
        </div>
        <div class="px-4 py-4 text-center">
          <p class="font-mono text-[10px] text-dim uppercase tracking-widest mb-1">cpu</p>
          <span class="font-mono text-lg font-semibold text-ink"><%= vcpu_display(cpu_limit) %> vCPU</span>
        </div>
      </div>
    <% else %>
      <div class="px-5 py-4 text-center font-mono text-xs text-dim">// no explicit limits — using container tier defaults</div>
    <% end %>
  </div>
<% end %>
