<%# Brutalist (P7). app-name-check + combobox + slide-panel#close
    wiring preserved 1:1. Renders in the new-app slide-panel on the
    brutalist dashboard + apps index. %>
<%= form_with(model: app, url: dashboard_apps_path, class: "space-y-4",
              data: { controller: "app-name-check" }) do |f| %>
  <% if app.errors.any? %>
    <div class="border-1.5 border-danger bg-danger-soft p-3">
      <ul class="font-mono text-xs text-danger space-y-1">
        <% app.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Name with live availability check %>
  <div>
    <%= f.label :name, class: "block font-mono text-[10px] font-medium text-dim mb-1.5 uppercase tracking-widest" %>
    <%= f.text_field :name,
        class: "w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent",
        placeholder: "my-app",
        autocomplete: "off",
        pattern: "[a-z][a-z0-9\\-]*",
        title: "Lowercase letters, numbers, and hyphens",
        data: {
          app_name_check_target: "input",
          action: "input->app-name-check#check"
        } %>
    <p class="mt-1 font-mono text-[11px] text-dim" data-app-name-check-target="status"></p>
    <div class="mt-1.5 hidden flex flex-wrap gap-1.5" data-app-name-check-target="suggestions"></div>
  </div>

  <%# Server picker — themed combobox (search-as-you-type) %>
  <div>
    <label class="block font-mono text-[10px] font-medium text-dim mb-1.5 uppercase tracking-widest">Server</label>
    <%
      server_options = servers.map { |s| { value: s.id, label: s.name, description: s.host } }
      preset = servers.size == 1 ? servers.first.id : nil
    %>
    <%= combobox_tag "app_record[server_id]", server_options, value: preset, placeholder: "Search servers…", required: true %>
    <p class="mt-1 font-mono text-[11px] text-dim">
      <%= servers.size %> <%= "server".pluralize(servers.size) %> available
    </p>
  </div>

  <% if Addons::SharedProvisioner.feature_enabled? %>
    <%#
      Bundle v2: Box size picker.
      Maps user-visible names to DynoTier via Plan::BOX_SIZE_TO_DYNO_TIER.
      Sizes with a plan quota of 0 are shown disabled.
    %>
    <%
      plan         = defined?(@plan) ? @plan : current_user.current_plan
      box_sizes    = %w[sleeping small medium large xlarge]
      default_size = box_sizes.find { |s| plan.quota_for(s) > 0 } || "sleeping"
    %>
    <div>
      <label class="block font-mono text-[10px] font-semibold text-dim mb-1.5 uppercase tracking-widest">
        <%= t("dashboard.apps.box_size_label") %>
      </label>
      <input type="hidden" name="app_record[box_size]" id="box_size_input" value="<%= default_size %>">
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-1.5" id="box_size_picker">
        <% box_sizes.each do |size| %>
          <%
            quota   = plan.quota_for(size)
            tier_name = Plan::BOX_SIZE_TO_DYNO_TIER[size]
            tier    = tier_name ? DynoTier.find_by(name: tier_name) : nil
            capped  = quota == 0
            selected = size == default_size && !capped
          %>
          <button type="button"
                  data-box-size="<%= size %>"
                  <%= capped ? "disabled".html_safe : "".html_safe %>
                  onclick="document.getElementById('box_size_input').value='<%= size %>'; document.querySelectorAll('[data-box-size]').forEach(function(b){ b.classList.remove('border-accent','bg-accent-soft'); b.classList.add('border-ink'); }); this.classList.remove('border-ink'); this.classList.add('border-accent','bg-accent-soft');"
                  class="w-full text-left border-1.5 <%= selected ? 'border-accent bg-accent-soft' : 'border-ink hover:bg-bg-deep' %> px-2 py-1.5 transition font-mono <%= capped ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer' %>"
                  title="<%= tier ? "#{tier.memory_mb} MB · #{tier.cpu_shares} vCPU · #{capped ? 'not on your plan' : "up to #{quota} boxes"}" : '' %>">
            <div class="text-[11px] font-semibold text-ink uppercase"><%= size %></div>
            <div class="text-[10px] text-dim mt-0.5">
              <% if tier %><%= tier.memory_mb >= 1024 ? "#{tier.memory_mb/1024}G" : "#{tier.memory_mb}M" %><% end %>
              <% if capped %> · <span class="text-warn">upgrade</span><% end %>
            </div>
          </button>
        <% end %>
      </div>
      <p class="mt-1 font-mono text-[11px] text-dim">Resize anytime from the app's Resources page.</p>
    </div>

    <%#
      Bundle v2: Shared add-ons picker.
      Free plan sees Pg + Redis only. Paid plans see all 5 engines.
      Default: NONE checked (opt-in per spec).
    %>
    <%
      engine_labels = {
        "postgres"    => ["Postgres",    "Shared relational DB (SQL)"],
        "redis"       => ["Redis",       "Shared in-memory cache / queue"],
        "memcached"   => ["Memcached",   "Lightweight object caching"],
        "rabbitmq"    => ["RabbitMQ",    "Message broker for async jobs"],
        "meilisearch" => ["Meilisearch", "Full-text search engine"]
      }
      available_engines = plan.shared_engines_available
    %>
    <div>
      <label class="block font-mono text-[10px] font-semibold text-dim mb-1.5 uppercase tracking-widest">
        <%= t("dashboard.apps.shared_addons_label") %>
      </label>
      <%# Rails array param requires an empty hidden field so an unchecked result still sends [] %>
      <input type="hidden" name="app_record[enabled_shared_engines][]" value="">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
        <% available_engines.each do |engine| %>
          <% label_text, hint = engine_labels[engine] %>
          <label class="flex items-center gap-2 border-1.5 border-ink px-2.5 py-2 cursor-pointer hover:bg-bg-deep transition font-mono"
                 title="<%= hint %>">
            <input type="checkbox"
                   name="app_record[enabled_shared_engines][]"
                   value="<%= engine %>"
                   class="accent-accent">
            <span class="text-xs font-semibold text-ink uppercase"><%= label_text %></span>
          </label>
        <% end %>
      </div>
      <p class="mt-1 font-mono text-[11px] text-dim">All shared add-ons are free and included in your plan.</p>
    </div>

    <%#
      Bundle v2: Dedicated add-ons at creation (optional, paid plans only).
      Collapsible so free-plan users don't see irrelevant options.
    %>
    <% if plan.dedicated_pg_slots.to_i > 0 || plan.dedicated_redis_slots.to_i > 0 %>
      <details class="font-mono text-xs border-1.5 border-ink">
        <summary class="cursor-pointer px-3 py-2.5 text-dim hover:text-ink hover:bg-bg-deep select-none uppercase tracking-widest font-semibold text-[10px]">
          <%= t("dashboard.apps.dedicated_addons_label") %>
        </summary>
        <div class="px-3 pb-3 pt-2 space-y-3 border-t border-ink">
          <% if plan.dedicated_pg_slots.to_i > 0 %>
            <div>
              <label class="block font-mono text-[10px] font-medium text-dim mb-1.5 uppercase tracking-widest">Dedicated database</label>
              <div class="grid grid-cols-2 gap-1.5">
                <% [["none", "None"], ["postgres", "Postgres"], ["mysql", "MySQL"], ["mongodb", "MongoDB"]].each do |val, label| %>
                  <label class="flex items-center gap-2 border-1.5 border-ink px-2.5 py-1.5 cursor-pointer hover:bg-bg-deep transition">
                    <input type="radio"
                           name="app_record[dedicated_db_engine]"
                           value="<%= val %>"
                           <%= val == "none" ? "checked" : "" %>
                           class="accent-accent">
                    <span class="text-xs font-semibold text-ink uppercase"><%= label %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if plan.dedicated_redis_slots.to_i > 0 %>
            <label class="flex items-center gap-2 border-1.5 border-ink px-2.5 py-2 cursor-pointer hover:bg-bg-deep transition"
                   title="Isolated Redis instance — uses 1 of your <%= plan.dedicated_redis_slots %> slots">
              <input type="checkbox"
                     name="app_record[add_dedicated_redis]"
                     value="1"
                     class="accent-accent">
              <span class="text-xs font-semibold text-ink uppercase">Dedicated Redis</span>
              <span class="text-[10px] text-dim ml-auto">1 of <%= plan.dedicated_redis_slots %> slots</span>
            </label>
          <% end %>
        </div>
      </details>
    <% end %>

  <% end %>

  <%# Branch — collapsed under Advanced (most users want main) %>
  <details class="font-mono text-xs">
    <summary class="cursor-pointer text-dim hover:text-ink select-none">Advanced</summary>
    <div class="mt-3">
      <%= f.label :deploy_branch, "Deploy Branch", class: "block font-mono text-[10px] font-medium text-dim mb-1.5 uppercase tracking-widest" %>
      <%= f.text_field :deploy_branch, class: "w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent", placeholder: "main", value: app.deploy_branch || "main" %>
      <p class="mt-1 font-mono text-[11px] text-dim">Defaults to <code>main</code>. Change only if your repo deploys from a different branch.</p>
    </div>
  </details>

  <div class="flex items-center gap-2 pt-2">
    <%= f.submit "Create App", class: "flex-1 py-2.5 px-4 bg-ink text-bg font-mono text-sm font-semibold border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer text-center", data: { app_name_check_target: "submit" } %>
    <button type="button" data-action="click->slide-panel#close" class="py-2.5 px-4 font-mono text-sm text-ink border-1.5 border-ink bg-paper hover:bg-bg-deep transition-colors cursor-pointer">Cancel</button>
  </div>
<% end %>
