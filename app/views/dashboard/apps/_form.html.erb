<%# schdl (U3). app-name-check + combobox + slide-panel#close
    wiring preserved 1:1. Renders in the new-app slide-panel on the
    apps index. %>
<%= form_with(model: app, url: dashboard_apps_path, class: "space-y-4",
              data: { controller: "app-name-check" }) do |f| %>
  <% if app.errors.any? %>
    <div class="border border-danger bg-danger-soft rounded-md p-3">
      <ul class="text-xs text-danger space-y-1">
        <% app.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Name with live availability check %>
  <div>
    <%= f.label :name, class: "block text-xs font-semibold text-ink-soft mb-1" %>
    <%= f.text_field :name,
        class: "w-full bg-paper border border-dark-line rounded-md px-3 py-2 text-sm focus:shadow-brutal-sm",
        placeholder: "my-app",
        autocomplete: "off",
        pattern: "[a-z][a-z0-9\\-]*",
        title: "Lowercase letters, numbers, and hyphens",
        data: {
          app_name_check_target: "input",
          action: "input->app-name-check#check"
        } %>
    <p class="text-[11.5px] text-dim mt-1" data-app-name-check-target="status"></p>
    <div class="mt-1.5 hidden flex flex-wrap gap-1.5" data-app-name-check-target="suggestions"></div>
  </div>

  <%# Server picker — themed combobox (search-as-you-type) %>
  <div>
    <label class="block text-xs font-semibold text-ink-soft mb-1">Server</label>
    <%
      server_options = servers.map { |s| { value: s.id, label: s.name, description: s.host } }
      preset = servers.size == 1 ? servers.first.id : nil
    %>
    <%= combobox_tag "app_record[server_id]", server_options, value: preset, placeholder: "Search servers…", required: true %>
    <p class="text-[11.5px] text-dim mt-1">
      <%= servers.size %> <%= "server".pluralize(servers.size) %> available
    </p>
  </div>

  <%# Per-resource builder renders regardless of Bundle v2 (self-host has it off). %>
  <% if Wokku.config.resource_builder? %>
    <%
      # Per-resource billing (spec 2026-09-24 §5.3): defaults to Sleeping
      # when the team still has free-quota headroom (mirrors box_quota's
      # own allowed-used math), otherwise Starter. `rem` can be
      # Float::INFINITY (OSS/unlimited) — never call .to_i on it (raises
      # FloatDomainError); compare as a float instead. nil (box_quota
      # unset, e.g. a validation-failure re-render of :index) also
      # defaults to Sleeping.
      rem = (@box_quota || {}).dig("sleeping", :remaining)
      sleeping_default = rem.nil? || rem.to_f > 0
    %>
    <div>
      <label class="block text-xs font-semibold text-ink-soft mb-1">Resources</label>
      <%= render Organisms::ResourceBuilderComponent.new(
            name: "processes[web]",
            shape: Resources::Shape.new(**Resources::Shape::PRESETS["starter"]),
            presets: Resources::Shape::PRESETS,
            instances: nil,
            sleeping_option: true,
            sleeping: sleeping_default,
            rails_hint: true) %>
      <p class="text-[11.5px] text-dim mt-1"><%= t("sweep.resize_anytime") %></p>
    </div>
  <% end %>

  <% if Addons::SharedProvisioner.feature_enabled? %>
    <%#
      Bundle v2: Box size picker.
      Maps user-visible names to DynoTier via DynoTier::BOX_SIZE_TO_DYNO_TIER.
      Sizes with a plan quota of 0 are shown disabled.
    %>
    <%
      plan         = defined?(@plan) ? @plan : current_user.current_plan
      box_sizes    = %w[sleeping small medium large xlarge]
      # Per-size remaining-quota snapshot (allowed/used/remaining/provisionable),
      # built by PlanEnforceable#box_picker_state and shared with the create-time
      # quota check so the picker never offers a size that create rejects.
      box_quota    = @box_quota || {}
      default_size = box_sizes.find { |s| box_quota.dig(s, :provisionable) } || "sleeping"
    %>
    <% unless Wokku.config.resource_builder? %>
    <div data-controller="box-size">
      <label class="block text-xs font-semibold text-ink-soft mb-1">
        <%= t("dashboard.apps.box_size_label") %>
      </label>
      <input type="hidden" name="app_record[box_size]" id="box_size_input" value="<%= default_size %>" data-box-size-target="input">
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-1.5" id="box_size_picker">
        <% box_sizes.each do |size| %>
          <%
            q         = box_quota[size] || {}
            allowed   = q[:allowed].to_i
            used      = q[:used].to_i
            remaining = q.key?(:remaining) ? q[:remaining].to_i : allowed
            # `provisionable` honors create-time auto-upgrade: a full size is
            # still selectable when a larger granted size has room. Fall back to
            # the plan base quota only if the snapshot is missing.
            provision = q.fetch(:provisionable, plan.quota_for(size) > 0)
            tier_name = DynoTier::BOX_SIZE_TO_DYNO_TIER[size]
            tier      = tier_name ? DynoTier.find_by(name: tier_name) : nil
            capped    = !provision
            selected  = size == default_size && !capped
            usage_hint = if !capped && allowed.positive? then "#{used}/#{allowed} used"
                         elsif capped && allowed.positive?  then "all #{allowed} in use — resize or upgrade"
                         else "not on your plan"
                         end
          %>
          <button type="button"
                  data-box-size="<%= size %>"
                  <%= capped ? "disabled".html_safe : "".html_safe %>
                  data-action="box-size#select"
                  class="w-full text-left border rounded-md <%= selected ? 'border-line-strong bg-bg-deep' : 'border-line-strong hover:bg-bg-deep' %> px-2 py-1.5 transition <%= capped ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer' %>"
                  title="<%= tier ? "#{tier.memory_mb} MB · #{tier.cpu_shares} vCPU · " : "" %><%= usage_hint %>">
            <div class="text-[11px] font-semibold text-ink uppercase"><%= size %></div>
            <div class="text-[10px] text-dim mt-0.5">
              <% if tier %><%= tier.memory_mb >= 1024 ? "#{tier.memory_mb/1024}G" : "#{tier.memory_mb}M" %><% end %>
              <% if capped %> · <span class="text-warn"><%= allowed.positive? ? "full" : "upgrade" %></span>
              <% elsif allowed.positive? %> · <span class="text-dim"><%= remaining %> left</span><% end %>
            </div>
          </button>
        <% end %>
      </div>
      <p class="text-[11.5px] text-dim mt-1"><%= t("sweep.resize_anytime") %></p>
    </div>
    <% end %>

    <%#
      Bundle v2: Shared add-ons picker.
      Every plan sees every shared engine (all free).
      Default: NONE checked (opt-in per spec).
    %>
    <%
      engine_labels = {
        "postgres"    => ["Postgres",    "Shared relational DB (SQL)"],
        "mariadb"     => ["MariaDB",     "Shared relational DB (MySQL-compatible)"],
        "redis"       => ["Redis",       "Shared in-memory cache / queue"]
      }
      available_engines = plan.shared_engines_available
    %>
    <% if Addons::SharedProvisioner.feature_enabled? %><%# none in the open-source edition %>
    <div>
      <label class="block text-xs font-semibold text-ink-soft mb-1">
        <%= t("dashboard.apps.shared_addons_label") %>
      </label>
      <%# Rails array param requires an empty hidden field so an unchecked result still sends [] %>
      <input type="hidden" name="app_record[enabled_shared_engines][]" value="">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
        <% available_engines.each do |engine| %>
          <% label_text, hint = engine_labels[engine] %>
          <label class="flex items-center gap-2 border border-line rounded-md px-2.5 py-2 cursor-pointer hover:bg-bg-deep transition"
                 title="<%= hint %>">
            <input type="checkbox"
                   name="app_record[enabled_shared_engines][]"
                   value="<%= engine %>"
                   class="accent-accent">
            <span class="text-xs font-semibold text-ink"><%= label_text %></span>
          </label>
        <% end %>
      </div>
      <p class="text-[11.5px] text-dim mt-1">All shared add-ons are free and included in your plan.</p>
    </div>
    <% end %>

    <%#
      Bundle v2: Dedicated add-ons at creation (optional, paid plans only).
      Collapsible so free-plan users don't see irrelevant options.
    %>
    <% if plan.dedicated_pg_slots.to_i > 0 || plan.dedicated_redis_slots.to_i > 0 %>
      <details class="text-xs border border-line rounded-md">
        <summary class="cursor-pointer px-3 py-2.5 text-dim hover:text-ink hover:bg-bg-deep select-none font-semibold">
          <%= t("dashboard.apps.dedicated_addons_label") %>
        </summary>
        <div class="px-3 pb-3 pt-2 space-y-3 border-t border-line">
          <% if plan.dedicated_pg_slots.to_i > 0 %>
            <div>
              <label class="block text-xs font-semibold text-ink-soft mb-1">Dedicated database</label>
              <div class="grid grid-cols-2 gap-1.5">
                <% [["none", "None"], ["postgres", "Postgres"], ["mysql", "MySQL"], ["mongodb", "MongoDB"]].each do |val, label| %>
                  <label class="flex items-center gap-2 border border-line rounded-md px-2.5 py-1.5 cursor-pointer hover:bg-bg-deep transition">
                    <input type="radio"
                           name="app_record[dedicated_db_engine]"
                           value="<%= val %>"
                           <%= val == "none" ? "checked" : "" %>
                           class="accent-accent">
                    <span class="text-xs font-semibold text-ink"><%= label %></span>
                  </label>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if plan.dedicated_redis_slots.to_i > 0 %>
            <label class="flex items-center gap-2 border border-line rounded-md px-2.5 py-2 cursor-pointer hover:bg-bg-deep transition"
                   title="Isolated Redis instance — uses 1 of your <%= plan.dedicated_redis_slots %> slots">
              <input type="checkbox"
                     name="app_record[add_dedicated_redis]"
                     value="1"
                     class="accent-accent">
              <span class="text-xs font-semibold text-ink">Dedicated Redis</span>
              <span class="text-[10px] text-dim ml-auto">1 of <%= plan.dedicated_redis_slots %> slots</span>
            </label>
          <% end %>
        </div>
      </details>
    <% end %>

  <% end %>

  <%# Source: a public repo is how you deploy your own code where there is
      no git gateway (self-host) — or just a quick start anywhere. %>
  <div>
    <%= f.label :git_repository_url, t("sweep.git_repo_label"), class: "block text-xs font-semibold text-ink-soft mb-1" %>
    <%= f.text_field :git_repository_url, class: "w-full bg-paper border border-dark-line rounded-md px-3 py-2 text-sm focus:shadow-brutal-sm", placeholder: "https://github.com/you/your-app" %>
    <p class="text-[11.5px] text-dim mt-1">An https:// address of a public repo (GitHub, GitLab, Codeberg…). Wokku builds it right away. Leave empty to deploy later.</p>
  </div>

  <%# Branch — collapsed under Advanced (most users want main) %>
  <details class="text-xs">
    <summary class="cursor-pointer text-dim hover:text-ink select-none"><%= t("sweep.advanced") %></summary>
    <div class="mt-3">
      <%= f.label :deploy_branch, "Deploy Branch", class: "block text-xs font-semibold text-ink-soft mb-1" %>
      <%= f.text_field :deploy_branch, class: "w-full bg-paper border border-dark-line rounded-md px-3 py-2 text-sm focus:shadow-brutal-sm", placeholder: "main", value: app.deploy_branch || "main" %>
      <p class="text-[11.5px] text-dim mt-1">Defaults to <code>main</code>. Change only if your repo deploys from a different branch.</p>
    </div>
  </details>

  <div class="flex justify-end gap-2 pt-2">
    <%# Plain link: works both in the slide panel and on standalone /new. %>
    <%= link_to t("common.cancel"), dashboard_apps_path,
          data: { action: "slide-panel#close:prevent", turbo_frame: "_top" },
          class: Atoms::ButtonComponent.new(variant: :ghost).classes %>
    <%# raw button (not the ViewComponent) so app-name-check's `submit` Stimulus target
        attaches directly to the DOM node it disables/re-enables during the availability
        check — class recipe copied from ButtonComponent(:primary) for pixel parity. %>
    <%= f.submit t("sweep.create_app"),
        class: Atoms::ButtonComponent.new(variant: :primary).classes,
        data: { app_name_check_target: "submit" } %>
  </div>
<% end %>
