<% content_for(:title, "Admin · Analytics") %>

<%
  fmt = ->(idr) { "Rp #{ActiveSupport::NumberHelper.number_to_delimited((idr || 0).to_i, delimiter: '.')}" }
%>

<div class="space-y-6 max-w-6xl">
  <div>
    <h1 class="text-xl font-headline text-on-surface">Admin · Analytics</h1>
    <p class="mt-0.5 text-sm text-outline">Platform-wide metrics. Visible to admins only.</p>
  </div>

  <%# ── Revenue ── %>
  <section class="space-y-2">
    <h2 class="text-sm font-semibold text-on-surface">Revenue (real money in)</h2>
    <div class="grid grid-cols-4 gap-4">
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Today</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= fmt.call(@revenue[:today_idr]) %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Month-to-date</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= fmt.call(@revenue[:mtd_idr]) %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">All time</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= fmt.call(@revenue[:all_time_idr]) %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Unique payers</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @revenue[:unique_payers] %></p>
      </div>
    </div>
    <p class="text-xs text-outline">Excludes manual credits and promo bonus payouts — only iPaymu / Stripe deposits.</p>
  </section>

  <%# ── Users ── %>
  <section class="space-y-2">
    <h2 class="text-sm font-semibold text-on-surface">Users</h2>
    <div class="grid grid-cols-4 gap-4">
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Total</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @users[:total] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">New today</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @users[:new_today] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">New this week</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @users[:new_this_week] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">With balance &gt; 0</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @users[:with_balance] %></p>
      </div>
    </div>
  </section>

  <%# ── Apps ── %>
  <section class="space-y-2">
    <h2 class="text-sm font-semibold text-on-surface">Apps + servers</h2>
    <div class="grid grid-cols-4 gap-4">
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Total apps</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @apps[:total] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Running</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @apps[:running] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">New today</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @apps[:new_today] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Dokku servers</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @apps[:servers] %></p>
      </div>
    </div>
  </section>

  <%# ── Promo redemptions ── %>
  <section class="space-y-2">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-semibold text-on-surface">Promo redemptions</h2>
      <%= link_to "Manage codes →", dashboard_promo_codes_path, class: "text-xs text-primary hover:underline font-semibold" %>
    </div>
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Pending</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @promos[:pending] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Applied today</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @promos[:applied_today] %></p>
      </div>
      <div class="bg-surface-container-low rounded-md p-5">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold mb-2">Applied all time</p>
        <p class="text-2xl font-bold text-on-surface font-mono"><%= @promos[:applied_total] %></p>
      </div>
    </div>

    <div class="bg-surface-container-low rounded-xl border border-outline-variant/15 overflow-hidden mt-3">
      <div class="px-5 py-3 border-b border-outline-variant/15">
        <p class="text-[10px] uppercase tracking-widest text-outline font-bold">Top channel codes by redemptions</p>
      </div>
      <% if @promos[:top_codes].any? %>
        <table class="w-full text-sm">
          <thead class="text-[10px] uppercase tracking-wider text-outline">
            <tr><th class="text-left px-5 py-2">Code</th><th class="text-left">Kind</th><th class="text-right px-5">Redemptions</th><th class="text-right px-5">Bonus</th></tr>
          </thead>
          <tbody class="divide-y divide-outline-variant/10">
            <% @promos[:top_codes].each do |c| %>
              <tr>
                <td class="px-5 py-2 font-mono text-primary"><%= c.code %></td>
                <td><%= c.kind.titleize %></td>
                <td class="text-right px-5 font-mono"><%= c.redemptions_count %><%= c.max_redemptions ? "/#{c.max_redemptions}" : "" %></td>
                <td class="text-right px-5 font-mono"><%= fmt.call(c.redeemer_bonus_idr) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-5 py-6 text-sm text-outline text-center">No redeemable codes yet.</p>
      <% end %>
    </div>
  </section>
</div>
