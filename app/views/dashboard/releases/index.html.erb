<%#
  Releases (schdl grid rollout, U4 Task 3). Renders inside AppTabsComponent
  + AppDeployComponent's content slot — the sub-tab strip already gives
  context, so no R1 page header here, just a compact section heading.
  Controllers, forms, clipboard/rollback-confirm wiring and route helpers
  preserved 1:1 — presentation only.
%>
<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :deploy) do %>
  <%= render Organisms::AppDeployComponent.new(app: @app, active: :releases) do %>

<h2 class="text-base font-bold mb-3"><%= t("dashboard.releases.heading", default: "Releases") %></h2>

<%# Deploy method %>
<div class="border-1.5 border-ink bg-paper rounded-md mb-6 overflow-hidden">
  <div class="px-5 py-3.5 border-b border-line">
    <h3 class="text-sm font-bold text-ink">Deploy</h3>
    <p class="text-[11.5px] text-dim mt-0.5">Push code to your server to deploy.</p>
  </div>

  <div class="p-5 space-y-5">
    <%# Git Remote %>
    <div>
      <h4 class="text-xs font-semibold text-ink-soft mb-1">Git remote</h4>
      <p class="text-[11.5px] text-dim mb-2.5">Add the remote to your repository and push to deploy.</p>
      <%# Canonical remote via the wokku SSH gateway (git@git.wokku.cloud),
          named "wokku" — matches the API push_instructions, the profile
          page, and the CLI. The legacy dokku@<server-host> bypass still
          works but isn't shown (see AppRecord#direct_git_remote_url). %>
      <% git_remote = @app.git_remote_url %>
      <% branch = @app.deploy_branch || "main" %>
      <% if git_remote.nil? %>
        <p class="text-[11.5px] text-dim">Git push isn't set up on this install (no git gateway). Deploy from a repository or a template instead.</p>
      <% else %>
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <code class="flex-1 bg-bg border-1.5 border-ink rounded-md px-3 py-2 font-mono text-sm text-ink-soft overflow-x-auto">git remote add wokku <%= git_remote %></code>
          <button type="button" data-controller="clipboard" data-clipboard-text-value="git remote add wokku <%= git_remote %>" data-action="click->clipboard#copy" class="px-3 py-2 border-1.5 border-ink rounded-md bg-paper text-dim hover:text-ink transition-colors cursor-pointer" title="Copy">
            <span data-clipboard-target="label" class="text-xs">Copy</span>
          </button>
        </div>
        <div class="flex items-center gap-2">
          <code class="flex-1 bg-bg border-1.5 border-ink rounded-md px-3 py-2 font-mono text-sm text-ink-soft overflow-x-auto">git push wokku <%= branch %></code>
          <button type="button" data-controller="clipboard" data-clipboard-text-value="git push wokku <%= branch %>" data-action="click->clipboard#copy" class="px-3 py-2 border-1.5 border-ink rounded-md bg-paper text-dim hover:text-ink transition-colors cursor-pointer" title="Copy">
            <span data-clipboard-target="label" class="text-xs">Copy</span>
          </button>
        </div>
      </div>
      <% end %>
    </div>

    <div class="border-t border-line"></div>

    <%# GitHub Integration %>
    <div class="border-1.5 border-ink bg-bg-deep rounded-md p-4">
      <h4 class="text-xs font-semibold text-ink-soft mb-2">GitHub</h4>
      <% if @app.github_repo_full_name.present? %>
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div>
            <span class="text-sm font-semibold text-ink"><%= @app.github_repo_full_name %></span>
            <span class="text-xs text-dim ml-1">(<%= @app.deploy_branch %>)</span>
          </div>
          <%= button_to "Disconnect", dashboard_app_github_disconnect_path(@app), method: :delete, class: "text-xs text-danger hover:underline cursor-pointer bg-transparent border-0", data: { turbo_confirm: "Disconnect GitHub?" } %>
        </div>
        <p class="text-[11.5px] text-dim mt-1">Auto-deploys on push to <span class="text-ink"><%= @app.deploy_branch %></span></p>
      <% else %>
        <p class="text-[11.5px] text-dim mb-3">Connect a GitHub repository for automatic deploys on push.</p>
        <% if GithubApp.configured? %>
          <% if current_user.github_installation_id %>
            <%= render Atoms::ButtonComponent.new(variant: :outline, size: :sm, href: dashboard_app_github_repos_path(@app)) do %>Connect repository<% end %>
          <% else %>
            <%= render Atoms::ButtonComponent.new(variant: :outline, size: :sm, href: GithubApp.installation_url) do %>Install GitHub App<% end %>
          <% end %>
        <% else %>
          <span class="text-[11.5px] text-dim">GitHub App not configured. Set GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY env vars.</span>
        <% end %>
      <% end %>
    </div>

    <div class="border-t border-line"></div>

    <%# Manual Deploy %>
    <div>
      <h4 class="text-xs font-semibold text-ink-soft mb-1">Manual deploy</h4>
      <p class="text-[11.5px] text-dim mb-3">Trigger a rebuild of the current codebase on the server.</p>
      <%= button_to "Deploy now", deploy_dashboard_app_releases_path(@app), method: :post,
            data: { turbo_confirm: "Rebuild and deploy #{@app.name}?" },
            class: Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes %>
    </div>
  </div>
</div>

<%# Release history %>
<h3 class="text-sm font-bold text-ink mb-2">Release history</h3>

<% if @releases.any? %>
  <div class="bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-hidden">
    <table class="w-full text-[13.5px]">
      <thead>
        <tr class="bg-bg border-b-1.5 border-ink text-[10.5px] font-bold uppercase tracking-[.06em] text-dim text-left">
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.releases.columns.version", default: "Version") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.releases.columns.commit", default: "Commit") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.releases.columns.status", default: "Status") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.releases.columns.duration", default: "Duration") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.releases.columns.when", default: "When") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.releases.columns.actions", default: "Actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @releases.each do |release| %>
          <tr class="border-b border-line last:border-b-0 hover:bg-bg-deep transition-colors">
            <td class="px-3.5 py-2.5">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-ink">v<%= release.version %></span>
                <% if release.id == @current_release_id %>
                  <%= render Atoms::StatusPillComponent.new(label: "current", tone: :neutral) %>
                <% end %>
              </div>
              <div class="text-[12px] text-dim mt-0.5"><%= release.description || "Deploy" %></div>
            </td>
            <td class="px-3.5 py-2.5">
              <% if release.deploy&.commit_sha.present? %>
                <span class="font-mono text-[12px] text-dim"><%= release.deploy.commit_sha.first(7) %></span>
              <% else %>
                <span class="text-[12.5px] text-dim">—</span>
              <% end %>
            </td>
            <td class="px-3.5 py-2.5">
              <% if release.deploy %>
                <% case release.deploy.status %>
                <% when "succeeded" %>
                  <%= render Atoms::StatusPillComponent.new(label: "Succeeded", tone: :success) %>
                <% when "failed" %>
                  <%= render Atoms::StatusPillComponent.new(label: "Failed", tone: :danger) %>
                <% when "timed_out" %>
                  <%= render Atoms::StatusPillComponent.new(label: "Timed out", tone: :danger) %>
                <% when "building" %>
                  <%= render Atoms::StatusPillComponent.new(label: "Building", tone: :deploying) %>
                <% when "pending" %>
                  <%= render Atoms::StatusPillComponent.new(label: "Pending", tone: :deploying) %>
                <% end %>
              <% end %>
            </td>
            <td class="px-3.5 py-2.5 text-[12.5px] text-dim"><%= release.deploy&.duration ? "#{release.deploy.duration.round}s" : "—" %></td>
            <td class="px-3.5 py-2.5 text-[12.5px] text-dim"><%= time_ago(release.created_at) %></td>
            <td class="px-3.5 py-2.5 text-right">
              <%# Rollback button: only on succeeded releases that aren't already
                  the current one and whose deploy has a recorded commit SHA. %>
              <% if release.deploy&.status == "succeeded" &&
                   release.id != @current_release_id &&
                   release.deploy.commit_sha.present? %>
                <%= button_to "Rollback", rollback_dashboard_app_release_path(@app, release),
                      method: :post,
                      form: {
                        data: {
                          controller: "confirm-delete",
                          confirm_delete_name_value: @app.name,
                          confirm_delete_impact_value: "This will redeploy #{@app.name} at v#{release.version} (#{release.deploy.commit_sha.first(7)}). The current version will be replaced. You can roll forward again from this page.",
                          confirm_delete_resource_value: "app"
                        }
                      },
                      class: "text-xs text-warn hover:underline transition cursor-pointer bg-transparent border-0" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render Organisms::EmptyStateComponent.new(
        headline: "No releases yet.",
        body: "Push code via git or trigger a manual deploy to create your first release."
      ) %>
<% end %>

  <% end %>
<% end %>
