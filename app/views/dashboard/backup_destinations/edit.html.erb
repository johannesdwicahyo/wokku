<%#
  Brutalist backup-destination settings (P4 of redesign-c-full,
  2026-05-17). form_with + combobox + field params preserved 1:1
  from edit.OLD_DESIGN.html.erb.
%>
<% content_for(:title, "Backup Settings — #{@server.name}") %>

<%
  input  = "w-full bg-bg border border-line text-ink font-mono text-sm px-3 py-2 focus:outline-none focus:border-accent"
  label  = "block font-mono text-[10px] text-dim uppercase tracking-widest mb-1"
%>
<div class="max-w-2xl mx-auto space-y-6">
  <%= link_to admin_server_path(@server), class: "inline-flex items-center font-mono text-sm text-dim hover:text-accent transition" do %>
    ← Back to <%= @server.name %>
  <% end %>

  <div class="border border-line bg-paper p-6">
    <h1 class="font-mono text-lg font-semibold text-ink mb-1"># backup_destination</h1>
    <p class="font-mono text-sm text-dim mb-6">// S3-compatible storage for database backups. Supports AWS S3, Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces, and Wasabi.</p>

    <% if @destination.errors.any? %>
      <div role="alert" class="mb-4 border border-danger bg-danger/10 text-bad-text font-mono text-sm px-3 py-2">
        <% @destination.errors.full_messages.each do |m| %><p><%= m %></p><% end %>
      </div>
    <% end %>

    <%= form_with model: @destination, url: admin_server_backup_destination_path(@server), method: :patch, class: "space-y-4" do |f| %>
      <div>
        <label class="<%= label %>">Provider</label>
        <%= combobox_tag "backup_destination[provider]", BackupDestination::PROVIDERS.map { |k, v| [v[:name], k] }, value: @destination.provider, placeholder: "Select a provider" %>
      </div>

      <div>
        <%= f.label :endpoint_url, "Endpoint URL (leave blank for AWS S3)", class: label %>
        <%= f.text_field :endpoint_url, class: input, placeholder: "https://account-id.r2.cloudflarestorage.com" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :bucket, class: label %>
          <%= f.text_field :bucket, class: input, placeholder: "my-backups" %>
        </div>
        <div>
          <%= f.label :region, class: label %>
          <%= f.text_field :region, class: input, placeholder: "us-east-1" %>
        </div>
      </div>

      <div>
        <%= f.label :access_key_id, "Access Key ID", class: label %>
        <%= f.text_field :access_key_id, class: input %>
      </div>

      <div>
        <%= f.label :secret_access_key, "Secret Access Key", class: label %>
        <%= f.password_field :secret_access_key, class: input, placeholder: @destination.persisted? ? "••••••••" : "" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :path_prefix, "Path Prefix", class: label %>
          <%= f.text_field :path_prefix, class: input, placeholder: "wokku-backups" %>
        </div>
        <div>
          <%= f.label :retention_days, "Keep Backups (days)", class: label %>
          <%= f.number_field :retention_days, class: input, min: 1, max: 365 %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :enabled, class: "border border-line text-accent focus:ring-accent" %>
        <%= f.label :enabled, "Enable automatic daily backups", class: "font-mono text-sm text-ink" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save Backup Settings", class: "#{Atoms::ButtonComponent.new(variant: :primary).classes}" %>
        <%= link_to t("common.cancel"), admin_server_path(@server), class: "font-mono text-sm text-dim hover:text-ink transition" %>
      </div>
    <% end %>
  </div>
</div>
