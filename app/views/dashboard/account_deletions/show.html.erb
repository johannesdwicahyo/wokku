<%#
  schdl (U5 Task 7). account-deletion Stimulus controller (email-gate:
  target input/submit, action check), form_with url/method, and the
  confirmation_email param name preserved 1:1 — presentation only.
  The bespoke type-your-email confirm form is wrapped in
  Molecules::DangerZoneComponent (T1) chrome (Locked #2/#3b): this page
  IS the real destination profile#show and profile#edit's Danger Zones
  now link to.
%>
<% content_for :title, "Delete account" %>

<%= render Organisms::SettingsTabsComponent.new(active_tab: :account, show_admin: current_user&.admin?) do %>
<div class="max-w-xl">
  <div class="mb-6">
    <h2 class="font-headline text-base font-bold text-ink"><%= t("dashboard.account_deletions.show_title", default: "Delete Your Account") %></h2>
  </div>

  <%# Warning banner %>
  <div class="border-1.5 border-danger bg-danger-soft rounded-md p-5 mb-6">
    <p class="font-bold text-danger mb-1">
      <%= t("dashboard.account_deletions.warning_heading", default: "This action is irreversible after 3 days.") %>
    </p>
    <p class="text-sm text-ink-soft">
      <%= t("dashboard.account_deletions.warning_body",
            default: "All apps will be stopped immediately. Apps, databases, and all your data will be permanently deleted within 3 days. Your unused balance will be forfeit. This cannot be reversed after the grace period.") %>
    </p>
  </div>

  <%# Apps list %>
  <div class="border-1.5 border-ink bg-paper rounded-md p-5 mb-4">
    <p class="text-sm font-bold text-ink mb-3">
      <%= t("dashboard.account_deletions.apps_header", count: @apps.count, default: "Apps that will be deleted (#{@apps.count}):") %>
    </p>
    <% if @apps.any? %>
      <ul class="space-y-1">
        <% @apps.each do |app| %>
          <li class="text-sm text-ink-soft flex items-center gap-2"><span class="text-dim">▸</span><%= app.name %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-dim italic"><%= t("dashboard.account_deletions.no_apps", default: "No apps.") %></p>
    <% end %>
  </div>

  <%# Databases list %>
  <div class="border-1.5 border-ink bg-paper rounded-md p-5 mb-4">
    <p class="text-sm font-bold text-ink mb-3">
      <%= t("dashboard.account_deletions.databases_header", count: @databases.count, default: "Databases that will be deleted (#{@databases.count}):") %>
    </p>
    <% if @databases.any? %>
      <div class="border-1.5 border-warn bg-warn-soft rounded-md p-3 mb-3 flex items-center gap-2">
        <span class="text-sm text-ink">
          <%= t("dashboard.account_deletions.backup_callout", default: "Back up any important data first.") %>
          <%= link_to t("dashboard.account_deletions.backup_link", default: "Open backups"),
                      dashboard_addons_path,
                      class: "underline font-medium text-accent" %>
        </span>
      </div>
      <ul class="space-y-1">
        <% @databases.each do |db| %>
          <li class="text-sm text-ink-soft flex items-center gap-2"><span class="text-dim">▸</span><%= db.name %> <span class="text-dim text-xs">(<%= db.service_type %>)</span></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-dim italic"><%= t("dashboard.account_deletions.no_databases", default: "No databases.") %></p>
    <% end %>
  </div>

  <%# Balance forfeit %>
  <% if @has_balance %>
    <div class="border-1.5 border-ink bg-paper rounded-md p-5 mb-6">
      <p class="text-sm font-bold text-ink mb-1">
        <%= t("dashboard.account_deletions.balance_label", default: "Balance that will be forfeit:") %>
      </p>
      <p class="text-danger font-bold text-lg"><%= @balance %></p>
    </div>
  <% end %>

  <%# Confirmation — bespoke type-your-email controller, wrapped in DangerZone chrome %>
  <%= render Molecules::DangerZoneComponent.new(
        title: t("dashboard.profile.danger_zone"),
        body: t("dashboard.account_deletions.danger_zone_description")
      ) do %>
    <%= form_with url: dashboard_account_deletion_path, method: :post,
          data: { controller: "account-deletion",
                  "account-deletion-email-value": current_user.email } do |f| %>

      <div class="mb-4">
        <%= label_tag :confirmation_email,
              t("dashboard.account_deletions.confirm_label", default: "Type your email to confirm:"),
              class: "block text-xs font-semibold text-ink-soft mb-1" %>
        <%= text_field_tag :confirmation_email, nil,
              placeholder: current_user.email,
              autocomplete: "off",
              class: "w-full bg-paper border-1.5 border-ink rounded-md text-ink text-sm px-3 py-2 focus:outline-none focus:shadow-brutal-sm",
              data: {
                "account-deletion-target": "input",
                action: "input->account-deletion#check"
              } %>
      </div>

      <div class="flex items-center gap-4 pt-2">
        <button type="submit"
                disabled
                data-account-deletion-target="submit"
                class="<%= Atoms::ButtonComponent.new(variant: :danger, size: :md, class: "disabled:opacity-40 disabled:cursor-not-allowed").classes %>">
          <%= t("dashboard.account_deletions.submit_button", default: "Permanently delete my account") %>
        </button>
        <%= link_to t("dashboard.account_deletions.cancel_link", default: "Cancel"),
                    dashboard_profile_path,
                    class: "text-sm text-dim hover:text-ink transition" %>
      </div>
    <% end %>
  <% end %>
</div>
<% end %>
