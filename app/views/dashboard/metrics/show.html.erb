<%#
  Brutalist metrics (P3c of redesign-c-full, 2026-05-17). All Ruby
  computation blocks, line_chart calls and routes preserved 1:1 from
  show.OLD_DESIGN.html.erb — only presentation repainted (chart
  colours swapped to the brutalist accent palette).
%>
<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :runtime) do %>
<%= render Organisms::AppRuntimeComponent.new(app: @app, active: :metrics) do %>
<%# Processes %>
<div class="border-1.5 border-ink bg-paper mb-6">
  <div class="px-6 py-4 border-b border-rule-soft flex items-center justify-between gap-3 flex-wrap">
    <div>
      <h2 class="font-mono text-base font-semibold text-ink"># processes</h2>
      <p class="font-mono text-xs text-dim mt-1">// running containers for <span class="text-ink"><%= @app.name %></span></p>
    </div>
    <a href="<%= dashboard_app_metrics_path(@app) %>" data-turbo-action="replace" class="inline-flex items-center px-2.5 py-1 font-mono text-xs text-dim border-1.5 border-ink bg-paper hover:text-accent transition-colors cursor-pointer">↻ refresh</a>
  </div>

  <% if @processes.any? %>
    <div class="divide-y divide-rule-soft">
      <% @processes.each do |proc| %>
        <div class="px-6 py-4 flex items-center justify-between gap-3 flex-wrap hover:bg-bg-deep transition-colors font-mono">
          <div class="min-w-0">
            <span class="text-sm font-semibold text-ink"><%= proc[:type] %>.<%= proc[:index] %></span>
            <div class="text-xs text-dim mt-0.5">cid: <%= proc[:container_id] %></div>
          </div>
          <div class="flex items-center gap-2">
            <% if proc[:status] == "running" %>
              <span class="w-1.5 h-1.5 bg-success"></span><span class="text-xs text-success">running</span>
            <% else %>
              <span class="w-1.5 h-1.5 bg-danger"></span><span class="text-xs text-danger"><%= proc[:status].capitalize %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-6 py-8 text-center font-mono text-sm text-dim">// no running processes</div>
  <% end %>
</div>

<%# Live Container Stats %>
<% if @container_stats.any? %>
  <%# Summary Cards %>
  <%
    total_cpu = @container_stats.sum { |s| s[:cpu_percent] }
    # Calculate total memory usage in MB from each container's mem_usage string
    total_mem_mb = @container_stats.sum { |s|
      usage_str = s[:mem_usage].split("/").first.strip
      if usage_str.include?("GiB")
        usage_str.to_f * 1024
      else
        usage_str.to_f
      end
    }
    # Read the per-container memory limit from docker's own report
    # (usage string is "128MiB / 512MiB"); no extra SSH round-trip needed.
    per_container_limit = begin
      first_limit = @container_stats.first&.dig(:mem_usage)&.split("/")&.last&.strip
      if first_limit.nil?
        nil
      elsif first_limit.include?("GiB")
        (first_limit.to_f * 1024).round
      elsif first_limit.include?("MiB")
        first_limit.to_f.round
      end
    end
    total_limit_mb = per_container_limit ? per_container_limit * @container_stats.size : nil
    mem_percent = total_limit_mb ? (total_mem_mb / total_limit_mb * 100).round(1) : total_mem_percent = @container_stats.sum { |s| s[:mem_percent] }
  %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6">
    <div class="border-1.5 border-ink bg-paper p-5">
      <p class="font-mono text-[10px] text-dim uppercase tracking-widest mb-2">total_cpu</p>
      <div class="font-mono text-3xl font-semibold text-ink tracking-tighter"><%= "%.2f" % total_cpu %> <span class="text-dim text-base">%</span></div>
      <div class="mt-3 h-2 bg-bg border border-rule-soft relative">
        <div class="absolute inset-0 bg-accent" style="width: <%= [total_cpu, 100].min %>%"></div>
      </div>
    </div>
    <div class="border-1.5 border-ink bg-paper p-5">
      <p class="font-mono text-[10px] text-dim uppercase tracking-widest mb-2">memory_usage</p>
      <div class="font-mono text-3xl font-semibold text-ink tracking-tighter">
        <%= "%.0f" % total_mem_mb %> <span class="text-dim text-base">MB<% if total_limit_mb %> / <%= total_limit_mb >= 1024 ? "#{(total_limit_mb / 1024.0).round(1)} GB" : "#{total_limit_mb} MB" %><% end %></span>
      </div>
      <% if total_limit_mb %>
        <div class="mt-3 h-2 bg-bg border border-rule-soft relative">
          <div class="absolute inset-0 <%= mem_percent > 80 ? 'bg-danger' : mem_percent > 60 ? 'bg-warn' : 'bg-accent' %>" style="width: <%= [mem_percent, 100].min %>%"></div>
        </div>
      <% end %>
    </div>
    <div class="border-1.5 border-ink bg-paper p-5">
      <p class="font-mono text-[10px] text-dim uppercase tracking-widest mb-2">containers</p>
      <span class="font-mono text-3xl font-semibold text-ink tracking-tighter"><%= @container_stats.size %></span>
      <p class="font-mono text-xs text-dim mt-2"><%= @container_stats.size %> running<%= per_container_limit ? " · #{per_container_limit} MB each" : "" %></p>
    </div>
  </div>

  <%# Per-Container Detail %>
  <div class="border-1.5 border-ink bg-paper mb-6 overflow-x-auto">
    <div class="px-6 py-4 border-b border-rule-soft">
      <h2 class="font-mono text-base font-semibold text-ink"># container_resources</h2>
      <p class="font-mono text-xs text-dim mt-1">// live resource usage per container</p>
    </div>
    <table class="min-w-full font-mono">
      <thead>
        <tr class="border-b border-rule-soft text-[10px] text-dim uppercase tracking-widest">
          <th class="px-6 py-3 text-left font-semibold">Container</th>
          <th class="px-6 py-3 text-left font-semibold">CPU</th>
          <th class="px-6 py-3 text-left font-semibold">Memory</th>
          <th class="px-6 py-3 text-left font-semibold">Net I/O</th>
          <th class="px-6 py-3 text-left font-semibold">Block I/O</th>
          <th class="px-6 py-3 text-left font-semibold">PIDs</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-rule-soft">
        <% @container_stats.each do |stat| %>
          <tr class="hover:bg-bg-deep transition-colors">
            <td class="px-6 py-3">
              <span class="text-sm text-ink"><%= stat[:name] %></span>
            </td>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <div class="w-16 h-1.5 bg-bg border border-rule-soft relative">
                  <div class="absolute inset-0 bg-accent" style="width: <%= [stat[:cpu_percent], 100].min %>%"></div>
                </div>
                <span class="text-sm text-ink-soft"><%= "%.2f" % stat[:cpu_percent] %>%</span>
              </div>
            </td>
            <td class="px-6 py-3">
              <%
                container_mem_str = stat[:mem_usage].split("/").first.strip
                container_mem_mb = container_mem_str.include?("GiB") ? (container_mem_str.to_f * 1024).round(0) : container_mem_str.to_f.round(0)
                container_mem_pct = per_container_limit ? (container_mem_mb.to_f / per_container_limit * 100).round(1) : stat[:mem_percent]
              %>
              <div class="flex items-center gap-2">
                <div class="w-16 h-1.5 bg-bg border border-rule-soft relative">
                  <div class="absolute inset-0 <%= container_mem_pct > 80 ? 'bg-danger' : container_mem_pct > 60 ? 'bg-warn' : 'bg-accent' %>" style="width: <%= [container_mem_pct, 100].min %>%"></div>
                </div>
                <span class="text-sm text-ink-soft"><%= container_mem_mb %> MB<%= per_container_limit ? " / #{per_container_limit} MB" : "" %></span>
              </div>
            </td>
            <td class="px-6 py-3 text-sm text-ink-soft"><%= stat[:net_io] %></td>
            <td class="px-6 py-3 text-sm text-ink-soft"><%= stat[:block_io] %></td>
            <td class="px-6 py-3 text-sm text-ink-soft"><%= stat[:pids] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="border-1.5 border-ink bg-paper p-6 mb-6 text-center">
    <p class="font-mono text-sm text-ink-soft">// unable to fetch container metrics</p>
    <p class="font-mono text-xs text-dim mt-1">Ensure root SSH access is available on the server.</p>
  </div>
<% end %>

<%# Historical Charts (24h) %>
<% if @metrics.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
    <div class="border-1.5 border-ink bg-paper p-6">
      <h3 class="font-mono text-[10px] text-dim uppercase tracking-widest mb-4">cpu_usage · 24h</h3>
      <%= line_chart @metrics.map { |m| [m.recorded_at, m.cpu_percent] },
                     colors: ["#6C4CFF"],
                     library: {
                       scales: { y: { min: 0, max: 100, grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } },
                                 x: { grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } } },
                       plugins: { legend: { display: false } },
                       elements: { point: { radius: 0 }, line: { tension: 0.3 } }
                     } %>
    </div>
    <div class="border-1.5 border-ink bg-paper p-6">
      <h3 class="font-mono text-[10px] text-dim uppercase tracking-widest mb-4">memory_usage · 24h</h3>
      <%= line_chart @metrics.map { |m| [m.recorded_at, (m.memory_usage.to_f / 1024 / 1024).round(1)] },
                     colors: ["#9A82FF"],
                     library: {
                       scales: { y: { min: 0, grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } },
                                 x: { grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } } },
                       plugins: { legend: { display: false } },
                       elements: { point: { radius: 0 }, line: { tension: 0.3 } }
                     } %>
    </div>
  </div>
<% else %>
  <div class="mt-6 border-1.5 border-ink bg-paper p-6 text-center">
    <p class="font-mono text-xs text-dim">// no historical data yet — metrics are collected every 5 minutes</p>
  </div>
<% end %>
<% end %>
<% end %>
