<%#
  schdl metrics (U5 Task 4). All Ruby computation blocks, line_chart
  calls, and routes preserved 1:1 — presentation only. Chart chrome
  (card wrapper, headings) restyled; the Chart.js dataset colours, grid,
  and tick options are data-viz internals and are left untouched.
%>
<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :performance) do %>
<%= render Organisms::PerformanceTabsComponent.new(app: @app, active: :metrics) do %>
<%# Live stats (processes + container stats) — deferred via lazy turbo-frame %>
<%= deferred_section "metrics_live", src: dashboard_app_metrics_path(@app, deferred: 1), skeleton: :tiles, target: "_top" %>

<%# Historical Charts (24h) %>
<% if @metrics.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
    <%# Charts render via the lazy metrics-chart controller (Chart.js loads
        on connect, only here — not on every page). Options are passed
        through to chartkick exactly as the old line_chart helper did. %>
    <% cpu_opts = {
         colors: [ "#6C4CFF" ],
         library: {
           scales: { y: { min: 0, max: 100, grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } },
                     x: { grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } } },
           plugins: { legend: { display: false } },
           elements: { point: { radius: 0 }, line: { tension: 0.3 } }
         }
       } %>
    <div class="bg-paper border-1.5 border-ink rounded-md p-6">
      <h3 class="text-[10px] text-dim uppercase tracking-widest font-bold mb-4">CPU usage · 24h</h3>
      <div data-controller="metrics-chart"
           data-metrics-chart-points-value="<%= @metrics.map { |m| [ m.recorded_at, m.cpu_percent ] }.to_json %>"
           data-metrics-chart-options-value="<%= cpu_opts.to_json %>"
           style="height: 300px;"></div>
    </div>
    <% mem_opts = {
         colors: [ "#9A82FF" ],
         library: {
           scales: { y: { min: 0, grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } },
                     x: { grid: { color: "rgba(11,11,14,0.10)" }, ticks: { color: "#8A8A90" } } },
           plugins: { legend: { display: false } },
           elements: { point: { radius: 0 }, line: { tension: 0.3 } }
         }
       } %>
    <div class="bg-paper border-1.5 border-ink rounded-md p-6">
      <h3 class="text-[10px] text-dim uppercase tracking-widest font-bold mb-4">Memory usage · 24h</h3>
      <div data-controller="metrics-chart"
           data-metrics-chart-points-value="<%= @metrics.map { |m| [ m.recorded_at, (m.memory_usage.to_f / 1024 / 1024).round(1) ] }.to_json %>"
           data-metrics-chart-options-value="<%= mem_opts.to_json %>"
           style="height: 300px;"></div>
    </div>
  </div>
<% else %>
  <div class="mt-6 bg-paper border-1.5 border-ink rounded-md p-6 text-center">
    <p class="text-xs text-dim">No historical data yet — metrics are collected every 5 minutes.</p>
  </div>
<% end %>
<% end %>
<% end %>
