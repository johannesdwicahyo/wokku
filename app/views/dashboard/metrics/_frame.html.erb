<%= turbo_frame_tag "metrics_live", target: "_top" do %>
<%# Processes %>
<div class="bg-paper border border-line rounded-md mb-6 overflow-hidden">
  <div class="px-6 py-4 border-b border-line flex items-center justify-between gap-3 flex-wrap">
    <div>
      <h2 class="font-headline text-base font-bold text-ink">Processes</h2>
      <p class="text-xs text-dim mt-1">Running containers for <span class="text-ink font-medium"><%= @app.name %></span></p>
    </div>
    <a href="<%= dashboard_app_metrics_path(@app) %>" data-turbo-action="replace" class="<%= Atoms::ButtonComponent.new(variant: :outline, size: :sm).classes %>">↻ Refresh</a>
  </div>

  <% if @processes.any? %>
    <div class="divide-y divide-line">
      <% @processes.each do |proc| %>
        <div class="px-6 py-4 flex items-center justify-between gap-3 flex-wrap hover:bg-bg-deep transition-colors">
          <div class="min-w-0">
            <span class="text-sm font-semibold text-ink font-mono"><%= proc[:type] %>.<%= proc[:index] %></span>
            <div class="text-xs text-dim mt-0.5 font-mono">cid: <%= proc[:container_id] %></div>
          </div>
          <div class="flex items-center gap-2">
            <% if proc[:status] == "running" %>
              <%= render Atoms::StatusPillComponent.new(status: "running") %>
            <% else %>
              <%= render Atoms::StatusPillComponent.new(label: proc[:status].capitalize, tone: :danger) %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-6 py-8 text-center text-sm text-dim">No running processes.</div>
  <% end %>
</div>

<%# Live Container Stats %>
<% if @container_stats.any? %>
  <%# Summary Cards %>
  <%
    total_cpu = @container_stats.sum { |s| s[:cpu_percent] }
    # Calculate total memory usage in MB from each container's mem_usage string
    total_mem_mb = @container_stats.sum { |s|
      usage_str = s[:mem_usage].split("/").first.strip
      if usage_str.include?("GiB")
        usage_str.to_f * 1024
      else
        usage_str.to_f
      end
    }
    # Read the per-container memory limit from docker's own report
    # (usage string is "128MiB / 512MiB"); no extra SSH round-trip needed.
    per_container_limit = begin
      first_limit = @container_stats.first&.dig(:mem_usage)&.split("/")&.last&.strip
      if first_limit.nil?
        nil
      elsif first_limit.include?("GiB")
        (first_limit.to_f * 1024).round
      elsif first_limit.include?("MiB")
        first_limit.to_f.round
      end
    end
    total_limit_mb = per_container_limit ? per_container_limit * @container_stats.size : nil
    mem_percent = total_limit_mb ? (total_mem_mb / total_limit_mb * 100).round(1) : total_mem_percent = @container_stats.sum { |s| s[:mem_percent] }
  %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6 min-w-0">
    <div class="bg-paper border border-line rounded-md p-5 min-w-0 overflow-hidden">
      <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-2">Total CPU</p>
      <div class="text-3xl font-semibold text-ink tracking-tighter tabular-nums"><%= "%.2f" % total_cpu %> <span class="text-dim text-base">%</span></div>
      <div class="mt-3 h-2 bg-bg border border-line rounded-full relative overflow-hidden">
        <div class="absolute inset-0 bg-accent" style="width: <%= [total_cpu, 100].min %>%"></div>
      </div>
    </div>
    <div class="bg-paper border border-line rounded-md p-5 min-w-0 overflow-hidden">
      <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-2">Memory usage</p>
      <div class="text-3xl font-semibold text-ink tracking-tighter tabular-nums">
        <%= "%.0f" % total_mem_mb %> <span class="text-dim text-base">MB<% if total_limit_mb %> / <%= total_limit_mb >= 1024 ? "#{(total_limit_mb / 1024.0).round(1)} GB" : "#{total_limit_mb} MB" %><% end %></span>
      </div>
      <% if total_limit_mb %>
        <div class="mt-3 h-2 bg-bg border border-line rounded-full relative overflow-hidden">
          <div class="absolute inset-0 <%= mem_percent > 80 ? 'bg-danger' : mem_percent > 60 ? 'bg-warn' : 'bg-accent' %>" style="width: <%= [mem_percent, 100].min %>%"></div>
        </div>
      <% end %>
    </div>
    <div class="bg-paper border border-line rounded-md p-5 min-w-0 overflow-hidden">
      <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-2">Containers</p>
      <span class="text-3xl font-semibold text-ink tracking-tighter tabular-nums"><%= @container_stats.size %></span>
      <p class="text-xs text-dim mt-2 break-words"><%= @container_stats.size %> running<%= per_container_limit ? " · #{per_container_limit} MB each" : "" %></p>
    </div>
  </div>

  <%# Per-Container Detail %>
  <div class="bg-paper border border-line rounded-md mb-6 overflow-x-auto">
    <div class="px-6 py-4 border-b border-line">
      <h2 class="font-headline text-base font-bold text-ink">Container resources</h2>
      <p class="text-xs text-dim mt-1">Live resource usage per container</p>
    </div>
    <table class="min-w-full">
      <thead>
        <tr class="border-b border-line text-[10px] text-dim uppercase tracking-widest">
          <th class="px-6 py-3 text-left font-semibold">Container</th>
          <th class="px-6 py-3 text-left font-semibold">CPU</th>
          <th class="px-6 py-3 text-left font-semibold">Memory</th>
          <th class="px-6 py-3 text-left font-semibold">Net I/O</th>
          <th class="px-6 py-3 text-left font-semibold">Block I/O</th>
          <th class="px-6 py-3 text-left font-semibold">PIDs</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% @container_stats.each do |stat| %>
          <tr class="hover:bg-bg-deep transition-colors">
            <td class="px-6 py-3">
              <span class="text-sm text-ink font-mono"><%= stat[:name] %></span>
            </td>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <div class="w-16 h-1.5 bg-bg border border-line rounded-full relative overflow-hidden">
                  <div class="absolute inset-0 bg-accent" style="width: <%= [stat[:cpu_percent], 100].min %>%"></div>
                </div>
                <span class="text-sm text-ink-soft tabular-nums"><%= "%.2f" % stat[:cpu_percent] %>%</span>
              </div>
            </td>
            <td class="px-6 py-3">
              <%
                container_mem_str = stat[:mem_usage].split("/").first.strip
                container_mem_mb = container_mem_str.include?("GiB") ? (container_mem_str.to_f * 1024).round(0) : container_mem_str.to_f.round(0)
                container_mem_pct = per_container_limit ? (container_mem_mb.to_f / per_container_limit * 100).round(1) : stat[:mem_percent]
              %>
              <div class="flex items-center gap-2">
                <div class="w-16 h-1.5 bg-bg border border-line rounded-full relative overflow-hidden">
                  <div class="absolute inset-0 <%= container_mem_pct > 80 ? 'bg-danger' : container_mem_pct > 60 ? 'bg-warn' : 'bg-accent' %>" style="width: <%= [container_mem_pct, 100].min %>%"></div>
                </div>
                <span class="text-sm text-ink-soft tabular-nums"><%= container_mem_mb %> MB<%= per_container_limit ? " / #{per_container_limit} MB" : "" %></span>
              </div>
            </td>
            <td class="px-6 py-3 text-sm text-ink-soft tabular-nums"><%= stat[:net_io] %></td>
            <td class="px-6 py-3 text-sm text-ink-soft tabular-nums"><%= stat[:block_io] %></td>
            <td class="px-6 py-3 text-sm text-ink-soft tabular-nums"><%= stat[:pids] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-paper border border-line rounded-md p-6 mb-6 text-center">
    <p class="text-sm text-ink-soft">Unable to fetch container metrics.</p>
    <p class="text-xs text-dim mt-1">Ensure root SSH access is available on the server.</p>
  </div>
<% end %>
<% end %>
