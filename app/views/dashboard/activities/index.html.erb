<%#
  Activity log (schdl grid rollout, U4 Task 4). Real data + filters +
  cursor pagination + CSV export + tamper-digest banner preserved 1:1
  from the brutalist version — presentation only.
%>
<% content_for(:title, "Activity log") %>

<%
  channel_labels = {
    "app" => "Dashboard", "api" => "API", "cli" => "CLI",
    "mcp" => "MCP", "git_push" => "git push", "webhook" => "Webhook"
  }
%>

<div class="space-y-6">
  <div class="flex items-center justify-between mb-5">
    <h1 class="font-headline text-2xl font-extrabold tracking-tight">Activity log</h1>
    <%= render Atoms::ButtonComponent.new(variant: :outline, size: :sm,
          href: dashboard_activities_path(@filters.to_h.merge(format: :csv))) do %>Export CSV<% end %>
  </div>

  <%# ── Tamper-evidence banner — surfaces ActivityDigest chain hash ── %>
  <% if @latest_digest %>
    <div class="border-1.5 border-ink bg-bg rounded-md px-5 py-3 flex flex-wrap items-center gap-3">
      <%= render Atoms::TagComponent.new(tone: :success) do %>verified<% end %>
      <span class="text-[12.5px] text-ink">chain hash verified through <%= @latest_digest.date.iso8601 %></span>
      <span class="text-[12.5px] text-dim">· <%= @latest_digest.row_count %> rows · hash <span class="font-mono"><%= @latest_digest.chain_hash[0, 16] %>…</span></span>
    </div>
  <% else %>
    <div class="border-1.5 border-line bg-paper rounded-md px-5 py-3">
      <span class="text-[12.5px] text-dim">digest chain not yet built — ActivityDigestJob runs nightly</span>
    </div>
  <% end %>

  <%# ── Filter bar ───────────────────────────────────────────────── %>
  <%= form_with url: dashboard_activities_path, method: :get, local: true,
                class: "border-1.5 border-ink bg-paper rounded-md px-5 py-4 grid grid-cols-2 lg:grid-cols-5 gap-3" do %>
    <label class="flex flex-col gap-1">
      <span class="block text-xs font-semibold text-ink-soft">Action</span>
      <select name="action_eq" class="w-full bg-paper border-1.5 border-ink rounded-md px-2.5 py-1.5 text-sm focus:shadow-brutal-sm">
        <option value="">Any</option>
        <% @actions.each do |a| %>
          <option value="<%= a %>" <%= "selected" if @filters[:action_eq] == a %>><%= a %></option>
        <% end %>
      </select>
    </label>
    <label class="flex flex-col gap-1">
      <span class="block text-xs font-semibold text-ink-soft">Channel</span>
      <select name="channel" class="w-full bg-paper border-1.5 border-ink rounded-md px-2.5 py-1.5 text-sm focus:shadow-brutal-sm">
        <option value="">Any</option>
        <% @channels.each do |c| %>
          <option value="<%= c %>" <%= "selected" if @filters[:channel] == c %>><%= channel_labels[c] || c %></option>
        <% end %>
      </select>
    </label>
    <label class="flex flex-col gap-1">
      <span class="block text-xs font-semibold text-ink-soft">User</span>
      <select name="user_id" class="w-full bg-paper border-1.5 border-ink rounded-md px-2.5 py-1.5 text-sm focus:shadow-brutal-sm">
        <option value="">Any</option>
        <% @team_users.each do |id, email| %>
          <option value="<%= id %>" <%= "selected" if @filters[:user_id] == id %>><%= email %></option>
        <% end %>
      </select>
    </label>
    <label class="flex flex-col gap-1">
      <span class="block text-xs font-semibold text-ink-soft">Since</span>
      <input type="date" name="since" value="<%= @filters[:since] %>" class="w-full bg-paper border-1.5 border-ink rounded-md px-2.5 py-1.5 text-sm focus:shadow-brutal-sm">
    </label>
    <label class="flex flex-col gap-1">
      <span class="block text-xs font-semibold text-ink-soft">Until</span>
      <input type="date" name="until" value="<%= @filters[:until] %>" class="w-full bg-paper border-1.5 border-ink rounded-md px-2.5 py-1.5 text-sm focus:shadow-brutal-sm">
    </label>
    <div class="col-span-2 lg:col-span-5 flex justify-end gap-2 pt-1">
      <%= render Atoms::ButtonComponent.new(variant: :ghost, size: :sm, href: dashboard_activities_path) do %>Reset<% end %>
      <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, type: "submit") do %>Apply<% end %>
    </div>
  <% end %>

  <%# ── Activity list ───────────────────────────────────────────── %>
  <% if @activities.any? %>
    <div class="bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-hidden">
      <div class="divide-y divide-line">
        <% @activities.each do |activity| %>
          <div class="px-3.5 py-3 flex items-center gap-3 hover:bg-bg-deep transition-colors">
            <span class="w-[22px] h-[22px] border-1.5 border-ink rounded grid place-items-center font-extrabold text-[11px] bg-paper flex-shrink-0"><%= activity.user.email[0].upcase %></span>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-ink truncate flex items-center gap-2 flex-wrap">
                <span class="font-semibold"><%= activity.user.email.split("@").first %></span>
                <span class="text-dim"><%= activity.description %></span>
                <% if activity.target_name.present? %>
                  <span class="text-accent"><%= activity.target_name %></span>
                <% end %>
                <%
                  channel = (activity.metadata || {}).with_indifferent_access[:channel].to_s
                  channel_label = channel_labels[channel]
                %>
                <% if channel_label %>
                  <%= render Atoms::TagComponent.new(tone: :dim) do %><%= channel_label %><% end %>
                <% end %>
              </p>
              <% extra = (activity.metadata || {}).reject { |k, _| k.to_s == "channel" } %>
              <% if extra.present? && extra.any? %>
                <p class="text-[11px] text-dim truncate mt-0.5"><%= extra.to_json.truncate(80) %></p>
              <% end %>
            </div>
            <span class="text-[11px] text-dim flex-shrink-0 ml-4" title="<%= activity.created_at.iso8601 %>">
              <%= time_ago_in_words(activity.created_at) %> ago
            </span>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render Organisms::EmptyStateComponent.new(
          headline: @filters.to_h.any? { |_, v| v.present? } ? "No activity matches these filters." : "No activity yet.",
          body: "Deploy an app, change config, or invite a teammate — actions land here in real time."
        ) %>
  <% end %>

  <% if @has_more %>
    <div class="text-center mt-6">
      <%= render Atoms::ButtonComponent.new(variant: :outline, size: :sm,
            href: dashboard_activities_path(@filters.to_h.merge(page: @page + 1))) do %>Load more<% end %>
    </div>
  <% end %>
</div>
