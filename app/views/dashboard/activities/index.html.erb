<% content_for(:title, "Audit Log") %>

<%
  channel_labels = {
    "app" => "Dashboard", "api" => "API", "cli" => "CLI",
    "mcp" => "MCP", "git_push" => "git push", "webhook" => "Webhook"
  }
%>

<div class="space-y-6">
  <%= render Atoms::HashHeaderComponent.new(
        title: "audit_log",
        kicker: "// who did what, from where, when",
        size: :md) %>

  <%# ── Tamper-evidence banner — surfaces ActivityDigest chain hash ── %>
  <% if @latest_digest %>
    <div class="border-1.5 border-ink bg-bg px-5 py-3 font-mono text-[11px] flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 bg-success-soft text-success border border-success text-[10px] uppercase tracking-widest">verified</span>
        <span class="text-ink">// chain hash verified through <%= @latest_digest.date.iso8601 %></span>
        <span class="text-dim">· <%= @latest_digest.row_count %> rows · hash <%= @latest_digest.chain_hash[0, 16] %>…</span>
      </div>
      <%= link_to "export csv ↓", dashboard_activities_path(@filters.to_h.merge(format: :csv)),
                  class: "text-dim hover:text-ink underline" %>
    </div>
  <% else %>
    <div class="border-1.5 border-rule-soft bg-paper px-5 py-3 font-mono text-[11px] flex flex-wrap items-center justify-between gap-3">
      <span class="text-dim">// digest chain not yet built — ActivityDigestJob runs nightly</span>
      <%= link_to "export csv ↓", dashboard_activities_path(@filters.to_h.merge(format: :csv)),
                  class: "text-dim hover:text-ink underline" %>
    </div>
  <% end %>

  <%# ── Filter bar ───────────────────────────────────────────────── %>
  <%= form_with url: dashboard_activities_path, method: :get, local: true,
                class: "border-1.5 border-ink bg-paper px-5 py-4 grid grid-cols-2 lg:grid-cols-5 gap-3 font-mono text-xs" do %>
    <label class="flex flex-col gap-1">
      <span class="text-[10px] text-dim uppercase tracking-widest">action</span>
      <select name="action_eq" class="border border-rule-soft bg-bg px-2 py-1.5 text-ink">
        <option value="">// any</option>
        <% @actions.each do |a| %>
          <option value="<%= a %>" <%= "selected" if @filters[:action_eq] == a %>><%= a %></option>
        <% end %>
      </select>
    </label>
    <label class="flex flex-col gap-1">
      <span class="text-[10px] text-dim uppercase tracking-widest">channel</span>
      <select name="channel" class="border border-rule-soft bg-bg px-2 py-1.5 text-ink">
        <option value="">// any</option>
        <% @channels.each do |c| %>
          <option value="<%= c %>" <%= "selected" if @filters[:channel] == c %>><%= channel_labels[c] || c %></option>
        <% end %>
      </select>
    </label>
    <label class="flex flex-col gap-1">
      <span class="text-[10px] text-dim uppercase tracking-widest">user</span>
      <select name="user_id" class="border border-rule-soft bg-bg px-2 py-1.5 text-ink">
        <option value="">// any</option>
        <% @team_users.each do |id, email| %>
          <option value="<%= id %>" <%= "selected" if @filters[:user_id] == id %>><%= email %></option>
        <% end %>
      </select>
    </label>
    <label class="flex flex-col gap-1">
      <span class="text-[10px] text-dim uppercase tracking-widest">since</span>
      <input type="date" name="since" value="<%= @filters[:since] %>" class="border border-rule-soft bg-bg px-2 py-1.5 text-ink">
    </label>
    <label class="flex flex-col gap-1">
      <span class="text-[10px] text-dim uppercase tracking-widest">until</span>
      <input type="date" name="until" value="<%= @filters[:until] %>" class="border border-rule-soft bg-bg px-2 py-1.5 text-ink">
    </label>
    <div class="col-span-2 lg:col-span-5 flex justify-end gap-2 pt-1">
      <%= link_to "reset", dashboard_activities_path, class: "px-3 py-1.5 border border-rule-soft text-dim hover:text-ink text-[10px] uppercase tracking-widest" %>
      <button type="submit" class="px-3 py-1.5 border-1.5 border-ink bg-ink text-paper text-[10px] uppercase tracking-widest">apply</button>
    </div>
  <% end %>

  <%# ── Activity list ───────────────────────────────────────────── %>
  <% if @activities.any? %>
    <div class="border-1.5 border-ink bg-paper divide-y divide-rule-soft overflow-hidden">
      <% @activities.each do |activity| %>
        <div class="px-5 py-3 flex items-center justify-between gap-3 font-mono">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-7 h-7 border-1.5 border-ink bg-bg flex items-center justify-center flex-shrink-0 text-xs text-ink-soft font-semibold"><%= activity.user.email[0].upcase %></div>
            <div class="min-w-0">
              <p class="text-sm text-ink-soft truncate flex items-center gap-2">
                <span class="font-medium text-ink"><%= activity.user.email.split("@").first %></span>
                <span class="text-dim"><%= activity.description %></span>
                <% if activity.target_name.present? %>
                  <span class="text-accent"><%= activity.target_name %></span>
                <% end %>
                <%
                  channel = (activity.metadata || {}).with_indifferent_access[:channel].to_s
                  channel_label = channel_labels[channel]
                %>
                <% if channel_label %>
                  <span class="ml-1 px-1.5 py-0.5 text-[9px] uppercase tracking-widest font-bold border border-rule-soft text-dim"><%= channel_label %></span>
                <% end %>
              </p>
              <% extra = (activity.metadata || {}).reject { |k, _| k.to_s == "channel" } %>
              <% if extra.present? && extra.any? %>
                <p class="text-[10px] text-dim truncate"><%= extra.to_json.truncate(80) %></p>
              <% end %>
            </div>
          </div>
          <span class="text-[10px] text-dim flex-shrink-0 ml-4" title="<%= activity.created_at.iso8601 %>">
            <%= time_ago_in_words(activity.created_at) %> ago
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render Organisms::EmptyStateComponent.new(
          headline: @filters.to_h.any? { |_, v| v.present? } ? "No activity matches these filters." : "No activity yet.",
          body: "Deploy an app, change config, or invite a teammate — actions land here in real time."
        ) %>
  <% end %>

  <% if @has_more %>
    <div class="text-center mt-6">
      <%= link_to "Load more →", dashboard_activities_path(@filters.to_h.merge(page: @page + 1)),
                  class: "inline-block border-1.5 border-ink bg-paper text-ink font-mono text-[11px] uppercase tracking-widest px-4 py-2 shadow-brutal hover:bg-bg-deep transition" %>
    </div>
  <% end %>
</div>
