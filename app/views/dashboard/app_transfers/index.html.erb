<%#
  App transfers (schdl grid rollout, U4 Task 4). Real data, ownership
  rotation, and mailer wiring preserved 1:1 — presentation only.
%>
<% content_for(:title, "App transfers") %>

<div class="space-y-6">
  <div class="mb-5">
    <h1 class="font-headline text-2xl font-extrabold tracking-tight"><%= t("dashboard.app_transfers.title", default: "App transfers") %></h1>
    <p class="text-[12.5px] text-dim mt-1">Pending ownership transfers — review incoming requests and manage outgoing ones.</p>
  </div>

  <section>
    <h2 class="text-sm font-bold text-ink mb-2"><%= t("dashboard.app_transfers.incoming", default: "Incoming") %></h2>
    <% if @incoming.any? %>
      <div class="bg-paper border border-line rounded-md shadow-brutal overflow-hidden">
        <div class="divide-y divide-line">
          <% @incoming.each do |transfer| %>
            <div class="px-3.5 py-3 flex items-center justify-between gap-3 hover:bg-bg-deep transition-colors">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-ink truncate"><%= transfer.app_record.name %></p>
                <p class="text-[12px] text-dim truncate">From <%= transfer.from_user.email %> · expires <%= time_ago_in_words(transfer.expires_at) %> from now</p>
              </div>
              <%= link_to "Review", dashboard_app_transfer_path(transfer), class: "text-xs text-accent hover:underline font-semibold flex-shrink-0" %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= render Organisms::EmptyStateComponent.new(
            headline: "No incoming transfers.",
            body: "Ownership requests addressed to you will show up here for review."
          ) %>
    <% end %>
  </section>

  <section>
    <h2 class="text-sm font-bold text-ink mb-2"><%= t("dashboard.app_transfers.outgoing", default: "Outgoing") %></h2>
    <% if @outgoing.any? %>
      <div class="bg-paper border border-line rounded-md shadow-brutal overflow-hidden">
        <div class="divide-y divide-line">
          <% @outgoing.each do |transfer| %>
            <div class="px-3.5 py-3 flex items-center justify-between gap-3 hover:bg-bg-deep transition-colors">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-ink truncate"><%= transfer.app_record.name %></p>
                <p class="text-[12px] text-dim truncate">To <%= transfer.to_user.email %> · expires <%= time_ago_in_words(transfer.expires_at) %> from now</p>
              </div>
              <%= button_to t("common.cancel"), dashboard_app_transfer_path(transfer), method: :delete,
                    data: { turbo_confirm: "Cancel transfer of #{transfer.app_record.name}?" },
                    class: "text-xs text-dim hover:text-danger transition cursor-pointer bg-transparent border-0 flex-shrink-0" %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= render Organisms::EmptyStateComponent.new(
            headline: "No pending outgoing transfers.",
            body: "Transfers you send to teammates will show up here until accepted, declined, or cancelled."
          ) %>
    <% end %>
  </section>
</div>
