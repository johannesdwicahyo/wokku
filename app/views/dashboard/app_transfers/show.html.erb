<% content_for(:title, "Transfer #{@transfer.app_record.name}") %>

<%
  app  = @transfer.app_record
  alloc = defined?(DynoAllocation) ? app.dyno_allocations.includes(:dyno_tier).find_by(process_type: "web") : nil
  tier  = alloc&.dyno_tier
  monthly_cents = tier ? tier.price_cents_per_hour * 24 * 30 * (alloc.count || 1) : 0
  addons = app.database_services.includes(:service_tier)
  domains = app.domains
  row = "px-5 py-3 flex items-center justify-between gap-3 font-mono"
%>

<div class="space-y-6 max-w-3xl">
  <div>
    <%= link_to dashboard_app_transfers_path, class: "font-mono text-xs text-dim hover:text-accent" do %>
      ← Back to transfers
    <% end %>
    <h1 class="mt-2 font-mono text-xl font-semibold tracking-tighter text-ink"># accept transfer of <%= app.name %>?</h1>
    <p class="mt-1 font-mono text-sm text-dim">
      <%= @transfer.from_user.email %> wants to transfer this app to you.
      Once you accept, billing for the container and any non-shared add-ons will start hitting your account
      from the moment of acceptance. Expires <%= time_ago_in_words(@transfer.expires_at) %> from now.
    </p>
  </div>

  <div class="border-1.5 border-ink bg-paper divide-y divide-rule-soft">
    <div class="<%= row %>">
      <p class="text-[10px] uppercase tracking-widest text-dim font-bold">App</p>
      <p class="text-sm text-ink"><%= app.name %></p>
    </div>
    <div class="<%= row %>">
      <p class="text-[10px] uppercase tracking-widest text-dim font-bold">Server</p>
      <p class="text-sm text-ink"><%= app.server&.name || "—" %></p>
    </div>
    <div class="<%= row %>">
      <p class="text-[10px] uppercase tracking-widest text-dim font-bold">Container Tier</p>
      <p class="text-sm text-ink">
        <% if tier %>
          <span class="font-semibold"><%= tier.name.titleize %></span>
          · <%= tier.memory_mb %> MB · <%= vcpu_display(tier.cpu_shares) %> vCPU
          × <%= alloc.count || 1 %>
        <% else %>
          —
        <% end %>
      </p>
    </div>
    <div class="<%= row %>">
      <p class="text-[10px] uppercase tracking-widest text-dim font-bold">Estimated Monthly Cost</p>
      <p class="text-sm text-ink font-semibold"><%= format_cents_for_user(monthly_cents, override: "idr") %><%= price_period("idr") %></p>
    </div>
    <div class="px-5 py-3 font-mono">
      <p class="text-[10px] uppercase tracking-widest text-dim font-bold mb-2">Linked Add-ons</p>
      <% if addons.any? %>
        <ul class="space-y-1">
          <% addons.each do |db| %>
            <li class="text-sm text-ink flex items-center justify-between">
              <span><span><%= db.name %></span> <span class="text-dim text-xs">· <%= db.service_type %> <%= db.tier_name %></span></span>
              <% if db.shared? %>
                <span class="text-xs text-dim">shared (no extra charge)</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-dim">None.</p>
      <% end %>
    </div>
    <div class="px-5 py-3 font-mono">
      <p class="text-[10px] uppercase tracking-widest text-dim font-bold mb-2">Domains</p>
      <% if domains.any? %>
        <ul class="space-y-1">
          <% domains.each do |d| %>
            <li class="text-sm text-ink"><%= d.host %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-dim">None.</p>
      <% end %>
    </div>
  </div>

  <% if @transfer.pending? %>
    <div class="flex items-center gap-3">
      <%= button_to "accept transfer", accept_dashboard_app_transfer_path(@transfer), data: { turbo_confirm: "Accept ownership of #{app.name}? Billing will start on your account immediately." }, class: "px-4 py-2 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer" %>
      <%= button_to "decline", decline_dashboard_app_transfer_path(@transfer), data: { turbo_confirm: "Decline this transfer?" }, class: "px-4 py-2 border-1.5 border-ink bg-paper text-ink font-mono text-sm hover:bg-bg-deep transition cursor-pointer" %>
    </div>
  <% else %>
    <p class="font-mono text-sm text-dim">// this transfer is no longer pending (<%= @transfer.status %>)</p>
  <% end %>
</div>
