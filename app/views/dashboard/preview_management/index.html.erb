<%#
  PR previews (schdl grid rollout, U4 Task 3). Renders inside
  AppTabsComponent + AppDeployComponent's content slot — no R1 page
  header, just a compact section heading. Settings form fields, table
  data, and destroy wiring preserved 1:1 — presentation only.
%>
<% content_for :title, "PR previews — #{@app.name}" %>

<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :deploy) do %>
  <%= render Organisms::AppDeployComponent.new(app: @app, active: :previews) do %>

    <h2 class="text-base font-bold mb-3"><%= t("dashboard.previews.heading", default: "PR previews") %></h2>

    <section class="space-y-4">
      <div class="border-1.5 border-ink bg-paper rounded-md p-6">
        <h3 class="text-sm font-bold text-ink mb-1">Settings</h3>
        <p class="text-[11.5px] text-dim mb-5">Spin up a throwaway environment for every pull request — same buildpack, isolated database, auto-destroyed when the PR closes.</p>

        <%= form_with model: @app, url: dashboard_app_preview_settings_path(@app), method: :patch, data: { turbo: false }, class: "space-y-5" do |f| %>
          <label class="flex items-center gap-2.5 cursor-pointer">
            <%= f.check_box :preview_enabled, class: "border-1.5 border-ink rounded text-ink focus:ring-2 focus:ring-ink/20 focus:ring-offset-0" %>
            <span class="text-sm text-ink font-medium">Enable PR previews</span>
          </label>

          <div>
            <span class="block text-xs font-semibold text-ink-soft mb-1.5">Database strategy</span>
            <div class="space-y-1.5">
              <%# "snapshot" stays a valid stored value but is not offered — it is not built and behaves like "empty". %>
              <% { "empty" => [ "No database", "Previews get none of this app's database credentials." ],
                   "shared" => [ "Share production database", "Shares prod data — destructive migrations affect prod." ] }.each do |strategy, (label, hint)| %>
                <label class="flex items-center gap-2.5 cursor-pointer">
                  <%= f.radio_button :database_strategy, strategy, checked: (@app.database_strategy == "shared") == (strategy == "shared"), class: "border-1.5 border-ink text-ink focus:ring-2 focus:ring-ink/20 focus:ring-offset-0" %>
                  <span class="text-sm text-ink"><%= label %></span>
                  <span class="text-[11px] <%= strategy == "shared" ? "text-warn" : "text-dim" %>"><%= hint %></span>
                </label>
              <% end %>
            </div>
          </div>

          <p class="text-[11.5px] text-dim">
            Concurrent preview limit: <strong class="text-ink">3</strong> per team. Auto-cleanup: sleeps after 7 days idle, destroys after 30 days idle.
          </p>

          <%= f.submit "Save", class: Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes %>
        <% end %>
      </div>

      <div class="bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-hidden">
        <div class="px-3.5 pt-3.5 pb-2">
          <h3 class="text-sm font-bold text-ink">Active previews</h3>
        </div>
        <% if @previews.any? %>
          <table class="w-full text-[13.5px]">
            <thead>
              <tr class="bg-bg border-b-1.5 border-ink text-[10.5px] font-bold uppercase tracking-[.06em] text-dim text-left">
                <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.previews.columns.pr", default: "PR") %></th>
                <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.previews.columns.branch", default: "Branch") %></th>
                <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.previews.columns.status", default: "Status") %></th>
                <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.previews.columns.url", default: "URL") %></th>
                <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.previews.columns.last_commit", default: "Last commit") %></th>
                <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.previews.columns.actions", default: "Actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% @previews.each do |preview| %>
                <tr class="border-b border-line last:border-b-0 hover:bg-bg-deep transition-colors">
                  <td class="px-3.5 py-2.5 text-[12.5px] text-ink font-semibold">#<%= preview.pr_number %></td>
                  <td class="px-3.5 py-2.5 text-[12.5px] text-dim"><%= preview.deploy_branch %></td>
                  <td class="px-3.5 py-2.5">
                    <%# Preview is an AppRecord — reuse the canonical status lookup
                        (same enum, same STATUSES table as the apps grid). %>
                    <%= render Atoms::StatusPillComponent.new(status: preview.status.to_s) %>
                  </td>
                  <td class="px-3.5 py-2.5 text-[12.5px]">
                    <% if preview.preview_hostname %>
                      <a href="https://<%= preview.preview_hostname %>" target="_blank" rel="noopener" class="text-ink hover:underline"><%= preview.preview_hostname %></a>
                    <% else %>
                      <span class="text-dim">—</span>
                    <% end %>
                  </td>
                  <td class="px-3.5 py-2.5 text-[12.5px] text-dim">
                    <%= preview.last_commit_at ? "#{time_ago_in_words(preview.last_commit_at)} ago" : "—" %>
                  </td>
                  <td class="px-3.5 py-2.5 text-right">
                    <%= button_to "Destroy",
                          dashboard_app_preview_path(@app, preview),
                          method: :delete,
                          data: { turbo_confirm: "Destroy preview ##{preview.pr_number}? This stops the dyno and removes the database." },
                          class: "text-xs text-dim hover:text-danger transition cursor-pointer bg-transparent border-0" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="px-3.5 pb-3.5">
            <%= render Organisms::EmptyStateComponent.new(
                  headline: "No active previews.",
                  body: "Open a PR on #{@app.github_repo_full_name || 'your connected repo'} to deploy your first preview."
                ) %>
          </div>
        <% end %>
      </div>
    </section>

  <% end %>
<% end %>
