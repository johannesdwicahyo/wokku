<%= link_to dashboard_template_path(template[:slug]), class: "block border border-line-strong bg-paper p-5 hover:bg-bg-deep transition-all group h-full flex flex-col" do %>
  <div class="flex items-start justify-between mb-3">
    <div class="w-11 h-11 border border-line bg-bg flex items-center justify-center flex-shrink-0">
      <%= template_brand_icon(template, size: 24) %>
    </div>
    <% if (template[:tags] || []).first %>
      <span class="border border-line text-dim bg-paper rounded px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest"><%= template[:tags].first %></span>
    <% end %>
  </div>
  <div class="flex items-baseline gap-2 mb-1">
    <h3 class="text-base font-semibold text-ink group-hover:underline transition"><%= template[:name] %></h3>
    <% if template[:version].present? %>
      <span class="text-[10px] text-dim tracking-wider">v<%= template[:version] %></span>
    <% end %>
  </div>
  <p class="text-xs text-dim leading-relaxed mb-4 line-clamp-2 min-h-[2.5rem]"><%= template[:description] %></p>
  <div class="mt-auto flex items-center justify-between pt-3 border-t border-rule-soft">
    <div>
      <p class="text-[9px] text-dim uppercase tracking-widest font-bold">From</p>
      <p class="text-xs font-bold text-ink"><%= template_total_label(template) %></p>
    </div>
    <span class="border border-line bg-bg text-ink px-3 py-1.5 text-[11px] font-bold group-hover:bg-ink group-hover:text-bg transition-all">Deploy</span>
  </div>
<% end %>
