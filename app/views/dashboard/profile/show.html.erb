<%#
  schdl profile hub (U5 Task 7). Wrapped in SettingsTabsComponent so it
  shares the tab chrome with Security / Notifications / Billing. All
  form_with/turbo_frame/data wiring preserved 1:1 — presentation only,
  EXCEPT the Danger Zone bug fix below.

  Bug fix (Locked #3b): this Danger Zone used to be a dead end — a
  contact-modal telling the user to email support@wokku.cloud. That never
  actually deleted anything; profile/edit's Danger Zone already linked the
  real flow (dashboard_account_deletion_path -> AccountDeletionsController
  -> the type-your-email confirm page -> User#schedule_deletion!). Both
  now point at that real flow via Molecules::DangerZoneComponent.
%>
<%= render Organisms::SettingsTabsComponent.new(active_tab: :profile, show_admin: current_user&.admin?) do %>

<% card_head = "px-6 py-4 border-b border-line flex items-center justify-between" %>
<% card_title = "font-headline text-base font-bold text-ink" %>
<% stat_label = "text-[10.5px] uppercase tracking-widest text-ink-soft font-bold mb-1" %>

<div class="mb-6">
  <h2 class="<%= card_title %>"><%= t("dashboard.profile.title") %></h2>
  <p class="text-xs text-dim mt-1"><%= t("dashboard.profile.subtitle") %></p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-6 items-start">
  <%# ===== LEFT COLUMN ===== %>
  <div class="flex flex-col gap-6 min-w-0">

    <%# Account Info %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="<%= card_head %>">
        <h3 class="<%= card_title %>"><%= t("dashboard.profile.account") %></h3>
        <%= link_to edit_dashboard_profile_path, class: "text-sm text-accent hover:underline" do %>Edit →<% end %>
      </div>
      <div class="p-6">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 border-1.5 border-ink bg-ink text-paper flex items-center justify-center text-xl font-bold rounded-md overflow-hidden">
            <% if current_user.avatar_url.present? %>
              <img src="<%= current_user.avatar_url %>" alt="Avatar" class="w-full h-full object-cover">
            <% else %>
              <%= current_user.email[0].upcase %>
            <% end %>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-ink"><%= current_user.name.presence || current_user.email %></h3>
            <p class="text-xs text-dim"><%= current_user.email %></p>
            <p class="text-[11px] text-dim mt-0.5">Member since <%= current_user.created_at.strftime("%B %Y") %> · <%= current_user.role.capitalize %></p>
          </div>
        </div>
        <%
          # Bundle v2: Servers tile only makes sense to admins (most users
          # see "1" since wokku-cloud runs a single shared Dokku host).
          # Regular users see Apps + Since; admins also see Servers.
          show_servers = current_user.admin?
          stat_cols = show_servers ? "grid-cols-3" : "grid-cols-2"
        %>
        <div class="grid <%= stat_cols %> gap-3">
          <div class="border-1.5 border-ink bg-bg p-3 text-center rounded-md">
            <p class="<%= stat_label %>">Apps</p>
            <span class="text-lg font-bold text-ink"><%= policy_scope(AppRecord).size %></span>
          </div>
          <% if show_servers %>
            <div class="border-1.5 border-ink bg-bg p-3 text-center rounded-md">
              <p class="<%= stat_label %>">Servers</p>
              <span class="text-lg font-bold text-ink"><%= policy_scope(Server).size %></span>
            </div>
          <% end %>
          <div class="border-1.5 border-ink bg-bg p-3 text-center rounded-md">
            <p class="<%= stat_label %>">Since</p>
            <span class="text-lg font-bold text-ink"><%= current_user.created_at.strftime("%b %Y") %></span>
          </div>
        </div>
      </div>
    </div>

    <%# Preferences — language + currency (independent) %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="px-6 py-4 border-b border-line">
        <h3 class="<%= card_title %>"><%= t("dashboard.profile.preferences", default: "Preferences") %></h3>
        <p class="text-xs text-dim mt-0.5"><%= t("dashboard.profile.preferences_hint", default: "Display language and billing currency can be set independently.") %></p>
      </div>
      <div class="p-6">
        <%= form_with url: dashboard_profile_path, method: :patch, local: true, class: "grid grid-cols-1 sm:grid-cols-2 gap-4" do |f| %>
          <%= f.fields_for :user, current_user do |u| %>
            <div>
              <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t("dashboard.profile.language", default: "Language") %></label>
              <%= u.select :locale,
                    [["English", "en"], ["Bahasa Indonesia", "id"]],
                    {},
                    class: "w-full bg-paper text-ink border-1.5 border-ink rounded-md px-3 py-2 text-sm focus:outline-none focus:shadow-brutal-sm",
                    onchange: "this.form.requestSubmit()" %>
            </div>
            <div>
              <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t("dashboard.profile.currency", default: "Billing currency") %></label>
              <% if Wokku::LaunchMode.idr_only? %>
                <div class="flex items-center gap-2 h-[38px]">
                  <span class="text-sm text-ink font-bold">IDR (Rp)</span>
                  <span class="text-[11px] text-dim">USD billing available after international expansion</span>
                </div>
              <% else %>
                <%= u.select :currency,
                      [["USD ($)", "usd"], ["IDR (Rp)", "idr"]],
                      {},
                      class: "w-full bg-paper text-ink border-1.5 border-ink rounded-md px-3 py-2 text-sm focus:outline-none focus:shadow-brutal-sm",
                      onchange: "this.form.requestSubmit()" %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Resource Overview %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="px-6 py-4 border-b border-line">
        <div class="flex items-center justify-between">
          <h3 class="<%= card_title %>"><%= t("dashboard.profile.resource_overview") %></h3>
          <%
            # Tile counts (apps, addons, dynos) are informational only; the
            # monthly cost comes from the host app's billing (none on a self-host).
            user_apps = policy_scope(AppRecord).includes(dyno_allocations: :dyno_tier)
            user_dbs  = policy_scope(DatabaseService) rescue DatabaseService.none

            running_app_count = user_apps.select(&:running?).size
            total_app_count   = user_apps.size
            addon_count       = user_dbs.size
            dyno_count        = user_apps.flat_map(&:dyno_allocations).sum { |a| a.count.to_i }
          %>
          <% if respond_to?(:team_monthly_cost) && current_team %>
            <% amount, caption = team_monthly_cost(current_team) %>
            <div class="text-right">
              <span class="text-lg font-bold text-accent"><%= amount %></span>
              <p class="text-[10.5px] text-dim uppercase tracking-widest"><%= caption %></p>
            </div>
          <% end %>
        </div>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-3 gap-3">
          <div class="border-1.5 border-ink bg-bg p-4 rounded-md">
            <p class="<%= stat_label %>">Active Apps</p>
            <span class="text-2xl font-bold text-ink"><%= running_app_count %></span>
            <p class="text-[11px] text-dim mt-1">of <%= total_app_count %> total</p>
          </div>
          <div class="border-1.5 border-ink bg-bg p-4 rounded-md">
            <p class="<%= stat_label %>">Add-ons</p>
            <span class="text-2xl font-bold text-ink"><%= addon_count %></span>
            <p class="text-[11px] text-dim mt-1">databases &amp; services</p>
          </div>
          <div class="border-1.5 border-ink bg-bg p-4 rounded-md">
            <p class="<%= stat_label %>">Dynos</p>
            <span class="text-2xl font-bold text-ink"><%= dyno_count %></span>
            <p class="text-[11px] text-dim mt-1">active containers</p>
          </div>
        </div>
      </div>
    </div>

    <%# Recent Activity %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="<%= card_head %>">
        <h3 class="<%= card_title %>">Recent activity</h3>
        <%= link_to dashboard_activities_path, class: "text-sm text-accent hover:underline" do %>View all →<% end %>
      </div>
      <%
        recent = Activity.where(user: current_user).order(created_at: :desc).limit(5) rescue []
      %>
      <% if recent.any? %>
        <div class="divide-y divide-line">
          <% recent.each do |activity| %>
            <div class="px-6 py-3 flex items-center justify-between hover:bg-bg-deep transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
                <span class="text-xs text-ink-soft truncate"><%= activity.description %> <span class="text-accent"><%= activity.target_name %></span></span>
              </div>
              <span class="text-[11px] text-dim flex-shrink-0 ml-3"><%= time_ago_in_words(activity.created_at) %> ago</span>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-6 text-center text-xs text-dim">No recent activity.</div>
      <% end %>
    </div>
  </div>

  <%# ===== RIGHT COLUMN ===== %>
  <div class="flex flex-col gap-6">

    <%# Security — 2FA %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="<%= card_head %>"><h3 class="<%= card_title %>"><%= t("dashboard.profile.security") %></h3></div>
      <div class="p-5">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-semibold text-ink">Two-factor auth</span>
          <% if current_user.respond_to?(:two_factor_enabled?) && current_user.two_factor_enabled? %>
            <%= render Atoms::TagComponent.new(tone: :success) do %>Enabled<% end %>
          <% else %>
            <%= render Atoms::TagComponent.new(tone: :dim) do %>Disabled<% end %>
          <% end %>
        </div>
        <% if respond_to?(:dashboard_two_factor_path) %>
          <%= render Atoms::ButtonComponent.new(variant: :outline, size: :sm, href: dashboard_two_factor_path, class: "w-full") do %>
            <%= current_user.respond_to?(:two_factor_enabled?) && current_user.two_factor_enabled? ? "Manage 2FA" : "Enable 2FA" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# SSH Keys %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="<%= card_head %>"><h3 class="<%= card_title %>"><%= t("dashboard.profile.ssh_keys") %></h3></div>
      <div class="p-5">
        <p class="text-xs text-dim mb-3">Add your SSH public key to enable <code class="font-mono text-accent">git push</code> deployments.</p>

        <%= turbo_frame_tag "ssh_keys" do %>
          <%= render "dashboard/ssh_keys/key_list", keys: current_user.ssh_public_keys.order(created_at: :desc), key: nil %>
        <% end %>

        <div class="mt-4 pt-4 border-t border-line">
          <div class="border-1.5 border-ink bg-bg p-3 rounded-md">
            <p class="text-[10.5px] text-dim uppercase tracking-widest mb-1">Deploy command</p>
            <code class="block font-mono text-xs text-ink-soft">git remote add wokku git@<%= ENV.fetch("WOKKU_GIT_HOST", "wokku.cloud") %>:APP_NAME</code>
            <code class="block font-mono text-xs text-ink-soft">git push wokku main</code>
          </div>
        </div>
      </div>
    </div>

    <%# API Tokens %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="<%= card_head %>"><h3 class="<%= card_title %>"><%= t("dashboard.profile.api_tokens") %></h3></div>
      <div class="p-5">
        <p class="text-xs text-dim mb-3">Use tokens to authenticate CLI, API, and MCP requests.</p>

        <%= turbo_frame_tag "api_tokens" do %>
          <%= render "dashboard/api_tokens/token_list", tokens: current_user.api_tokens.active.order(created_at: :desc), new_token: nil %>
        <% end %>

        <div class="mt-4 pt-4 border-t border-line space-y-2">
          <div class="border-1.5 border-ink bg-bg p-3 rounded-md">
            <span class="text-[10.5px] text-dim uppercase tracking-widest">API endpoint</span>
            <code class="block font-mono text-xs text-accent mt-1">https://wokku.cloud/api/v1</code>
          </div>
          <div class="border-1.5 border-ink bg-bg p-3 rounded-md">
            <span class="text-[10.5px] text-dim uppercase tracking-widest">Auth header</span>
            <code class="block font-mono text-xs text-ink-soft mt-1">Authorization: Bearer <span class="text-accent">YOUR_TOKEN</span></code>
          </div>
        </div>
      </div>
    </div>

    <%# Quick Links %>
    <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
      <div class="<%= card_head %>"><h3 class="<%= card_title %>">Quick links</h3></div>
      <div class="divide-y divide-line">
        <%= link_to dashboard_notifications_path, class: "block px-5 py-2.5 text-sm text-ink-soft hover:bg-bg-deep hover:text-ink transition-colors" do %>Notifications →<% end %>
        <%= link_to dashboard_activities_path, class: "block px-5 py-2.5 text-sm text-ink-soft hover:bg-bg-deep hover:text-ink transition-colors" do %>Activity log →<% end %>
        <a href="/docs" target="_blank" class="block px-5 py-2.5 text-sm text-ink-soft hover:bg-bg-deep hover:text-ink transition-colors">Documentation ↗</a>
      </div>
    </div>

    <%# Danger Zone — real account-deletion flow, not the old contact-modal dead end %>
    <%= render Molecules::DangerZoneComponent.new(
          title: t("dashboard.profile.danger_zone"),
          body: t("dashboard.account_deletions.danger_zone_description")
        ) do %>
      <%= render Atoms::ButtonComponent.new(variant: :danger, size: :md, href: dashboard_account_deletion_path, class: "w-full") do %>
        <%= t("dashboard.profile.delete_account") %>
      <% end %>
    <% end %>
  </div>
</div>

<% end %>
