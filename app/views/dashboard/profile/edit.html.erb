<%# schdl (U5 Task 7). form_with model/url/method preserved 1:1 —
    presentation only. Danger Zone → Molecules::DangerZoneComponent,
    same real dashboard_account_deletion_path as profile#show (Locked #3b). %>
<% content_for :title, "Edit profile" %>

<div class="max-w-lg space-y-8">
  <div class="mb-2">
    <h1 class="font-headline text-xl font-bold text-ink">Edit profile</h1>
  </div>

  <%= form_with(model: current_user, url: dashboard_profile_path, method: :patch, class: "border-1.5 border-ink bg-paper rounded-md p-6 space-y-5") do |f| %>
    <% if current_user.errors.any? %>
      <div class="border-1.5 border-danger bg-danger-soft rounded-md p-4">
        <ul class="list-disc list-inside text-sm text-danger space-y-1">
          <% current_user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :email, class: "block text-xs font-semibold text-ink-soft mb-1" %>
      <%= f.email_field :email, class: "w-full bg-paper border-1.5 border-ink text-ink text-sm rounded-md px-3 py-2 focus:outline-none focus:shadow-brutal-sm" %>
    </div>

    <%# Cloud-only: self-host has no billing (and no resource_usages). %>
    <% if wokku_cloud? %>
    <div>
      <%= f.label :currency, "Billing currency", class: "block text-xs font-semibold text-ink-soft mb-1" %>
      <% if Wokku::LaunchMode.idr_only? %>
        <div class="flex items-center gap-2">
          <span class="text-sm text-ink font-bold">IDR</span>
          <span class="text-[11px] text-dim">(USD billing available after international expansion)</span>
        </div>
      <% elsif current_user.resource_usages.active.billable.any? %>
        <div class="flex items-center gap-2">
          <span class="text-sm text-ink font-bold"><%= current_user.currency.upcase %></span>
          <span class="text-[11px] text-dim">(locked — active paid resources)</span>
        </div>
      <% else %>
        <%= combobox_tag "user[currency]", [["US Dollar (USD)", "usd"], ["Indonesian Rupiah (IDR)", "idr"]], value: current_user.currency, placeholder: "Select currency" %>
      <% end %>
    </div>
    <% end %>

    <%# Notifications %>
    <div class="border-t border-line pt-4">
      <p class="text-xs text-dim uppercase tracking-widest font-bold mb-3">Notifications</p>
      <label class="flex items-start gap-3 cursor-pointer">
        <%= f.check_box :daily_debit_email_subscribed,
              class: "mt-0.5 border-1.5 border-ink text-accent rounded focus:ring-accent" %>
        <span>
          <span class="block text-sm text-ink font-medium">Daily usage email</span>
          <span class="block text-xs text-dim mt-0.5">
            Get a daily summary of your Wokku usage and balance.
            New accounts receive these for the first 7 days automatically.
          </span>
        </span>
      </label>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= f.submit "Save Changes", class: Atoms::ButtonComponent.new(variant: :primary, size: :md).classes %>
      <%= link_to "Cancel", dashboard_profile_path, class: "text-sm text-dim hover:text-ink transition" %>
    </div>
  <% end %>

  <%# Danger Zone — real account-deletion flow (same destination as profile#show) %>
  <%= render Molecules::DangerZoneComponent.new(
        title: t("dashboard.profile.danger_zone"),
        body: t("dashboard.account_deletions.danger_zone_description")
      ) do %>
    <%= render Atoms::ButtonComponent.new(variant: :danger, size: :md, href: dashboard_account_deletion_path) do %>
      <%= t("dashboard.account_deletions.delete_account_button") %>
    <% end %>
  <% end %>
</div>
