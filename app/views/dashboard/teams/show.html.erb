<div class="mb-6 font-mono">
  <div class="flex items-center gap-2 text-sm">
    <%= link_to "teams", dashboard_teams_path, class: "text-dim hover:text-accent transition" %>
    <span class="text-dim">/</span>
    <span class="text-ink font-medium"><%= @team.name %></span>
  </div>
</div>

<h1 class="font-mono text-2xl font-semibold tracking-tighter text-ink mb-6"># <%= @team.name %></h1>

<div class="border-1.5 border-ink bg-paper overflow-hidden">
  <div class="px-6 py-4 border-b border-rule-soft">
    <h2 class="font-mono text-base font-semibold text-ink">members</h2>
  </div>

  <div class="divide-y divide-rule-soft">
    <% @members.each do |membership| %>
      <div class="px-6 py-3 flex items-center justify-between hover:bg-bg-deep transition-colors font-mono">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 border-1.5 border-ink bg-accent flex items-center justify-center text-bg text-sm font-semibold">
            <%= membership.user.email[0].upcase %>
          </div>
          <span class="text-sm font-medium text-ink"><%= membership.user.email %></span>
        </div>
        <span class="text-xs text-dim uppercase tracking-widest"><%= membership.role.capitalize %></span>
      </div>
    <% end %>
  </div>
</div>
