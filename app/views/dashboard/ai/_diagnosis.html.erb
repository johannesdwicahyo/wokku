<div class="border border-line bg-paper p-4 mt-4">
  <h3 class="font-mono text-xs font-semibold text-ink uppercase tracking-widest mb-3">🤖 ai_diagnosis</h3>
  <% if result[:diagnosis] %>
    <div class="font-mono text-xs text-ink-soft leading-relaxed">
      <%= simple_format(result[:diagnosis]) %>
    </div>
  <% elsif result[:error] %>
    <p class="font-mono text-xs text-danger"><%= result[:error] %></p>
  <% end %>
</div>
