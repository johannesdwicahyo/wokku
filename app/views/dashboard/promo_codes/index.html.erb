<% content_for(:title, "Promo Codes") %>

<div class="space-y-6 max-w-4xl">
  <div>
    <h1 class="text-xl font-headline text-on-surface">Promo Codes</h1>
    <p class="mt-0.5 text-sm text-outline">Manual credits (Phase 1) + channel codes (Phase 2). Referral codes (Phase 3) are auto-generated per user and not listed here.</p>
  </div>

  <div class="bg-surface-container-low rounded-xl border border-outline-variant/15 p-5">
    <h2 class="text-sm font-semibold text-on-surface mb-3">Create code</h2>
    <%= form_with url: dashboard_promo_codes_path, method: :post, local: true, class: "space-y-3" do %>
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-[10px] uppercase tracking-wider text-outline font-bold">Kind</span>
          <select name="kind" class="mt-1 w-full bg-surface border border-outline-variant/20 rounded-md px-3 py-2 text-sm text-on-surface">
            <option value="manual_credit">Manual credit (instant grant on redeem)</option>
            <option value="channel_match">Channel match (bonus on first deposit)</option>
          </select>
        </label>
        <label class="block">
          <span class="text-[10px] uppercase tracking-wider text-outline font-bold">Code</span>
          <input type="text" name="code" required placeholder="WOKKU2026" class="mt-1 w-full bg-surface border border-outline-variant/20 rounded-md px-3 py-2 text-sm text-on-surface font-mono uppercase">
        </label>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <label class="block">
          <span class="text-[10px] uppercase tracking-wider text-outline font-bold">Bonus (IDR)</span>
          <input type="number" name="redeemer_bonus_idr" required min="0" placeholder="50000" class="mt-1 w-full bg-surface border border-outline-variant/20 rounded-md px-3 py-2 text-sm text-on-surface font-mono">
        </label>
        <label class="block">
          <span class="text-[10px] uppercase tracking-wider text-outline font-bold">Min deposit (IDR)</span>
          <input type="number" name="min_deposit_idr" min="0" placeholder="25000" class="mt-1 w-full bg-surface border border-outline-variant/20 rounded-md px-3 py-2 text-sm text-on-surface font-mono">
        </label>
        <label class="block">
          <span class="text-[10px] uppercase tracking-wider text-outline font-bold">Max redemptions</span>
          <input type="number" name="max_redemptions" min="1" placeholder="(optional)" class="mt-1 w-full bg-surface border border-outline-variant/20 rounded-md px-3 py-2 text-sm text-on-surface font-mono">
        </label>
      </div>
      <label class="block">
        <span class="text-[10px] uppercase tracking-wider text-outline font-bold">Description (internal note)</span>
        <input type="text" name="description" placeholder="e.g. Telegram Laravel ID — Apr 28" class="mt-1 w-full bg-surface border border-outline-variant/20 rounded-md px-3 py-2 text-sm text-on-surface">
      </label>
      <button type="submit" class="px-4 py-2 bg-primary text-on-primary text-sm font-bold rounded-md hover:opacity-90 transition cursor-pointer">Create</button>
    <% end %>
  </div>

  <div class="bg-surface-container-low rounded-xl border border-outline-variant/15 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="text-[10px] uppercase tracking-wider text-outline">
        <tr><th class="text-left px-5 py-3">Code</th><th class="text-left">Kind</th><th class="text-right">Bonus</th><th class="text-right">Min deposit</th><th class="text-right">Used</th><th class="text-right">Status</th><th></th></tr>
      </thead>
      <tbody class="divide-y divide-outline-variant/10">
        <% @codes.each do |c| %>
          <tr>
            <td class="px-5 py-3 font-mono text-primary"><%= c.code %></td>
            <td><%= c.kind.titleize %></td>
            <td class="text-right font-mono">Rp <%= ActiveSupport::NumberHelper.number_to_delimited(c.redeemer_bonus_idr, delimiter: '.') %></td>
            <td class="text-right font-mono">Rp <%= ActiveSupport::NumberHelper.number_to_delimited(c.min_deposit_idr, delimiter: '.') %></td>
            <td class="text-right font-mono"><%= c.redemptions_count %><%= c.max_redemptions ? "/#{c.max_redemptions}" : "" %></td>
            <td class="text-right text-xs"><%= c.active? ? "active" : "disabled" %></td>
            <td class="px-5 py-3 text-right">
              <% if c.active? %>
                <%= button_to "Disable", dashboard_promo_code_path(c), method: :delete, data: { turbo_confirm: "Disable #{c.code}?" }, class: "text-xs text-error hover:underline bg-transparent" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @codes.empty? %>
      <p class="px-5 py-6 text-sm text-outline text-center">No codes yet.</p>
    <% end %>
  </div>
</div>
