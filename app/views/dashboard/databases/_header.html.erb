<%# Shared header + tab strip for addon pages (Overview / Monitor / Backups / Settings). %>
<% linked_count = database.app_records.size %>
<div class="mb-5">
  <div class="text-[13px] text-dim mb-3">
    <%= link_to t("dashboard.nav.addons"), dashboard_addons_path, class: "hover:text-ink hover:underline" %>
    <span class="mx-1">/</span>
    <span class="text-ink font-semibold"><%= database.name %></span>
  </div>

  <div class="flex flex-wrap items-start justify-between gap-4 pb-6 border-b border-line">
    <div>
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="font-headline text-2xl font-extrabold tracking-tight"><%= database.name %></h1>
        <%= render Atoms::TagComponent.new(tone: :dim) do %><%= database.service_type %><% end %>
        <%= render Atoms::TagComponent.new(tone: database.shared? ? :success : :accent) do %><%= database.shared? ? "Shared" : "Dedicated" %><% end %>
        <% if database.status == "stopped" %>
          <%= render Atoms::TagComponent.new(tone: :dim) do %>Stopped<% end %>
        <% elsif database.status == "error" %>
          <%= render Atoms::TagComponent.new(tone: :danger) do %>Error<% end %>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-dim">On <%= database.server.name %> · <%= linked_count %> linked app<%= linked_count == 1 ? '' : 's' %></p>
    </div>
  </div>
</div>

<%= render "dashboard/databases/tabs", database: database, active: active %>
