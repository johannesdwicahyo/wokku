<%#
  schdl addon overview (U5 Task 6). Over-quota banner, connection panel,
  and config/usage math preserved 1:1 — presentation only. Connection
  values stay mono (data); this page's chrome de-mono'd.
%>
<%= render "header", database: @database, active: :overview %>

<% if @database.over_quota? %>
  <%
    cap_gb = (@database.service_tier&.spec || {})["storage_gb"].to_i
    used_mb = @database.live_db_bytes ? (@database.live_db_bytes.to_f / 1.megabyte).round(1) : nil
    grace_left = ((@database.over_quota_at + 24.hours) - Time.current) / 1.hour
  %>
  <div class="mb-6 border-1.5 border-danger bg-danger-soft rounded-md px-5 py-4">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <p class="text-sm font-semibold text-danger mb-1">Storage quota reached</p>
        <p class="text-xs text-ink-soft">
          Using <%= used_mb %> MB of <%= cap_gb %> GB allowed on the <%= @database.tier_name %> plan.
          <% if grace_left > 0 %>
            Database stays writable for ~<%= grace_left.round %>h before it's flagged stopped.
          <% else %>
            Database has been flagged stopped — upgrade to restore service.
          <% end %>
        </p>
      </div>
      <%= link_to "Upgrade plan →", "#change-plan", class: "#{Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes} flex-shrink-0" %>
    </div>
  </div>
<% end %>

<%= render "connection_panel", database: @database, info: @info %>

<%# Config + Usage. Bundle v2: addons are bundled with the plan, no per-addon
    pricing. Show the mode (Shared / Dedicated) instead of a tier name. %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8">
  <%# Config card %>
  <div class="border-1.5 border-ink bg-paper rounded-md p-5">
    <div class="flex items-baseline justify-between mb-3">
      <p class="text-[10.5px] uppercase tracking-widest text-ink-soft font-bold">Config</p>
      <% if @database.shared? %>
        <%= render Atoms::TagComponent.new(tone: :success) do %>Shared<% end %>
      <% else %>
        <%= render Atoms::TagComponent.new(tone: :accent) do %>Dedicated<% end %>
      <% end %>
    </div>
    <p class="font-headline text-2xl font-extrabold text-ink mb-3 capitalize"><%= @database.service_type %></p>
    <% if (spec = @current_tier&.spec) %>
      <div class="grid grid-cols-3 gap-2 text-xs">
        <div><p class="text-dim">RAM</p><p class="text-ink-soft"><%= spec["memory_mb"] || "—" %> MB</p></div>
        <div><p class="text-dim">Storage</p><p class="text-ink-soft"><%= spec["storage_gb"] || "—" %> GB</p></div>
        <div><p class="text-dim">Connections</p><p class="text-ink-soft"><%= spec["connections"] || "—" %></p></div>
      </div>
    <% end %>
  </div>

  <%# Usage card %>
  <%
    spec = @current_tier&.spec || {}
    storage_gb = spec["storage_gb"].to_i
    ram_cap_mb = spec["memory_mb"].to_i
    used_bytes = @usage[:db_bytes]
    used_mb = used_bytes ? (used_bytes.to_f / 1.megabyte).round(1) : nil
    storage_pct = (used_bytes && storage_gb.positive?) ? [(used_bytes.to_f / (storage_gb * 1.gigabyte) * 100).round(1), 100].min : nil
    ram_bytes = @usage[:ram_bytes]
    ram_used_mb = ram_bytes ? (ram_bytes.to_f / 1.megabyte).round(1) : nil
    ram_pct = (ram_used_mb && ram_cap_mb.positive?) ? [(ram_used_mb / ram_cap_mb * 100).round(1), 100].min : nil
  %>
  <div class="border-1.5 border-ink bg-paper rounded-md p-5">
    <p class="text-[10.5px] uppercase tracking-widest text-ink-soft font-bold mb-3">Usage</p>
    <div class="space-y-3">
      <div>
        <div class="flex items-baseline justify-between mb-1">
          <span class="text-xs text-dim">Storage</span>
          <span class="text-xs text-ink-soft"><%= used_mb ? "#{used_mb} MB" : "—" %><% if storage_pct %> · <%= storage_pct %>% of <%= storage_gb %> GB<% end %></span>
        </div>
        <% if storage_pct %>
          <div class="h-1.5 bg-bg-deep rounded-full relative overflow-hidden">
            <div class="absolute inset-0 <%= storage_pct >= 90 ? "bg-danger" : storage_pct >= 75 ? "bg-warn" : "bg-accent" %>" style="width: <%= storage_pct %>%"></div>
          </div>
        <% end %>
      </div>
      <div>
        <div class="flex items-baseline justify-between mb-1">
          <span class="text-xs text-dim">RAM</span>
          <span class="text-xs text-ink-soft"><%= ram_used_mb ? "#{ram_used_mb} MB" : "—" %><% if ram_pct %> · <%= ram_pct %>% of <%= ram_cap_mb %> MB<% end %></span>
        </div>
        <% if ram_pct %>
          <div class="h-1.5 bg-bg-deep rounded-full relative overflow-hidden">
            <div class="absolute inset-0 <%= ram_pct >= 90 ? "bg-danger" : ram_pct >= 75 ? "bg-warn" : "bg-accent" %>" style="width: <%= ram_pct %>%"></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
