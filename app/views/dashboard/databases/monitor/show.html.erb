<%
  fmt_bytes = ->(b) {
    return "—" unless b
    units = %w[B KB MB GB TB]
    n = b.to_f
    i = 0
    while n >= 1024 && i < units.size - 1
      n /= 1024.0
      i += 1
    end
    "#{n.round(1)} #{units[i]}"
  }

  cache_label, cache_tone =
    if @latest_ok.nil?
      [ "—", :ink ]
    elsif @latest_ok.cache_hit_ratio.nil?
      [ "—", :ink ]
    elsif @latest_ok.cache_hit_ratio >= 0.99
      [ "Optimal", :success ]
    elsif @latest_ok.cache_hit_ratio >= 0.95
      [ "Healthy", :ink ]
    else
      [ "Degraded", :danger ]
    end

  live = @latest_ok && @last_seen_ago && @last_seen_ago < 15
%>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <%= render Atoms::HashHeaderComponent.new(
          title: "#{@database.name} · Monitor",
          kicker: "// #{@database.service_type} · pg_stat_statements / redis_INFO",
          size: :md) %>
    <div class="flex items-center gap-2">
      <%= link_to "← back to addon", dashboard_addon_path(@database), class: "font-mono text-xs text-dim hover:text-ink" %>
    </div>
  </div>

  <% if @latest.nil? && @latest_ok.nil? %>
    <div class="border-1.5 border-warn bg-warn-soft px-5 py-4 font-mono text-xs text-ink">
      // no snapshots yet · DatabaseStatsCollectorJob runs every 5 min · check back shortly
    </div>
  <% elsif @latest&.collection_error.present? %>
    <div class="border-1.5 border-danger bg-bg px-5 py-4 font-mono text-xs">
      <div class="text-danger uppercase tracking-widest text-[10px] mb-1">// collection_error</div>
      <code class="text-ink"><%= @latest.collection_error %></code>
    </div>
  <% end %>

  <%# ── Hero stat tiles ─────────────────────────────────────── %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <%= render Molecules::StatTileComponent.new(
          label: "Active Connections",
          value: @latest_ok&.active_connections.to_i,
          sub: @latest_ok&.max_connections ?
                 "// / #{@latest_ok.max_connections} max" :
                 "// no limit reported",
          glyph: "⇄") %>

    <%= render Molecules::StatTileComponent.new(
          label: "#{@database.service_type == 'redis' ? 'Memory Used' : 'Database Size'}",
          value: fmt_bytes.call(@latest_ok&.db_size_bytes),
          sub: "// total #{@database.service_type} #{@database.service_type == 'redis' ? 'memory' : 'volume'}",
          glyph: "▢") %>

    <%= render Molecules::StatTileComponent.new(
          label: "Cache Hit Ratio",
          value: @latest_ok&.cache_hit_ratio ? "#{(@latest_ok.cache_hit_ratio * 100).round(1)}%" : "—",
          sub: "// #{cache_label}",
          tone: cache_tone,
          glyph: "%") %>

    <%= render Molecules::StatTileComponent.new(
          label: "Monitoring Status",
          value: live ? "Live ●" : "Stale",
          sub: @last_seen_ago ?
                 "// updated #{@last_seen_ago}m ago" :
                 "// no data yet",
          tone: live ? :success : :warn,
          glyph: live ? "●" : "○") %>
  </div>

  <%# ── Query Performance / Slow Log ────────────────────────── %>
  <div class="border-1.5 border-ink bg-paper">
    <div class="px-6 py-4 border-b border-rule-soft flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="font-mono text-base font-semibold text-ink"># <%= @database.service_type == 'redis' ? 'slow_log' : 'query_performance' %></h2>
        <p class="font-mono text-xs text-dim mt-1">
          // <%= @database.service_type == 'redis' ? 'slowest commands (SLOWLOG GET 50)' : 'top 20 by selected sort · pg_stat_statements' %>
        </p>
      </div>
      <div class="flex items-center gap-1 font-mono">
        <% [ [ "slowest", "Slowest" ], [ "most_time", "Most Time" ], [ "most_called", "Most Called" ] ].each do |key, label| %>
          <%= link_to label,
                dashboard_addon_monitor_path(@database, sort: key),
                class: "text-[10px] uppercase tracking-widest px-3 py-1.5 border #{@sort == key ? 'border-ink bg-ink text-paper' : 'border-rule-soft text-dim hover:border-ink hover:text-ink'}" %>
        <% end %>
      </div>
    </div>

    <% if @top_queries.any? %>
      <div class="overflow-x-auto">
        <table class="w-full font-mono text-xs">
          <thead>
            <tr class="text-left text-[10px] text-dim tracking-widest uppercase border-b border-rule-soft">
              <th class="px-6 py-3 w-1/2">Query</th>
              <th class="px-3 py-3 text-right">Calls</th>
              <th class="px-3 py-3 text-right">Total Time</th>
              <th class="px-3 py-3 text-right">Avg Time</th>
              <th class="px-6 py-3 text-right">Rows</th>
            </tr>
          </thead>
          <tbody>
            <% @top_queries.each do |q| %>
              <tr class="border-b border-rule-soft hover:bg-bg">
                <td class="px-6 py-3 text-ink break-all leading-relaxed">
                  <span class="line-clamp-2"><%= q["query"] %></span>
                </td>
                <td class="px-3 py-3 text-right text-ink-soft tabular-nums"><%= q["calls"] %></td>
                <td class="px-3 py-3 text-right text-ink tabular-nums"><%= q["total_ms"] ? "#{q['total_ms'].round(1)}ms" : "—" %></td>
                <td class="px-3 py-3 text-right text-ink tabular-nums"><%= q["mean_ms"] ? "#{q['mean_ms'].round(2)}ms" : "—" %></td>
                <td class="px-6 py-3 text-right text-ink-soft tabular-nums"><%= q["rows"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-8 font-mono text-xs text-dim text-center">
        // no <%= @database.service_type == 'redis' ? 'slow log entries' : 'query stats' %> yet
        <% if @database.service_type == 'postgres' %>
          <div class="mt-2 text-[10px]">// requires pg_stat_statements extension — enable via <code class="text-ink">ALTER SYSTEM SET shared_preload_libraries = 'pg_stat_statements';</code></div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Redis: extra info ───────────────────────────────────── %>
  <% if @database.service_type == "redis" && @latest_ok&.raw_info&.any? %>
    <div class="border-1.5 border-ink bg-paper px-6 py-5">
      <div class="font-mono text-[10px] text-dim tracking-widest uppercase mb-3">// redis_info()</div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 font-mono text-xs">
        <% @latest_ok.raw_info.each do |k, v| %>
          <div>
            <div class="text-[10px] text-dim uppercase tracking-widest"><%= k.tr('_', ' ') %></div>
            <div class="text-ink mt-1"><%= v %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
