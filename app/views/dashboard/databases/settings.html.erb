<%#
  schdl addon settings (U5 Task 6). Link/unlink app wiring, slide-panel
  form, and the Danger Zone's confirm-delete Stimulus + button_to
  method/turbo_frame/route preserved 1:1 — presentation only. Danger
  Zone wrapped in Molecules::DangerZoneComponent (T1), mirroring the
  app-danger conversion pattern.
%>
<%= render "header", database: @database, active: :settings %>

<%# Linked Apps %>
<div class="mb-8" data-controller="slide-panel">
  <div class="flex items-center justify-between mb-3">
    <h2 class="font-headline text-base font-bold text-ink"><%= t("dashboard.databases.linked_apps") %></h2>
    <% if @available_apps.any? %>
      <button data-action="click->slide-panel#open" class="text-sm text-accent hover:underline cursor-pointer">+ Link app</button>
    <% end %>
  </div>

  <div class="border-1.5 border-ink bg-paper rounded-md overflow-hidden">
    <% if @linked_apps.any? %>
      <div class="divide-y divide-line">
        <% @linked_apps.each do |app| %>
          <div class="flex items-center justify-between px-5 py-3">
            <%= link_to app.name, dashboard_app_path(app), class: "text-sm text-ink hover:text-accent transition" %>
            <%= button_to "Unlink", unlink_dashboard_addon_path(@database, app_id: app.id), method: :post, data: { turbo_confirm: "Unlink #{app.name} from #{@database.name}?" }, class: "text-xs text-dim hover:text-danger transition cursor-pointer bg-transparent border-0" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-8 text-center text-sm text-dim">No apps linked yet.</div>
    <% end %>
  </div>

  <% if @available_apps.any? %>
    <%= render layout: "dashboard/shared/slide_panel", locals: { title: "Link App", subtitle: "Connect an app to #{@database.name}" } do %>
      <%= form_with(url: link_dashboard_addon_path(@database), method: :post, class: "space-y-4") do %>
        <div>
          <label class="block text-[10px] font-bold text-dim mb-1.5 uppercase tracking-widest">Application</label>
          <%= combobox_tag "app_id", @available_apps.map { |a| { value: a.id, label: a.name, description: a.server.name } }, placeholder: "Search apps…", required: true %>
        </div>
        <div class="flex items-center gap-2">
          <%= submit_tag "Link App", class: Atoms::ButtonComponent.new(variant: :primary, size: :md).classes %>
          <button type="button" data-action="click->slide-panel#close" class="<%= Atoms::ButtonComponent.new(variant: :outline, size: :md).classes %>">Cancel</button>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

<% unless @database.shared? %>
  <div class="mb-8">
    <h2 class="font-headline text-base font-bold text-ink mb-3">Sizing</h2>
    <% if Wokku.config.resource_builder? %>
      <%# Per-resource billing (spec 2026-09-24 §5.3): direct slider resize,
          replacing the legacy "go change your app's box" copy. %>
      <%= render Molecules::DiskUsageBannerComponent.new(record: @database) %>
      <div class="border-1.5 border-ink bg-paper rounded-md p-5">
        <%= form_with url: resize_dashboard_addon_path(@database), method: :patch, class: "space-y-4",
                       data: { turbo_confirm: "Containers will restart with the new size." } do %>
          <%= render Organisms::ResourceBuilderComponent.new(
                name: "",
                shape: @database.shape || Resources::Shape.round_up(
                  cpu: 0.25,
                  memory_mb: @database.service_tier&.spec&.dig("memory_mb").to_i,
                  disk_gb: @database.service_tier&.spec&.dig("storage_gb").to_i),
                presets: Resources::Shape::SERVICE_PRESETS.fetch(@database.service_type, Resources::Shape::PRESETS),
                disk: true, min_disk_gb: @database.disk_gb.to_i) %>
          <%= submit_tag "Resize", class: Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes %>
        <% end %>
      </div>
    <% else %>
    <div class="border-1.5 border-ink bg-paper rounded-md p-5 text-sm text-ink-soft">
      <p>Dedicated DB sizing follows your plan's box size. Change your app's box on the resources page, or upgrade your plan on
        <%= link_to "/dashboard/plan", (respond_to?(:dashboard_plan_path) ? dashboard_plan_path : "#"), class: "text-accent hover:underline" %>, to resize this database.</p>
    </div>
    <% end %>
  </div>
<% end %>

<%= render Molecules::DangerZoneComponent.new(
      title: "Danger zone",
      body: "All data is destroyed. Existing backups remain in your backup destination until they expire."
    ) do %>
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <p class="text-sm text-ink">
      Delete this <span class="font-bold"><%= @database.service_type %></span> add-on, <span class="font-bold"><%= @database.name %></span>.
    </p>
    <%= button_to "Delete this add-on", dashboard_addon_path(@database),
          method: :delete,
          form: {
            data: {
              controller: "confirm-delete",
              confirm_delete_name_value: @database.name,
              confirm_delete_impact_value: "This will permanently delete the #{@database.service_type} database #{@database.name} and ALL its data. Existing backups will remain in your backup destination until they expire.",
              confirm_delete_resource_value: "database"
            }
          },
          class: Atoms::ButtonComponent.new(variant: :danger, size: :md).classes %>
  </div>
<% end %>
