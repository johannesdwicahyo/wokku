<%# Single source of truth for an add-on rack row — rendered by
    Organisms::AddonsRackComponent and used as the Turbo Stream
    replace/insert target (DatabaseService#broadcast_status_change /
    #broadcast_card_insert / #broadcast_card_remove); dom_id stays the id. %>
<% grid = Organisms::AddonsRackComponent::GRID %>
<div id="<%= local_assigns[:row_id] || dom_id(addon) %>" data-rack-unit="<%= addon.name %>" class="border-t border-line first:border-t-0 hover:bg-white/[.025] transition-colors <%= 'bg-danger-soft' if addon.status == 'error' %>">
  <div class="grid <%= grid %> gap-4 items-center px-[18px] py-3.5">
    <%= render Atoms::StatusLightComponent.new(state: Organisms::AddonsRackComponent.light_state(addon.status), size: 10) %>
    <span class="min-w-0">
      <%= link_to addon.name, dashboard_addon_path(addon), data: { turbo_frame: "_top" }, class: "block font-medium truncate text-ink hover:underline" %>
      <span class="block lg:hidden truncate text-[12px] text-muted"><%= addon.service_type.to_s.titleize %> · <%= addon.size_label %></span>
    </span>
    <span class="hidden lg:block truncate font-mono text-[12px] text-muted"><%= addon.service_type.to_s.titleize %> · <%= addon.size_label %></span>
    <span class="hidden lg:block truncate text-[13px] text-ink-soft"><%= addon.app_records.any? ? addon.app_records.map(&:name).join(", ") : "—" %></span>
    <span class="hidden lg:block font-mono text-[12px] text-muted"><%= Organisms::AddonsRackComponent.backups_label(addon) %></span>
    <% if addon.status == "error" %>
      <div class="flex items-center justify-end gap-2">
        <%= button_to t("dashboard.databases.rack.retry"), retry_dashboard_addon_path(addon), method: :post,
              form: { data: { turbo_frame: "_top" } },
              class: Atoms::ButtonComponent.new(variant: :outline, size: :sm).classes %>
        <%= button_to t("dashboard.databases.rack.destroy"), dashboard_addon_path(addon), method: :delete,
              data: { turbo_confirm: t("dashboard.databases.rack.destroy_confirm", name: addon.name) },
              form: { data: { turbo_frame: "_top" } },
              class: Atoms::ButtonComponent.new(variant: :danger, size: :sm).classes %>
      </div>
    <% else %>
      <%= link_to "›", dashboard_addon_path(addon), data: { turbo_frame: "_top" }, "aria-label": t("dashboard.databases.rack.open", name: addon.name), class: "text-muted text-right hover:text-ink" %>
    <% end %>
  </div>
  <% if addon.status == "error" && addon.last_error.present? %>
    <div class="px-[18px] pb-3 text-[12px] text-bad-text font-mono break-all line-clamp-2"><%= addon.last_error %></div>
  <% end %>
</div>
