<%#
  Workspaces (schdl grid rollout, U4 Task 4). Real data, switch-session
  wiring, and the new-workspace slide-panel form preserved 1:1 —
  presentation only.
%>
<% content_for(:title, "Workspaces") %>

<div class="space-y-6" data-controller="slide-panel">
  <div class="flex items-center justify-between mb-5">
    <h1 class="font-headline text-2xl font-extrabold tracking-tight"><%= t("dashboard.workspaces.title", default: "Workspaces") %></h1>
    <%# Opens slide-panel modal; href stays as the no-JS fallback. %>
    <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, href: new_dashboard_workspace_path,
          data: { action: "click->slide-panel#open" }) do %>New workspace<% end %>
  </div>

  <div class="bg-paper border border-line rounded-md shadow-brutal overflow-hidden">
    <div class="divide-y divide-line">
      <% @workspaces.each do |ws| %>
        <% current = ws.id == current_team.id %>
        <div class="px-3.5 py-3 flex items-center gap-3 hover:bg-bg-deep transition-colors">
          <span class="w-[22px] h-[22px] border border-line rounded grid place-items-center font-extrabold text-[11px] bg-paper flex-shrink-0"><%= ws.name[0].upcase %></span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-sm font-semibold text-ink truncate"><%= ws.name %></span>
              <%= render Atoms::TagComponent.new(tone: :dim) do %><%= ws.kind %><% end %>
              <% if current %>
                <%= render Atoms::StatusPillComponent.new(label: "current", tone: :neutral) %>
              <% end %>
            </div>
            <p class="text-[12px] text-dim mt-0.5"><%= ws.plan&.name || "Free" %> · <span class="font-mono"><%= ws.slug %></span></p>
          </div>
          <% unless current %>
            <%= button_to "Switch", switch_dashboard_workspace_path(ws), method: :post,
                  class: Atoms::ButtonComponent.new(variant: :outline, size: :sm).classes + " flex-shrink-0" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render layout: "dashboard/shared/slide_panel",
             locals: { title: "New workspace", subtitle: (wokku_cloud? ? "Org teams require a paid plan" : nil), size: "lg" } do %>
    <%= render "form", workspace: @workspace || Team.new, paid_plans: @paid_plans || Plan.where(key: Dashboard::WorkspacesController::PAID_PLAN_KEYS).order(:price_idr) %>
  <% end %>
</div>
