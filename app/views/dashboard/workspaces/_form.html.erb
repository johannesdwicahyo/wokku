<%# Workspace creation form. Used by:
  *  /dashboard/workspaces/new (standalone page, no-JS fallback)
  *  /dashboard/workspaces slide-panel modal (default flow)
Both pass `workspace` + `paid_plans` locals. %>
<%= form_with url: dashboard_workspaces_path, method: :post, local: true,
              class: "space-y-5 font-mono text-sm" do |f| %>
  <% if flash[:alert] %>
    <div class="border border-danger bg-danger-soft px-4 py-2 text-danger text-xs">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <label class="block">
    <span class="text-[10px] text-dim uppercase tracking-widest">name</span>
    <%= f.text_field "team[name]", value: workspace.name, required: true, autofocus: true,
          class: "mt-1 w-full border border-dark-line bg-bg px-3 py-2 text-ink placeholder:text-dim" %>
  </label>

  <% if wokku_cloud? %>
  <fieldset class="space-y-2">
    <legend class="text-[10px] text-dim uppercase tracking-widest mb-2">plan</legend>
    <% paid_plans.each do |plan| %>
      <label class="flex items-start gap-3 border border-rule-soft px-3 py-2 cursor-pointer hover:border-ink">
        <%= f.radio_button "team[plan_id]", plan.id, required: true, class: "mt-1" %>
        <div class="flex-1">
          <div class="text-ink font-semibold"><%= plan.name %></div>
          <div class="text-[11px] text-dim mt-0.5">
            Rp<%= ActiveSupport::NumberHelper.number_to_delimited(plan.price_idr.to_i, delimiter: ".") %>/mo
            · <%= plan.seats_included %> seat<%= "s" unless plan.seats_included == 1 %> included
          </div>
        </div>
      </label>
    <% end %>
  </fieldset>
  <% end %>

  <div class="flex justify-between gap-3 pt-2">
    <%# Plain link: works both in the slide panel and on standalone /new. %>
    <%= link_to "cancel", dashboard_workspaces_path,
          data: { action: "slide-panel#close:prevent", turbo_frame: "_top" },
          class: "px-4 py-2 border border-rule-soft text-dim font-mono text-[11px] uppercase tracking-widest hover:text-ink" %>
    <button type="submit" class="px-4 py-2 border border-live bg-live text-[#03140A] hover:bg-live-hover font-mono text-[11px] uppercase tracking-widest">
      create workspace
    </button>
  </div>
<% end %>
