<div class="border-1.5 border-ink bg-paper overflow-hidden mb-6">
  <div class="px-6 py-4 border-b border-rule-soft">
    <h2 class="font-mono text-base font-semibold text-ink"># container_size</h2>
    <p class="font-mono text-sm text-dim mt-1">// choose the resource allocation for your containers</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4 p-6">
    <% @dyno_tiers.each do |tier| %>
      <% is_current = @current_allocation&.dyno_tier_id == tier.id %>
      <div class="relative border-1.5 p-4 font-mono <%= is_current ? 'border-accent bg-accent-soft' : 'border-ink bg-paper hover:bg-bg-deep' %> transition">
        <% if is_current %>
          <div class="absolute -top-2 right-3">
            <span class="text-[10px] font-semibold uppercase tracking-widest bg-accent text-bg px-1.5 py-0.5">current</span>
          </div>
        <% end %>

        <h3 class="text-sm font-bold text-ink capitalize"><%= tier.name %></h3>
        <div class="mt-2 space-y-1">
          <p class="text-xs text-dim"><span class="text-ink font-bold"><%= tier.memory_mb >= 1024 ? "#{tier.memory_mb / 1024} GB" : "#{tier.memory_mb} MB" %></span> RAM</p>
          <p class="text-xs text-dim">
            <% if tier.shared_vcpu? %><span class="text-ink font-bold">Shared</span> vCPU<% else %><span class="text-ink font-bold"><%= tier.cpu_shares %></span> vCPU<% end %>
          </p>
          <% if tier.respond_to?(:storage_mb) && tier.storage_mb > 0 %>
            <p class="text-xs text-dim"><span class="text-ink font-bold"><%= tier.storage_mb >= 1024 ? "#{tier.storage_mb / 1024} GB" : "#{tier.storage_mb} MB" %></span> storage</p>
          <% elsif tier.respond_to?(:storage_mb) %>
            <p class="text-xs text-dim">No storage</p>
          <% end %>
          <% if tier.respond_to?(:max_per_user) && tier.max_per_user.present? %>
            <p class="text-xs text-dim">Max <%= tier.max_per_user %> per user</p>
          <% end %>
        </div>

        <div class="mt-3 border-t border-rule-soft pt-3">
          <% if tier.free? %>
            <p class="text-sm font-bold text-ink">Free</p>
          <% else %>
            <p class="text-sm font-bold text-ink"><% if respond_to?(:format_usd_for_user) %><%= format_usd_for_user(tier.monthly_price_dollars) %><span class="text-xs text-dim font-normal"><%= price_period(Wokku::LaunchMode.idr_only? ? "idr" : nil) %></span><% else %>—<% end %></p>
          <% end %>
        </div>

        <% unless is_current %>
          <%= button_to "Select",
                change_tier_dashboard_app_scaling_path(@app),
                params: { dyno_tier_id: tier.id, process_type: "web" },
                method: :post,
                data: { turbo_confirm: "Change container to #{tier.name} (#{tier.memory_mb}MB)?" },
                class: "mt-3 w-full text-center px-3 py-1.5 text-xs font-semibold border-1.5 border-ink text-ink hover:bg-bg-deep transition cursor-pointer" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
