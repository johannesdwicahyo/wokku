<%# Backdrop — slide-panel targets/actions preserved 1:1. %>
<div data-slide-panel-target="backdrop"
     data-action="click->slide-panel#backdropClick"
     class="hidden fixed inset-0 z-40 bg-black/70 opacity-0 transition-opacity duration-300">
</div>
<%# Panel %>
<%
  size = local_assigns[:size] || "md"
  width_class = { "md" => "max-w-md", "lg" => "max-w-xl", "xl" => "max-w-2xl" }[size.to_s] || "max-w-md"
%>
<div data-slide-panel-target="panel"
     class="fixed inset-y-0 right-0 z-50 w-full <%= width_class %> bg-paper border-l-1.5 border-ink shadow-brutal-lg transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto">
  <%# chromeless: true — skip the title header bar. Used by the record
      panel, which renders its own header (app name/status/close) inside
      the yielded turbo-frame content instead. %>
  <% unless local_assigns[:chromeless] %>
    <div class="flex items-center justify-between px-6 py-4 border-b-1.5 border-ink">
      <div>
        <h2 class="font-headline font-extrabold text-base"><%= title %></h2>
        <% if local_assigns[:subtitle] %>
          <p class="text-[11.5px] text-dim mt-0.5"><%= subtitle %></p>
        <% end %>
      </div>
      <button data-action="click->slide-panel#close" class="text-dim hover:text-ink transition cursor-pointer p-1 text-lg" aria-label="Close panel">✕</button>
    </div>
  <% end %>
  <div class="px-6 py-5">
    <%= yield %>
  </div>
</div>
