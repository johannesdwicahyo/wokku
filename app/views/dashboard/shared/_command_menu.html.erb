<%# ⌘K command menu (U6). Hidden until opened via global keydown. Nav items
    + this app's actions come from data-values; app results stream from the
    existing /dashboard/apps/search endpoint. %>
<%
  nav_commands = sidebar_groups.flat_map { |g| g[:items] }.map { |i| { label: i[:label], href: i[:href] } }
  app_ctx = if defined?(@app) && @app.respond_to?(:persisted?) && @app.persisted?
    {
      name:    @app.name,
      open:    dashboard_app_path(@app),
      deploy:  deploy_dashboard_app_releases_path(@app),
      restart: restart_dashboard_app_path(@app),
      stop:    stop_dashboard_app_path(@app)
    }
  else
    {}
  end
  cmd_labels = {
    nav:         t("console.command.nav"),
    apps:        t("console.command.apps"),
    actions:     t("console.command.actions"),
    placeholder: t("console.command.placeholder"),
    empty:       t("console.command.empty")
  }
%>
<div data-controller="command-menu"
     data-command-menu-nav-value="<%= nav_commands.to_json %>"
     data-command-menu-search-url-value="<%= search_dashboard_apps_path %>"
     data-command-menu-app-value="<%= app_ctx.to_json %>"
     data-command-menu-labels-value="<%= cmd_labels.to_json %>">
  <div data-command-menu-target="backdrop"
       data-action="click->command-menu#backdropClick"
       class="hidden fixed inset-0 bg-black/70 z-[70]"></div>
  <div data-command-menu-target="dialog"
       role="dialog" aria-modal="true" aria-label="<%= t("console.command.placeholder") %>"
       class="hidden fixed left-1/2 top-24 -translate-x-1/2 w-full max-w-lg z-[71] bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-hidden">
    <div class="flex items-center gap-2.5 px-4 py-3 border-b border-line">
      <span class="w-4 h-4 text-dim [&>svg]:w-4 [&>svg]:h-4"><%= render "shared/icons/search" %></span>
      <input type="text"
             data-command-menu-target="input"
             data-action="input->command-menu#onInput keydown->command-menu#navKeys"
             placeholder="<%= t("console.command.placeholder") %>"
             class="flex-1 bg-transparent border-0 outline-none text-sm text-ink placeholder:text-dim p-0"
             aria-label="<%= t("console.command.placeholder") %>">
      <kbd class="text-[10px] text-dim border border-line rounded px-1">esc</kbd>
    </div>
    <ul data-command-menu-target="list" role="listbox" class="max-h-80 overflow-y-auto py-1"></ul>
  </div>
</div>
