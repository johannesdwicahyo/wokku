<%# Renders any flash hash entries as toasts inside the layout's
    #toasts stack. Real-time notifications from background jobs append
    additional toasts via Turbo Stream broadcast — both share the same
    toast partial so the visual is consistent. %>
<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <%= render "dashboard/shared/toast", level: type.to_s, message: message %>
<% end %>
