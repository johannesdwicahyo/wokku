<%# Renders the app.json env-schema status panel. Hidden when the
    user's app.json has no env block (schema.required + schema.recommended
    both empty). Tone: green if all required set, red if any missing
    required, otherwise yellow (recommended missing only). %>
<% return if schema.required.empty? && schema.recommended.empty? %>

<% tone, tone_label = if !schema.valid?
                        [:danger, "Missing required"]
                      elsif schema.has_warnings?
                        [:warn, "Missing recommended"]
                      else
                        [:success, "All set"]
                      end %>

<div class="bg-paper border-1.5 border-ink rounded-md mb-6 overflow-hidden" data-testid="env-schema-panel">
  <div class="px-6 py-4 border-b border-line flex items-center justify-between gap-3 flex-wrap">
    <div>
      <h2 class="font-headline text-base font-bold text-ink">app.json env</h2>
      <p class="text-xs text-dim mt-1">
        <%= schema.required_set %>/<%= schema.total_required %> required vars set
        <% if schema.has_warnings? %>· <%= schema.missing_recommended.size %> recommended unset<% end %>
      </p>
    </div>
    <%= render Atoms::StatusPillComponent.new(label: tone_label, tone: tone) %>
  </div>

  <% if schema.missing_required.any? %>
    <div class="px-6 py-4 border-b border-line">
      <p class="text-xs text-dim mb-2 font-bold uppercase tracking-widest">Required, missing</p>
      <ul class="space-y-2">
        <% schema.missing_required.each do |entry| %>
          <li class="text-sm border-1.5 border-danger bg-danger-soft rounded-md px-3 py-2 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <span class="text-ink font-bold font-mono"><%= entry[:key] %></span>
              <% if entry[:description].present? %>
                <p class="text-dim text-xs mt-1 truncate"><%= entry[:description] %></p>
              <% end %>
            </div>
            <% if entry[:generator].present? %>
              <span class="text-[10px] uppercase tracking-widest text-dim flex-shrink-0">Generated</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if schema.missing_recommended.any? %>
    <div class="px-6 py-4">
      <p class="text-xs text-dim mb-2 font-bold uppercase tracking-widest">Recommended, unset</p>
      <ul class="space-y-2">
        <% schema.missing_recommended.each do |entry| %>
          <li class="text-sm border border-line bg-paper rounded-md px-3 py-2">
            <span class="text-ink font-mono"><%= entry[:key] %></span>
            <% if entry[:description].present? %>
              <span class="text-dim text-xs ml-2"><%= entry[:description] %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
