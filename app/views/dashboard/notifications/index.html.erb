<%#
  Brutalist notifications (P5). Wrapped in SettingsTabsComponent
  (Phase 3 backlog #12) so it shares chrome with Profile / Security /
  Billing.
%>
<%= render Organisms::SettingsTabsComponent.new(active_tab: :notifications) do %>

<div data-controller="slide-panel">
<div class="flex items-center justify-between gap-3 flex-wrap mb-6">
  <div>
    <h1 class="font-mono text-3xl md:text-4xl font-semibold tracking-tighter text-ink m-0"><span class="text-dim"># </span><%= t("dashboard.notifications.title") %></h1>
    <p class="font-mono text-xs text-dim mt-2">// get notified about deploys, failures, and other events</p>
  </div>
  <button data-action="click->slide-panel#open" class="inline-flex items-center px-4 py-2 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer">
    + <%= t("dashboard.notifications.add_rule") %>
  </button>
</div>

<%# Existing Rules %>
<div class="border-1.5 border-ink bg-paper mb-6">
  <div class="px-6 py-4 border-b border-rule-soft">
    <h2 class="font-mono text-base font-semibold text-ink"># <%= t("dashboard.notifications.notification_rules") %></h2>
  </div>

  <% if @notifications.any? %>
    <div class="divide-y divide-rule-soft">
      <% @notifications.each do |notification| %>
        <div class="px-6 py-4 flex items-center justify-between gap-3 flex-wrap hover:bg-bg-deep transition-colors font-mono">
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1.5"
                    data-controller="motion--status-pulse"
                    data-motion--status-pulse-status-value="running">
                <span class="wk-dot" style="background: var(--color-success)"></span>
                <span class="text-sm font-semibold text-ink capitalize"><%= notification.channel %></span>
              </span>
              <% if notification.app_record %>
                <span class="text-xs text-dim border border-rule-soft px-1.5 py-0.5"><%= notification.app_record.name %></span>
              <% else %>
                <span class="text-xs text-dim">all apps</span>
              <% end %>
            </div>
            <div class="flex items-center gap-2 mt-0.5 flex-wrap">
              <% (notification.events || []).each do |event| %>
                <span class="text-xs text-ink-soft"><%= event.humanize %></span>
              <% end %>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <%= button_to "test", test_dashboard_notification_path(notification), method: :post, class: "text-xs text-accent hover:underline transition bg-transparent border-0 cursor-pointer" %>
            <%= link_to "remove", dashboard_notification_path(notification), data: { turbo_method: :delete, turbo_confirm: "Remove this notification rule?" }, class: "text-xs text-dim hover:text-danger transition" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-4">
      <%= render Organisms::EmptyStateComponent.new(
            headline: "No notification rules yet.",
            body: "Add a rule below to get pinged when deploys, failures, or other events happen."
          ) %>
    </div>
  <% end %>
</div>

<%= render layout: "dashboard/shared/slide_panel", locals: { title: t("dashboard.notifications.add_rule"), subtitle: "Choose channel, app, and events", size: "lg" } do %>
  <%= form_with(model: @notification, url: dashboard_notifications_path, class: "space-y-4") do |f| %>
    <%# Wraps the channel combobox AND the channel-config sections so the
        notification-config Stimulus controller can hear `change` events
        bubbling up from the combobox's hidden input. %>
    <div class="space-y-4" data-controller="notification-config" data-action="change->notification-config#toggle">
      <div>
        <label class="block font-mono text-xs text-dim uppercase tracking-widest mb-1">Channel</label>
        <%= combobox_tag "notification[channel]", [
          ["Email", "email"],
          ["Slack", "slack"],
          ["Discord", "discord"],
          ["Telegram", "telegram"],
          ["Webhook", "webhook"]
        ], placeholder: "Select channel" %>
      </div>

      <%# Channel-specific config fields %>
      <div>
        <label class="block font-mono text-xs text-dim uppercase tracking-widest mb-1">Channel Config</label>

        <%# Email %>
        <div data-notification-config-target="email" class="hidden">
          <div class="border-1.5 border-ink bg-bg p-3 space-y-2 font-mono">
            <p class="text-xs text-ink-soft">Notifications will be sent to <span class="font-bold text-ink"><%= current_user.email %></span></p>
            <p class="text-[10px] text-dim">No additional setup needed.</p>
          </div>
        </div>

        <%# Slack %>
        <div data-notification-config-target="slack" class="hidden space-y-2">
          <input type="text" name="notification[config][url]" placeholder="https://hooks.slack.com/services/T00.../B00.../xxxx" class="w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent">
          <div class="border-1.5 border-ink bg-bg p-3 font-mono">
            <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-1.5">Setup Guide</p>
            <ol class="text-[11px] text-dim space-y-1 list-decimal list-inside">
              <li>Open your Slack workspace and go to <span class="text-ink-soft">Apps</span></li>
              <li>Search for <span class="font-bold text-ink-soft">Incoming Webhooks</span> and install it</li>
              <li>Click <span class="font-bold text-ink-soft">Add New Webhook to Workspace</span></li>
              <li>Choose a channel (e.g. #deploys) and authorize</li>
              <li>Copy the <span class="font-bold text-ink-soft">Webhook URL</span> and paste it above</li>
            </ol>
          </div>
        </div>

        <%# Discord %>
        <div data-notification-config-target="discord" class="hidden space-y-2">
          <input type="text" name="notification[config][url]" placeholder="https://discord.com/api/webhooks/1234.../abcd..." class="w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent">
          <div class="border-1.5 border-ink bg-bg p-3 font-mono">
            <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-1.5">Setup Guide</p>
            <ol class="text-[11px] text-dim space-y-1 list-decimal list-inside">
              <li>Open your Discord server and go to <span class="text-ink-soft">Server Settings > Integrations</span></li>
              <li>Click <span class="font-bold text-ink-soft">Webhooks > New Webhook</span></li>
              <li>Name it (e.g. "Wokku") and choose a channel</li>
              <li>Click <span class="font-bold text-ink-soft">Copy Webhook URL</span> and paste it above</li>
            </ol>
          </div>
        </div>

        <%# Telegram %>
        <div data-notification-config-target="telegram" class="hidden space-y-2">
          <input type="text" name="notification[config][bot_token]" placeholder="123456:ABC-DEF1234..." class="w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent">
          <input type="text" name="notification[config][chat_id]" placeholder="-1001234567890" class="w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent">
          <div class="border-1.5 border-ink bg-bg p-3 font-mono">
            <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-1.5">Setup Guide</p>
            <ol class="text-[11px] text-dim space-y-1 list-decimal list-inside">
              <li>Open Telegram and message <a href="https://t.me/BotFather" class="text-accent hover:underline" target="_blank">@BotFather</a></li>
              <li>Send <span class="text-ink-soft">/newbot</span>, follow the prompts, and copy the <span class="font-bold text-ink-soft">Bot Token</span></li>
              <li>Add the bot to your group or channel</li>
              <li>To find your <span class="font-bold text-ink-soft">Chat ID</span>: message <a href="https://t.me/userinfobot" class="text-accent hover:underline" target="_blank">@userinfobot</a>, or for groups forward a message to <a href="https://t.me/JsonDumpBot" class="text-accent hover:underline" target="_blank">@JsonDumpBot</a></li>
              <li>Paste both values in the fields above</li>
            </ol>
          </div>
        </div>

        <%# Webhook %>
        <div data-notification-config-target="webhook" class="hidden space-y-2">
          <input type="text" name="notification[config][url]" placeholder="https://example.com/webhooks/wokku" class="w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent">
          <div class="border-1.5 border-ink bg-bg p-3 font-mono">
            <p class="text-[10px] text-dim uppercase tracking-widest font-bold mb-1.5">Setup Guide</p>
            <p class="text-[11px] text-dim mb-2">We'll send a <span class="text-ink-soft">POST</span> request with a JSON body on each event:</p>
            <code class="block text-[10px] text-ink-soft bg-paper border border-rule-soft p-2 whitespace-pre">{ "event": "deploy_succeeded",
  "app": "my-app",
  "timestamp": "2026-..." }</code>
          </div>
        </div>
      </div>
      <div>
        <label class="block font-mono text-xs text-dim uppercase tracking-widest mb-1">App (optional)</label>
        <%= combobox_tag "notification[app_record_id]", @apps.map { |a| { value: a.id, label: a.name, description: a.server.name } }, placeholder: "All apps" %>
      </div>
      <div>
        <label class="block font-mono text-xs text-dim uppercase tracking-widest mb-1">Events</label>
        <div class="space-y-1.5 mt-1 font-mono">
          <% [ "deploy_started", "deploy_succeeded", "deploy_failed", "app_crashed", "backup_failed", "domain_added", "app_created", "app_deleted", "daily_debit_summary" ].each do |event| %>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="notification[events][]" value="<%= event %>" class="border-1.5 border-ink text-accent focus:ring-accent">
              <span class="text-xs text-ink-soft"><%= event.humanize %></span>
            </label>
          <% end %>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-3 pt-2">
      <%= f.submit "Add Rule", class: "px-4 py-2 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer" %>
      <button type="button" data-action="click->slide-panel#close" class="font-mono text-sm text-dim hover:text-ink transition cursor-pointer">Cancel</button>
    </div>
  <% end %>
<% end %>
</div>

<% end %>
