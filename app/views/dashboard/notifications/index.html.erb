<%#
  Notifications (schdl grid rollout, U4 Task 4). Wrapped in
  SettingsTabsComponent so it shares chrome with Profile / Security /
  Billing — no R1 page header, a compact section heading instead. Real
  data, `notification-config` Stimulus wiring, and slide-panel form
  preserved 1:1 — presentation only.
%>
<%= render Organisms::SettingsTabsComponent.new(active_tab: :notifications, show_admin: current_user&.admin?) do %>

<div data-controller="slide-panel">
  <div class="flex items-center justify-between gap-3 flex-wrap mb-5">
    <div>
      <h2 class="text-base font-bold text-ink"><%= t("dashboard.notifications.title") %></h2>
      <p class="text-[12px] text-dim mt-0.5">Get notified about deploys, failures, and other events.</p>
    </div>
    <%= render Atoms::ButtonComponent.new(variant: :primary, size: :sm, data: { action: "click->slide-panel#open" }) do %>+ <%= t("dashboard.notifications.add_rule") %><% end %>
  </div>

  <%# Existing rules %>
  <% if @notifications.any? %>
    <div class="bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-hidden">
      <div class="divide-y divide-line">
        <% @notifications.each do |notification| %>
          <div class="px-3.5 py-3 flex items-center justify-between gap-3 flex-wrap hover:bg-bg-deep transition-colors">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5"
                      data-controller="motion--status-pulse"
                      data-motion--status-pulse-status-value="running">
                  <span class="wk-dot" style="background: var(--color-success)"></span>
                  <span class="text-sm font-semibold text-ink capitalize"><%= notification.channel %></span>
                </span>
                <% if notification.app_record %>
                  <%= render Atoms::TagComponent.new(tone: :dim) do %><%= notification.app_record.name %><% end %>
                <% else %>
                  <%= render Atoms::TagComponent.new(tone: :dim) do %>All apps<% end %>
                <% end %>
              </div>
              <div class="flex items-center gap-2 mt-1 flex-wrap">
                <% (notification.events || []).each do |event| %>
                  <span class="text-[11.5px] text-ink-soft"><%= event.humanize %></span>
                <% end %>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <%= button_to "Test", test_dashboard_notification_path(notification), method: :post,
                    class: Atoms::ButtonComponent.new(variant: :ghost, size: :sm).classes %>
              <%= link_to "Remove", dashboard_notification_path(notification),
                    data: { turbo_method: :delete, turbo_confirm: "Remove this notification rule?" },
                    class: Atoms::ButtonComponent.new(variant: :ghost, size: :sm).classes %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render Organisms::EmptyStateComponent.new(
          headline: "No notification rules yet.",
          body: "Add a rule below to get pinged when deploys, failures, or other events happen."
        ) %>
  <% end %>

  <%= render layout: "dashboard/shared/slide_panel", locals: { title: t("dashboard.notifications.add_rule"), subtitle: "Choose channel, app, and events", size: "lg" } do %>
    <%= form_with(model: @notification, url: dashboard_notifications_path, class: "space-y-4") do |f| %>
      <%# Wraps the channel combobox AND the channel-config sections so the
          notification-config Stimulus controller can hear `change` events
          bubbling up from the combobox's hidden input. %>
      <div class="space-y-4" data-controller="notification-config" data-action="change->notification-config#toggle">
        <div>
          <label class="block text-xs font-semibold text-ink-soft mb-1">Channel</label>
          <%= combobox_tag "notification[channel]", [
            ["Email", "email"],
            ["Slack", "slack"],
            ["Discord", "discord"],
            ["Telegram", "telegram"],
            ["Webhook", "webhook"]
          ], placeholder: "Select channel" %>
        </div>

        <%# Channel-specific config fields %>
        <div>
          <label class="block text-xs font-semibold text-ink-soft mb-1">Channel config</label>

          <%# Email %>
          <div data-notification-config-target="email" class="hidden">
            <div class="border-1.5 border-ink bg-bg rounded-md p-3 space-y-2">
              <p class="text-[12.5px] text-ink-soft">Notifications will be sent to <span class="font-semibold text-ink"><%= current_user.email %></span></p>
              <p class="text-[11px] text-dim">No additional setup needed.</p>
            </div>
          </div>

          <%# Slack %>
          <div data-notification-config-target="slack" class="hidden space-y-2">
            <input type="text" name="notification[config][url]" placeholder="https://hooks.slack.com/services/T00.../B00.../xxxx" class="w-full bg-paper border-1.5 border-ink rounded-md px-3 py-2 text-sm placeholder-dim focus:shadow-brutal-sm">
            <div class="border-1.5 border-ink bg-bg rounded-md p-3">
              <p class="text-[10.5px] text-dim uppercase tracking-[.06em] font-bold mb-1.5">Setup guide</p>
              <ol class="text-[11.5px] text-dim space-y-1 list-decimal list-inside">
                <li>Open your Slack workspace and go to <span class="text-ink-soft">Apps</span></li>
                <li>Search for <span class="font-semibold text-ink-soft">Incoming Webhooks</span> and install it</li>
                <li>Click <span class="font-semibold text-ink-soft">Add New Webhook to Workspace</span></li>
                <li>Choose a channel (e.g. #deploys) and authorize</li>
                <li>Copy the <span class="font-semibold text-ink-soft">Webhook URL</span> and paste it above</li>
              </ol>
            </div>
          </div>

          <%# Discord %>
          <div data-notification-config-target="discord" class="hidden space-y-2">
            <input type="text" name="notification[config][url]" placeholder="https://discord.com/api/webhooks/1234.../abcd..." class="w-full bg-paper border-1.5 border-ink rounded-md px-3 py-2 text-sm placeholder-dim focus:shadow-brutal-sm">
            <div class="border-1.5 border-ink bg-bg rounded-md p-3">
              <p class="text-[10.5px] text-dim uppercase tracking-[.06em] font-bold mb-1.5">Setup guide</p>
              <ol class="text-[11.5px] text-dim space-y-1 list-decimal list-inside">
                <li>Open your Discord server and go to <span class="text-ink-soft">Server Settings > Integrations</span></li>
                <li>Click <span class="font-semibold text-ink-soft">Webhooks > New Webhook</span></li>
                <li>Name it (e.g. "Wokku") and choose a channel</li>
                <li>Click <span class="font-semibold text-ink-soft">Copy Webhook URL</span> and paste it above</li>
              </ol>
            </div>
          </div>

          <%# Telegram %>
          <div data-notification-config-target="telegram" class="hidden space-y-2">
            <input type="text" name="notification[config][bot_token]" placeholder="123456:ABC-DEF1234..." class="w-full bg-paper border-1.5 border-ink rounded-md px-3 py-2 text-sm placeholder-dim focus:shadow-brutal-sm">
            <input type="text" name="notification[config][chat_id]" placeholder="-1001234567890" class="w-full bg-paper border-1.5 border-ink rounded-md px-3 py-2 text-sm placeholder-dim focus:shadow-brutal-sm">
            <div class="border-1.5 border-ink bg-bg rounded-md p-3">
              <p class="text-[10.5px] text-dim uppercase tracking-[.06em] font-bold mb-1.5">Setup guide</p>
              <ol class="text-[11.5px] text-dim space-y-1 list-decimal list-inside">
                <li>Open Telegram and message <a href="https://t.me/BotFather" class="text-accent hover:underline" target="_blank">@BotFather</a></li>
                <li>Send <span class="text-ink-soft">/newbot</span>, follow the prompts, and copy the <span class="font-semibold text-ink-soft">Bot Token</span></li>
                <li>Add the bot to your group or channel</li>
                <li>To find your <span class="font-semibold text-ink-soft">Chat ID</span>: message <a href="https://t.me/userinfobot" class="text-accent hover:underline" target="_blank">@userinfobot</a>, or for groups forward a message to <a href="https://t.me/JsonDumpBot" class="text-accent hover:underline" target="_blank">@JsonDumpBot</a></li>
                <li>Paste both values in the fields above</li>
              </ol>
            </div>
          </div>

          <%# Webhook %>
          <div data-notification-config-target="webhook" class="hidden space-y-2">
            <input type="text" name="notification[config][url]" placeholder="https://example.com/webhooks/wokku" class="w-full bg-paper border-1.5 border-ink rounded-md px-3 py-2 text-sm placeholder-dim focus:shadow-brutal-sm">
            <div class="border-1.5 border-ink bg-bg rounded-md p-3">
              <p class="text-[10.5px] text-dim uppercase tracking-[.06em] font-bold mb-1.5">Setup guide</p>
              <p class="text-[11.5px] text-dim mb-2">We'll send a <span class="text-ink-soft">POST</span> request with a JSON body on each event:</p>
              <code class="block text-[10.5px] text-ink-soft bg-paper border border-line rounded p-2 whitespace-pre">{ "event": "deploy_succeeded",
  "app": "my-app",
  "timestamp": "2026-..." }</code>
            </div>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-ink-soft mb-1">App (optional)</label>
          <%= combobox_tag "notification[app_record_id]", @apps.map { |a| { value: a.id, label: a.name, description: a.server.name } }, placeholder: "All apps" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-ink-soft mb-1">Events</label>
          <div class="space-y-1.5 mt-1">
            <% [ "deploy_started", "deploy_succeeded", "deploy_failed", "app_crashed", "app_auto_stopped", "app_down", "app_recovered", "backup_failed", "domain_added", "app_created", "app_deleted", "daily_debit_summary", "scheduled_task_failing", "scheduled_task_recovered" ].each do |event| %>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="notification[events][]" value="<%= event %>" class="border-1.5 border-ink text-accent focus:ring-accent">
                <span class="text-xs text-ink-soft"><%= event == "app_down" ? "App down (uptime check)" : event == "app_recovered" ? "App recovered" : event == "scheduled_task_failing" ? "Scheduled task failing (3× in a row)" : event == "scheduled_task_recovered" ? "Scheduled task recovered" : event.humanize %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Add rule", class: Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes %>
        <button type="button" data-action="click->slide-panel#close" class="<%= Atoms::ButtonComponent.new(variant: :ghost, size: :sm).classes %>">Cancel</button>
      </div>
    <% end %>
  <% end %>
</div>

<% end %>
