<%#
  Renders inside turbo_frame "ssh_keys". Shows the list of keys plus an
  "Add SSH key" button that opens a slide-panel drawer with the form.
  schdl (U5 Task 7) — slide-panel auto-open, turbo_frame data, and
  form_with create wiring preserved 1:1. Fingerprints stay mono (data).

  On create error the server re-renders this partial with `key.errors.any?`
  true — we auto-open the drawer in that case via data-slide-panel-auto-open.
%>
<%
  auto_open = local_assigns[:key] && key && key.errors.any?
%>
<div data-controller="slide-panel"
     <%= auto_open ? "data-slide-panel-auto-open-value=true" : "" %>>

  <div class="flex items-center justify-end mb-3">
    <button data-action="click->slide-panel#open" class="<%= Atoms::ButtonComponent.new(variant: :outline, size: :sm).classes %>">+ Add key</button>
  </div>

  <%# Key list %>
  <% if keys.any? %>
    <div class="space-y-2">
      <% keys.each do |k| %>
        <div class="flex items-center justify-between border border-line bg-bg rounded-md px-3 py-2 gap-3">
          <div class="min-w-0 flex-1">
            <span class="text-xs font-semibold text-ink"><%= k.name %></span>
            <span class="block text-[11px] text-dim truncate font-mono">SHA256:<%= k.fingerprint.first(16) %>…</span>
            <span class="text-[11px] text-dim">Added <%= time_ago(k.created_at) %></span>
          </div>
          <%= button_to dashboard_ssh_key_path(k), method: :delete,
              class: "text-xs font-semibold text-dim hover:text-danger transition shrink-0 bg-transparent border-0 cursor-pointer",
              data: { turbo_frame: "ssh_keys", turbo_confirm: "Remove this SSH key?" } do %>
            Remove
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-xs text-dim text-center py-2"><%= t("sweep.no_keys") %></p>
  <% end %>

  <%= render layout: "dashboard/shared/slide_panel", locals: { title: t("sweep.add_ssh_key"), subtitle: (AppRecord.git_gateway_host ? t("sweep.paste_ssh_push") : t("sweep.paste_ssh")) } do %>
    <% if local_assigns[:key] && key && key.errors.any? %>
      <div class="border border-danger bg-danger-soft rounded-md p-3 mb-4">
        <p class="text-xs text-danger font-bold mb-1">Couldn't add key</p>
        <ul class="text-[11px] text-danger list-disc list-inside">
          <% key.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: dashboard_ssh_keys_path, method: :post, scope: :ssh_public_key,
                  class: "space-y-3", data: { turbo_frame: "ssh_keys" } do |f| %>
      <div>
        <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t("sweep.name") %></label>
        <input type="text" name="ssh_public_key[name]" placeholder="e.g. laptop" required autofocus
               class="w-full bg-paper border border-line-strong rounded-md px-3 py-2 text-sm text-ink placeholder-dim focus:outline-none focus:shadow-brutal-sm">
      </div>
      <div>
        <label class="block text-xs font-semibold text-ink-soft mb-1"><%= t("sweep.public_key") %></label>
        <textarea name="ssh_public_key[public_key]" placeholder="ssh-ed25519 AAAA... user@host" required rows="5"
                  class="w-full bg-paper border border-line-strong rounded-md px-3 py-2 font-mono text-xs text-ink placeholder-dim focus:outline-none focus:shadow-brutal-sm"></textarea>
        <p class="text-[11px] text-dim mt-1"><%= t("sweep.paste_contents_html", path: '<code class="font-mono text-ink-soft">~/.ssh/id_ed25519.pub</code>'.html_safe) %></p>
      </div>
      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Add key", class: Atoms::ButtonComponent.new(variant: :primary, size: :md).classes %>
        <button type="button" data-action="click->slide-panel#close" class="<%= Atoms::ButtonComponent.new(variant: :ghost, size: :md).classes %>"><%= t("common.cancel") %></button>
      </div>
    <% end %>
  <% end %>
</div>
