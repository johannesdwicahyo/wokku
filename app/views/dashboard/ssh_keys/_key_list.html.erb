<%#
  Renders inside turbo_frame "ssh_keys". Shows the list of keys plus an
  "Add SSH key" button that opens a slide-panel drawer with the form.
  Brutalist repaint (P5) — slide-panel auto-open, turbo_frame data,
  and form_with create wiring preserved 1:1.

  On create error the server re-renders this partial with `key.errors.any?`
  true — we auto-open the drawer in that case via data-slide-panel-auto-open.
%>
<%
  auto_open = local_assigns[:key] && key && key.errors.any?
%>
<div data-controller="slide-panel"
     <%= auto_open ? "data-slide-panel-auto-open-value=true" : "" %>>

  <div class="flex items-center justify-end mb-3">
    <button data-action="click->slide-panel#open" class="inline-flex items-center px-3 py-1.5 font-mono text-xs text-ink border-1.5 border-ink bg-paper hover:bg-bg-deep transition-colors cursor-pointer">+ add_key</button>
  </div>

  <%# Key list %>
  <% if keys.any? %>
    <div class="space-y-2">
      <% keys.each do |k| %>
        <div class="flex items-center justify-between border-1.5 border-ink bg-bg px-3 py-2 gap-3 font-mono">
          <div class="min-w-0 flex-1">
            <span class="text-xs font-semibold text-ink"><%= k.name %></span>
            <span class="block text-[10px] text-dim truncate">SHA256:<%= k.fingerprint.first(16) %>…</span>
            <span class="text-[10px] text-dim">Added <%= time_ago_in_words(k.created_at) %> ago</span>
          </div>
          <%= button_to dashboard_ssh_key_path(k), method: :delete,
              class: "text-[10px] text-danger hover:underline font-bold shrink-0 bg-transparent border-0 cursor-pointer",
              data: { turbo_frame: "ssh_keys", turbo_confirm: "Remove this SSH key?" } do %>
            remove
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="font-mono text-xs text-dim text-center py-2">// no keys yet — add one to enable <code>git push</code></p>
  <% end %>

  <%= render layout: "dashboard/shared/slide_panel", locals: { title: "Add SSH Key", subtitle: "Paste your public key to enable git push" } do %>
    <% if local_assigns[:key] && key && key.errors.any? %>
      <div class="border-1.5 border-danger bg-danger-soft p-3 mb-4">
        <p class="font-mono text-xs text-danger font-bold mb-1">Couldn't add key</p>
        <ul class="font-mono text-[11px] text-danger list-disc list-inside">
          <% key.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: dashboard_ssh_keys_path, method: :post, scope: :ssh_public_key,
                  class: "space-y-3", data: { turbo_frame: "ssh_keys" } do |f| %>
      <div>
        <label class="block font-mono text-[10px] text-dim uppercase tracking-widest font-bold mb-1">Name</label>
        <input type="text" name="ssh_public_key[name]" placeholder="e.g. laptop" required autofocus
               class="w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent">
      </div>
      <div>
        <label class="block font-mono text-[10px] text-dim uppercase tracking-widest font-bold mb-1">Public Key</label>
        <textarea name="ssh_public_key[public_key]" placeholder="ssh-ed25519 AAAA... user@host" required rows="5"
                  class="w-full bg-bg border-1.5 border-ink px-3 py-2 font-mono text-xs text-ink placeholder-dim focus:outline-none focus:border-accent"></textarea>
        <p class="font-mono text-[10px] text-dim mt-1">Paste the contents of <code class="text-ink-soft">~/.ssh/id_ed25519.pub</code> (or similar).</p>
      </div>
      <div class="flex items-center gap-3 pt-2">
        <button type="submit" class="px-4 py-2 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer">Add Key</button>
        <button type="button" data-action="click->slide-panel#close" class="font-mono text-sm text-dim hover:text-ink transition cursor-pointer">Cancel</button>
      </div>
    <% end %>
  <% end %>
</div>
