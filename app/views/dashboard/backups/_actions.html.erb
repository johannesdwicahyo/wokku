<%# Sticky button area for the Backup Now action. Replaced via Turbo
    Stream broadcast when a backup is created (in_flight) or completes
    (status flips). dom id preserved as the stream target. %>
<div id="backup_actions">
  <% destination = database.server.backup_destination %>
  <% in_flight = database.backups.in_flight.exists? %>
  <% if in_flight %>
    <%= render "dashboard/shared/spinning_button",
        label: "Backing up",
        classes: "px-3 py-1.5 font-mono text-sm font-semibold text-bg bg-ink/70 border-1.5 border-ink" %>
  <% elsif destination&.enabled? %>
    <%= button_to "> backup_now()", dashboard_addon_backups_path(database), method: :post,
        data: { turbo_submits_with: "Starting…" },
        class: "px-3 py-1.5 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer" %>
  <% else %>
    <div class="font-mono text-xs text-dim">
      // no backup destination configured ·
      <%= link_to "configure", edit_admin_server_backup_destination_path(database.server), class: "text-accent hover:underline" %>
    </div>
  <% end %>
</div>
