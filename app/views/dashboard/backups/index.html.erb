<%#
  Backups index (schdl grid rollout, U4 Task 2). Policy logic,
  turbo_stream_from, confirm-restore + download wiring and routes
  preserved 1:1 — presentation only.
%>
<% content_for(:title, "Backups — #{@database.name}") %>

<%= render "dashboard/databases/header", database: @database, active: :backups %>

<%= turbo_stream_from "database_#{@database.id}_backups" %>
<div class="flex flex-wrap items-center justify-end gap-4 mb-6">
  <%= render "actions", database: @database %>
</div>

<%# Backup policy summary — reflects the tier's BACKUP_POLICIES entry.
    Closes the "what backup behaviour does this DB get?" question for
    customers without making them dig into pricing pages. %>
<% policy = @database.backup_policy %>
<% tier = @database.service_tier %>
<% last_completed = @database.backups.completed.order(created_at: :desc).first %>
<div class="border-1.5 border-ink bg-paper rounded-md px-5 py-3 mb-6 flex flex-wrap items-center justify-between gap-3">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs">
    <%= render Atoms::TagComponent.new(tone: :dim) do %><%= tier&.name&.tr("_", " ")&.split(" ")&.map(&:capitalize)&.join(" ") || "—" %><% end %>
    <% if policy[:auto_backup] %>
      <span class="text-ink-soft">Daily auto-backup</span>
      <span class="text-dim">·</span>
      <span class="text-ink-soft">Keeps <%= gfs_retention_summary(policy[:gfs]) %></span>
    <% elsif policy[:on_destroy_snapshot] %>
      <span class="text-ink-soft">No scheduled backup</span>
      <span class="text-dim">·</span>
      <span class="text-ink-soft">Snapshot saved on destroy</span>
    <% else %>
      <span class="text-ink-soft">Manual-only backups</span>
      <% if policy[:free_cap] && policy[:free_cap].positive? %>
        <span class="text-dim">·</span>
        <span class="text-ink-soft"><%= @database.backups.completed.count %> / <%= policy[:free_cap] %> stored</span>
      <% end %>
    <% end %>
  </div>
  <% if last_completed %>
    <span class="text-xs text-dim">Last backup <%= time_ago_in_words(last_completed.created_at) %> ago</span>
  <% end %>
</div>

<% if @backups.any? %>
  <div class="bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-hidden">
    <table class="w-full text-[13.5px]">
      <thead>
        <tr class="bg-bg border-b-1.5 border-ink text-[10.5px] font-bold uppercase tracking-[.06em] text-dim text-left">
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.backups.columns.date", default: "Date") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.backups.columns.status", default: "Status") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.backups.columns.size", default: "Size") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.backups.columns.duration", default: "Duration") %></th>
          <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.backups.columns.actions", default: "Actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @backups.each do |backup| %>
          <tr class="border-b border-line last:border-b-0 hover:bg-bg-deep transition-colors">
            <td class="px-3.5 py-2.5 text-[12.5px] text-dim"><%= backup.created_at.strftime("%b %d, %Y %H:%M") %></td>
            <td class="px-3.5 py-2.5">
              <% bs = backup.status %>
              <% if bs == "completed" %>
                <%= render Atoms::StatusPillComponent.new(label: "Completed", tone: :success) %>
              <% elsif bs == "running" %>
                <%= render Atoms::StatusPillComponent.new(label: "Running", tone: :deploying) %>
              <% elsif bs == "failed" %>
                <span title="<%= backup.error_message %>"><%= render Atoms::StatusPillComponent.new(label: "Failed", tone: :danger) %></span>
              <% elsif bs == "pending" %>
                <%= render Atoms::StatusPillComponent.new(label: "Pending", tone: :deploying) %>
              <% end %>
            </td>
            <td class="px-3.5 py-2.5 text-[12.5px] text-dim"><%= backup.size_human %></td>
            <td class="px-3.5 py-2.5 text-[12.5px] text-dim"><%= backup.duration ? "#{backup.duration.round(1)}s" : "—" %></td>
            <td class="px-3.5 py-2.5">
              <% if backup.status == "completed" %>
                <div class="flex items-center gap-2">
                  <%= render Atoms::ButtonComponent.new(variant: :ghost, size: :sm, href: download_dashboard_addon_backup_path(@database, backup)) do %>Download<% end %>

                  <%# Restore drawer — replaces the old confirm-delete modal so
                      destructive confirmations match the rest of the dashboard
                      (Phase 3 motion--drawer controller). Ghost recipe with the
                      warn tone in place of ButtonComponent's ink-soft default —
                      there's no warn variant on the component. %>
                  <div data-controller="motion--drawer" class="inline-block">
                    <button data-action="motion--drawer#open"
                            type="button"
                            class="inline-flex items-center justify-center gap-2 font-semibold cursor-pointer rounded-md transition-colors bg-transparent text-warn border-1.5 border-transparent hover:bg-bg-deep px-3 py-1.5 text-xs">
                      Restore
                    </button>
                    <template data-motion--drawer-target="content">
                      <div class="p-6 space-y-4">
                        <div class="text-[11px] font-bold uppercase tracking-[.06em] text-warn">Destructive — restore from backup</div>
                        <h2 class="font-headline text-xl font-extrabold">Restore <%= @database.name %>?</h2>
                        <p class="text-ink-soft text-sm leading-relaxed">
                          This <strong class="text-ink">overwrites</strong> the current contents of
                          <span class="text-ink font-semibold"><%= @database.name %></span> with the backup taken on
                          <strong class="text-ink"><%= backup.created_at.strftime('%b %d, %Y %H:%M') %></strong>.
                          The current state is lost and cannot be recovered.
                        </p>
                        <%= button_to "Yes, restore now", restore_dashboard_addon_backup_path(@database, backup),
                              method: :post,
                              class: "w-full border-1.5 border-ink rounded-md bg-danger text-bg font-semibold text-sm px-4 py-3 shadow-brutal hover:bg-warn hover:text-ink transition cursor-pointer",
                              data: {
                                controller: "motion--optimistic-button",
                                "motion--optimistic-button-pending-label-value": "restoring…"
                              } %>
                        <button data-action="motion--drawer#close"
                                type="button"
                                class="w-full border-1.5 border-ink rounded-md bg-paper text-ink font-semibold text-sm px-4 py-3 hover:bg-bg-deep transition cursor-pointer">
                          Cancel
                        </button>
                      </div>
                    </template>
                  </div>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%
    empty_body = if @destination&.enabled? && policy[:auto_backup]
      "Automatic backups run daily at 02:00 UTC. We keep #{gfs_retention_summary(policy[:gfs])}. Or trigger one now with 'Backup Now' above."
    elsif @destination&.enabled? && policy[:on_destroy_snapshot]
      "This tier doesn't take scheduled backups. A snapshot will be saved when the database is destroyed. Use 'Backup Now' for manual snapshots."
    elsif @destination&.enabled?
      cap = policy[:free_cap] && policy[:free_cap].positive? ? " (up to #{policy[:free_cap]} stored)" : ""
      "This tier supports manual backups only#{cap}. Use 'Backup Now' to create one."
    else
      "No backup destination is configured for this server. Ask an admin to set one up under /admin/servers."
    end
  %>
  <%= render Organisms::EmptyStateComponent.new(
        headline: "No backups yet.",
        body: empty_body
      ) %>
<% end %>
