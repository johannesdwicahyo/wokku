<% fmt_idr = ->(n) { "Rp #{ActiveSupport::NumberHelper.number_to_delimited(n.to_i, delimiter: '.')}" } %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <%= render Atoms::HashHeaderComponent.new(
          title: "Referrals",
          kicker: "// share_code() → get_invoice_credit()",
          size: :md) %>
  </div>

  <%# ── Stat tiles ──────────────────────────────────────────── %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <%= render Molecules::StatTileComponent.new(
          label: "Signups", value: @signups,
          sub: "// referred users on paid plan",
          glyph: "✓") %>
    <%= render Molecules::StatTileComponent.new(
          label: "Pending", value: @pending,
          sub: "// awaiting first paid invoice",
          tone: :warn,
          glyph: "…") %>
    <%= render Molecules::StatTileComponent.new(
          label: "Cash earned", value: fmt_idr.call(@cash_earned),
          sub: "// applied to your invoices",
          tone: :accent,
          glyph: "Rp") %>
    <%= render Molecules::StatTileComponent.new(
          label: "Per referral", value: fmt_idr.call(@bonus_per_ref),
          sub: "// each side",
          glyph: "→") %>
  </div>

  <%# ── Share block ─────────────────────────────────────────── %>
  <div class="border-1.5 border-ink bg-paper px-6 py-6">
    <div class="font-mono text-[10px] text-dim tracking-widest uppercase mb-2">// share_link</div>
    <h2 class="font-mono text-2xl text-ink font-semibold tracking-tighter mb-4">Share your code · earn an invoice credit</h2>
    <p class="font-mono text-sm text-ink-soft mb-5">
      For every friend who signs up and pays their first invoice, <strong><%= fmt_idr.call(@bonus_per_ref) %></strong> gets credited to your next invoice — and they get the same on theirs.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="border-1.5 border-ink bg-bg px-4 py-3">
        <div class="font-mono text-[10px] text-dim tracking-widest uppercase mb-1.5">Referral code</div>
        <div class="flex items-center justify-between gap-3">
          <span class="font-mono text-lg text-ink tracking-tight"><%= @code.code %></span>
          <button type="button"
                  data-controller="clipboard"
                  data-clipboard-text-value="<%= @code.code %>"
                  data-action="clipboard#copy"
                  class="font-mono text-[10px] text-dim hover:text-ink uppercase tracking-widest border border-rule-soft px-2 py-1 cursor-pointer">
            copy
          </button>
        </div>
      </div>
      <div class="border-1.5 border-ink bg-bg px-4 py-3">
        <div class="font-mono text-[10px] text-dim tracking-widest uppercase mb-1.5">Referral link</div>
        <div class="flex items-center justify-between gap-3">
          <span class="font-mono text-xs text-ink break-all"><%= @share_url %></span>
          <button type="button"
                  data-controller="clipboard"
                  data-clipboard-text-value="<%= @share_url %>"
                  data-action="clipboard#copy"
                  class="font-mono text-[10px] text-dim hover:text-ink uppercase tracking-widest border border-rule-soft px-2 py-1 cursor-pointer flex-shrink-0">
            copy
          </button>
        </div>
      </div>
    </div>
  </div>

  <%# ── How it works ────────────────────────────────────────── %>
  <div class="border-1.5 border-ink bg-paper px-6 py-6">
    <div class="font-mono text-[10px] text-dim tracking-widest uppercase mb-3">// how_it_works()</div>
    <ol class="space-y-3 font-mono text-sm text-ink-soft">
      <li class="flex gap-3">
        <span class="font-bold text-accent">→ 1.</span>
        <span>Share your code with a friend who hasn't tried Wokku yet.</span>
      </li>
      <li class="flex gap-3">
        <span class="font-bold text-accent">→ 2.</span>
        <span>They sign up using your code or link.</span>
      </li>
      <li class="flex gap-3">
        <span class="font-bold text-accent">→ 3.</span>
        <span>When they pay their first invoice, <%= fmt_idr.call(@bonus_per_ref) %> is credited to BOTH of your next invoices — auto-applied, no claim step.</span>
      </li>
    </ol>
  </div>

  <%# ── Regenerate ──────────────────────────────────────────── %>
  <details class="border border-rule-soft px-4 py-3">
    <summary class="font-mono text-xs text-dim cursor-pointer hover:text-ink">// danger_zone()</summary>
    <div class="mt-3 pt-3 border-t border-rule-soft flex items-center justify-between gap-3">
      <p class="font-mono text-xs text-ink-soft">
        Generate a new referral code. The old code stops working immediately — any pending redemptions still pay out when they trigger.
      </p>
      <%= button_to "regenerate()", regenerate_dashboard_referrals_path,
            method: :post,
            data: { turbo_confirm: "This will replace #{@code.code} with a brand new code. Continue?" },
            class: "font-mono text-[10px] text-dim hover:text-ink uppercase tracking-widest border border-rule-soft px-3 py-2 cursor-pointer bg-transparent flex-shrink-0" %>
    </div>
  </details>
</div>
