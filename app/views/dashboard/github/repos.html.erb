<% content_for(:title, "Connect GitHub — #{@app.name}") %>

<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :deploy) do %>
  <%= render Organisms::AppDeployComponent.new(app: @app, active: :github) do %>

<div class="max-w-2xl mx-auto space-y-6">
  <%= link_to dashboard_app_releases_path(@app), class: "inline-flex items-center font-mono text-sm text-dim hover:text-accent transition" do %>
    ← Back to Releases
  <% end %>

  <div class="border-1.5 border-ink bg-paper p-6">
    <h1 class="font-mono text-lg font-semibold text-ink mb-1"># connect_github_repository</h1>
    <p class="font-mono text-sm text-dim mb-6">// select a repository to auto-deploy to <span class="text-ink"><%= @app.name %></span></p>

    <% if @repos.any? %>
      <div class="space-y-2 max-h-96 overflow-y-auto">
        <% @repos.each do |repo| %>
          <% selected = @selected_repo == repo.full_name %>
          <%= link_to dashboard_app_github_repos_path(@app, repo: repo.full_name),
              class: "block p-3 border-1.5 transition font-mono #{selected ? 'bg-accent-soft border-accent' : 'bg-bg border-ink hover:bg-bg-deep'}" do %>
            <div class="flex items-center justify-between gap-3">
              <div>
                <span class="text-sm font-medium text-ink"><%= repo.full_name %></span>
                <% if repo.private %>
                  <span class="ml-1.5 px-1.5 py-0.5 text-[10px] border border-warn text-warn">private</span>
                <% end %>
              </div>
              <% if repo.language %>
                <span class="text-[10px] text-dim"><%= repo.language %></span>
              <% end %>
            </div>
            <% if repo.description %>
              <p class="text-xs text-dim mt-1 truncate"><%= repo.description %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <% if @selected_repo && @branches.any? %>
        <div class="mt-6 pt-6 border-t border-rule-soft">
          <h3 class="font-mono text-sm font-medium text-ink mb-3">Select branch for <span class="text-accent"><%= @selected_repo %></span></h3>
          <div class="space-y-2">
            <% @branches.each do |branch| %>
              <%= button_to dashboard_app_github_connect_path(@app, repo: @selected_repo, branch: branch),
                  method: :post,
                  class: "w-full text-left p-2.5 border-1.5 border-ink bg-bg hover:border-accent transition font-mono" do %>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-ink-soft"><%= branch %></span>
                  <span class="text-xs text-accent">Deploy →</span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-8">
        <% if @not_installed %>
          <p class="font-mono text-dim text-sm">// install the Wokku GitHub App to pick a repository</p>
          <a href="<%= GithubApp.installation_url %>" target="_top" class="mt-4 inline-flex items-center font-mono text-sm text-accent hover:underline">Install the GitHub App →</a>
        <% else %>
          <p class="font-mono text-dim text-sm">// no repositories found — make sure the Wokku GitHub App has access to your repositories</p>
          <a href="<%= GithubApp.installation_url %>" target="_top" class="mt-4 inline-flex items-center font-mono text-sm text-accent hover:underline">Manage GitHub App permissions →</a>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

  <% end %>
<% end %>
