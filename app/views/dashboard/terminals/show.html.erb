<%#
  Brutalist terminal (P6). data-controller="terminal" + all
  data-terminal-* values/targets + reconnect action preserved 1:1
  (xterm.js + ActionCable SSH session — do not rename).

  App-console mode (@app present) is wrapped in AppTabs + AppRuntime
  sub-nav so it lives inside the dashboard chrome alongside logs/
  metrics/scaling. The xterm container's height is calculated against
  the chrome it sits inside (taller chrome → smaller calc).

  Server-terminal mode (@server only, admin-only) stays standalone —
  it's outside the app context.
%>
<% content_for(:title, @app ? "Console — #{@app.name}" : "Terminal — #{@server.name}") %>

<% if @app %>
  <%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :runtime) do %>
    <%= render Organisms::AppRuntimeComponent.new(app: @app, active: :terminal) do %>

      <div class="space-y-3">
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <div class="flex items-center gap-2 font-mono text-xs text-dim">
            <span>// console on <%= @server.name %></span>
          </div>
          <div class="flex items-center gap-3 font-mono">
            <span data-terminal-target="status" class="text-xs text-warn">Connecting...</span>
            <button data-action="click->terminal#reconnect" class="text-xs text-ink hover:bg-bg-deep transition px-2 py-1 border-1.5 border-ink cursor-pointer">Reconnect</button>
          </div>
        </div>

        <details class="border-1.5 border-ink bg-paper">
          <summary class="flex items-center gap-2 px-3 py-2 cursor-pointer select-none font-mono">
            <span class="text-[10px] text-dim">This console runs inside your app's <span class="text-ink-soft">web</span> container. Run <span class="text-accent">ls</span>, <span class="text-accent">printenv</span>, or any binary your image provides — <span class="text-ink-soft">click for limits &amp; tips</span></span>
          </summary>
          <div class="px-3 pb-3 pt-1 font-mono text-[11px] text-dim grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1">
            <div>
              <p class="font-semibold text-ink-soft mb-1">What works</p>
              <ul class="space-y-0.5 list-disc list-inside">
                <li>Full interactive shell — anything your image's <span>$PATH</span> provides</li>
                <li>Stack-specific REPLs (<span>rails c</span>, <span>python</span>, <span>node</span>, <span>bin/console</span>) if installed</li>
                <li>Database clients via <span>$DATABASE_URL</span> (e.g. <span>psql $DATABASE_URL</span>) when the binary is available</li>
                <li>All env vars are visible (<span>printenv</span>)</li>
                <li>Outbound network works</li>
                <li>Debian/Ubuntu images include <span>bash</span>; Alpine images get <span>/bin/sh</span> — <span>apk add bash curl</span> for richer tools</li>
              </ul>
            </div>
            <div>
              <p class="font-semibold text-ink-soft mb-1">What doesn't</p>
              <ul class="space-y-0.5 list-disc list-inside">
                <li>Filesystem changes are wiped on any redeploy, restart, or crash</li>
                <li>Session dies after 15 min idle</li>
                <li>No access to other apps or the host</li>
                <li>No command history between sessions</li>
              </ul>
            </div>
          </div>
        </details>

        <div class="border-1.5 border-ink bg-paper overflow-hidden"
             data-controller="terminal"
             data-terminal-server-id-value="<%= @server.id %>"
             data-terminal-app-name-value="<%= @app.name %>">
          <%# Chrome above (tab + sub-nav + header + details closed): ~320px.
              calc 100vh-360px leaves room for browser chrome + a bit of
              breathing space; user can scroll the page if details is open. %>
          <div data-terminal-target="container" class="h-[calc(100vh-360px)] min-h-[300px] w-full"></div>
        </div>
      </div>

    <% end %>
  <% end %>

<% else %>
  <%# Server-terminal mode (admin-only) — no AppTabs chrome since it
      lives outside the app context. %>
  <div class="space-y-4">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-3 flex-wrap font-mono">
        <%= link_to "←", admin_server_path(@server), class: "text-dim hover:text-accent transition" %>
        <h1 class="text-lg font-semibold text-ink"># server_terminal</h1>
        <span class="text-[10px] text-danger uppercase tracking-widest font-bold border border-danger px-2 py-1">Admin Only</span>
        <span class="text-xs text-dim"><%= @server.name %> (<%= @server.host %>)</span>
      </div>
      <div class="flex items-center gap-3 font-mono">
        <span data-terminal-target="status" class="text-xs text-warn">Connecting...</span>
        <button data-action="click->terminal#reconnect" class="text-xs text-ink hover:bg-bg-deep transition px-2 py-1 border-1.5 border-ink cursor-pointer">Reconnect</button>
      </div>
    </div>

    <div class="border-1.5 border-ink bg-paper overflow-hidden"
         data-controller="terminal"
         data-terminal-server-id-value="<%= @server.id %>">
      <div data-terminal-target="container" class="h-[calc(100vh-220px)] min-h-[300px] w-full"></div>
    </div>
  </div>
<% end %>
