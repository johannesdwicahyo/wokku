<%# Brutalist (P6.5). data-controller=deploy + deploy-target output/
    statusBadge + deploy-id-value preserved 1:1 (live log stream). %>
<% content_for(:title, "Deploy — #{@app.name}") %>

<div class="space-y-4">
  <div class="flex items-center justify-between gap-3 flex-wrap font-mono">
    <div class="flex items-center gap-3 flex-wrap">
      <%= link_to "←", dashboard_app_path(@app), class: "text-dim hover:text-accent transition" %>
      <h1 class="text-lg font-semibold text-ink"># <%= @app.name %></h1>
      <span class="text-dim">·</span>
      <span class="text-sm text-ink-soft">Deploy #<%= @deploy.id %></span>
      <% if @deploy.description.present? %>
        <span class="text-xs text-dim">(<%= @deploy.description %>)</span>
      <% end %>
    </div>
    <div data-deploy-target="statusBadge" data-tour-target="live">
      <% case @deploy.status %>
      <% when "pending" %>
        <span class="inline-flex items-center gap-1.5 text-xs text-dim"><span class="w-1.5 h-1.5 bg-dim animate-pulse"></span>Pending</span>
      <% when "building" %>
        <span class="inline-flex items-center gap-1.5 text-xs text-warn"><span class="w-1.5 h-1.5 bg-warn animate-pulse"></span>Building</span>
      <% when "succeeded" %>
        <span class="inline-flex items-center gap-1.5 text-xs text-success"><span class="w-1.5 h-1.5 bg-success"></span>Succeeded</span>
      <% when "failed" %>
        <span class="inline-flex items-center gap-1.5 text-xs text-danger"><span class="w-1.5 h-1.5 bg-danger"></span>Failed</span>
      <% when "timed_out" %>
        <span class="inline-flex items-center gap-1.5 text-xs text-danger"><span class="w-1.5 h-1.5 bg-danger"></span>Timed Out</span>
      <% end %>
    </div>
  </div>

  <div class="border-1.5 border-ink bg-paper overflow-hidden"
       data-controller="deploy"
       data-deploy-deploy-id-value="<%= @deploy.id %>">
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-rule-soft font-mono">
      <span class="text-[10px] text-dim">deploy log</span>
      <% if @deploy.finished_at && @deploy.started_at %>
        <span class="text-[10px] text-dim">
          Duration: <%= (@deploy.finished_at - @deploy.started_at).round(1) %>s
        </span>
      <% end %>
    </div>
    <div data-deploy-target="output" data-tour-target="log"
         class="p-4 font-mono text-xs text-ink-soft whitespace-pre-wrap overflow-y-auto h-[calc(100vh-250px)] leading-relaxed bg-bg"><%= @deploy.log.presence || (@deploy.status.in?(%w[pending building]) ? "// queued — waiting for a builder to pick this up…" : "") %></div>
  </div>
</div>
