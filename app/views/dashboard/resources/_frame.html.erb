<%= turbo_frame_tag "resources_processes", target: "_top" do %>
<%= render Molecules::DiskUsageBannerComponent.new(record: @app) %>
<% if Wokku.config.resource_builder? %>
  <%= form_with url: dashboard_app_resources_path(@app), method: :patch, data: { turbo_frame: "_top" } do %>
    <div class="bg-paper border-1.5 border-ink rounded-md mb-6 divide-y divide-line">
      <% (@allocations.presence || [ @app.dyno_allocations.build(process_type: "web", cpu: 0.25, memory_mb: 512) ]).each do |a| %>
        <div class="px-6 py-4">
          <h3 class="font-headline text-sm font-bold text-ink mb-3"><%= a.process_type %></h3>
          <%= render Organisms::ResourceBuilderComponent.new(
                name: "processes[#{a.process_type}]",
                shape: a.shape || (a.sleeping? ? Resources::Shape.new(**Resources::Shape::PRESETS["starter"]) : Resources::Shape.round_up(cpu: a.effective_cpu, memory_mb: a.effective_memory_mb)),
                presets: Resources::Shape::PRESETS,
                instances: @scales[a.process_type] || 1,
                sleeping_option: a.process_type == "web",
                sleeping: a.sleeping?, rails_hint: true) %>
        </div>
      <% end %>
      <% if @app.storage_mounts.present? %>
        <div class="px-6 py-4">
          <h3 class="font-headline text-sm font-bold text-ink mb-1">Volume disk</h3>
          <p class="text-[11px] text-dim mb-2">Used: <%= @app.volume_used_gb || "—" %> GB</p>
          <input type="range" name="volume_disk_gb" value="<%= @app.volume_disk_gb %>" min="0" max="100" step="1" class="w-full">
        </div>
      <% end %>
      <div class="px-6 py-4 flex justify-end">
        <%= submit_tag t("resources.save"), data: { turbo_confirm: "Containers will restart with the new size." },
              class: Atoms::ButtonComponent.new(variant: :primary, size: :sm).classes %>
      </div>
    </div>
  <% end %>
<% else %>
  <%
    web_allocation = @current_allocation
    tier = web_allocation&.dyno_tier
    total_dynos = @app.dyno_allocations.sum(:count)
  %>
  <div class="bg-paper border-1.5 border-ink rounded-md mb-6 overflow-hidden">
    <div class="px-6 py-4 border-b border-line">
      <h2 class="font-headline text-base font-bold text-ink">Container</h2>
      <p class="text-xs text-dim mt-1">Compute + memory allocated to <span class="text-ink font-medium"><%= @app.name %></span></p>
    </div>
    <%
      # Bundle v2: render the existing DynoTier under the user-facing box
      # size vocabulary. DynoTier stays as plumbing; users see boxes.
      current_box_size = DynoTier::DYNO_TIER_TO_BOX_SIZE[tier&.name] || tier&.name
      user_plan = current_user.current_plan
    %>
    <% if tier %>
      <div class="px-6 py-4 grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">Box size</p>
          <p class="text-sm font-bold text-ink capitalize"><%= current_box_size %></p>
        </div>
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">Memory</p>
          <p class="text-sm text-ink-soft tabular-nums"><%= tier.memory_mb >= 1024 ? "#{tier.memory_mb / 1024} GB" : "#{tier.memory_mb} MB" %></p>
        </div>
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">CPU</p>
          <p class="text-sm text-ink-soft"><%= tier.vcpu_label %></p>
        </div>
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">Plan</p>
          <p class="text-sm font-bold text-ink"><%= user_plan&.name || "Free" %></p>
          <p class="text-[10px] text-dim mt-0.5">Flat monthly price · no metering</p>
        </div>
      </div>
      <% if total_dynos > 1 || @app.dyno_allocations.count > 1 %>
        <div class="px-6 py-3 border-t border-line flex flex-wrap items-center gap-2 text-xs text-dim">
          <span>Dynos:</span>
          <% @app.dyno_allocations.each do |alloc| %>
            <span class="border border-line rounded-md px-2 py-0.5 font-mono tabular-nums"><%= alloc.process_type %> × <%= alloc.count %></span>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-6 text-center text-xs text-dim">No container tier assigned yet — deploy the app once to pick the free tier automatically.</div>
    <% end %>

    <%# Bundle v2 box-size picker. DynoTier rows are presented under the
        user-facing box-size labels via DynoTier::DYNO_TIER_TO_BOX_SIZE. Each
        card shows a plan-aware availability badge so users can see at a
        glance which sizes their plan includes vs requires an upgrade. %>
    <% if @dyno_tiers.any? %>
      <div class="px-6 py-4 border-t border-line">
        <p class="text-xs text-dim mb-3">Change box size</p>
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-3">
          <% @dyno_tiers.each do |dt| %>
            <%
              box_size  = DynoTier::DYNO_TIER_TO_BOX_SIZE[dt.name] || dt.name
              # Backfilled rows carry a shape, not a tier: match the tier it rounded from.
              is_current = @current_allocation&.dyno_tier_id == dt.id ||
                           (!dt.sleeps && @current_allocation&.shape.present? &&
                            Resources::Shape.round_up(cpu: dt.cpu_shares, memory_mb: dt.memory_mb) == @current_allocation.shape)
              # Available means: plan has at least 1 quota for this size OR
              # (only Team plan) it's listed in addons_available.
              # Headroom-aware: includes purchased box-addons (Part 2), not just plan base quota.
              quota_avail = is_current || (@box_size_headroom && @box_size_headroom[box_size].to_f > 0) # to_f: NullPlanEnforcer returns Float::INFINITY (unlimited self-host); Infinity.to_i raises
              addon_avail = user_plan&.buyable_box_sizes&.include?(box_size)
              on_plan = quota_avail || addon_avail
              upgrade_msg = case box_size
                            when "sleeping" then nil
                            when "small"    then "Solo plan or higher"
                            when "medium"   then "Pro plan or higher"
                            when "large"    then "Team plan"
                            when "xlarge"   then "Team plan + buy extra"
                            end
            %>
            <div class="border-1.5 rounded-md p-3 transition <%= is_current ? 'border-accent bg-accent-soft' : (on_plan ? 'border-ink bg-paper hover:bg-bg-deep' : 'border-line bg-bg-deep opacity-60') %>">
              <div class="flex items-baseline justify-between mb-1">
                <h3 class="text-sm font-semibold text-ink capitalize"><%= box_size %></h3>
                <% if is_current %>
                  <span class="text-[10px] font-bold uppercase text-accent">Current</span>
                <% elsif on_plan %>
                  <span class="text-[10px] font-bold uppercase text-ink-soft">Included</span>
                <% else %>
                  <span class="text-[10px] font-bold uppercase text-dim">Upgrade</span>
                <% end %>
              </div>
              <ul class="text-[11px] text-dim space-y-0.5 mb-3">
                <li><%= dt.memory_mb >= 1024 ? "#{dt.memory_mb / 1024} GB" : "#{dt.memory_mb} MB" %> RAM</li>
                <li><%= dt.vcpu_label %></li>
                <% if dt.respond_to?(:storage_mb) && dt.storage_mb > 0 %>
                  <li><%= dt.storage_mb >= 1024 ? "#{dt.storage_mb / 1024} GB" : "#{dt.storage_mb} MB" %> storage</li>
                <% end %>
              </ul>
              <% if is_current %>
                <%# no button — already on this size %>
              <% elsif quota_avail %>
                <%= button_to "Resize",
                      change_tier_dashboard_app_scaling_path(@app),
                      params: { dyno_tier_id: dt.id, process_type: "web" },
                      method: :post,
                      data: { turbo_confirm: "Resize to #{box_size.capitalize} box (#{dt.memory_mb >= 1024 ? "#{dt.memory_mb / 1024}GB" : "#{dt.memory_mb}MB"}, #{dt.vcpu_label})?" },
                      class: "w-full text-center px-2 py-1 text-[11px] font-semibold border-1.5 border-ink rounded-md bg-paper text-ink hover:bg-bg-deep transition cursor-pointer" %>
              <% elsif addon_avail && respond_to?(:dashboard_box_addons_path) %>
                <%= button_to "Buy #{box_size} box",
                      dashboard_box_addons_path(size: box_size),
                      method: :post,
                      class: "w-full text-center px-2 py-1 text-[11px] font-semibold border-1.5 border-ink rounded-md bg-ink text-paper hover:bg-ink-soft transition cursor-pointer" %>
              <% else %>
                <p class="text-[10px] text-dim text-center px-1 py-1.5 border-1.5 border-line rounded-md"><%= upgrade_msg %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
<% end %>
