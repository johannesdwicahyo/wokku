<%#
  Brutalist resources/scaling (P5 of redesign-c-full, 2026-05-17). All
  Ruby (tier math, addon_monthly_share/price_period), content_for head
  turbo-cache-control, turbo_stream_from refresh, addon-tier-picker +
  slide-panel wiring, and routes preserved 1:1 from show.OLD_DESIGN.
%>
<%# Adding/removing an add-on involves SSH work and invalidates most of
    the panel state; Turbo's preview cache can show a pre-submit snapshot
    after the redirect completes. Disable the preview for this page. %>
<% content_for(:head) do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>

<%= render Organisms::AppTabsComponent.new(app: @app, active_tab: :runtime) do %>
<%= render Organisms::AppRuntimeComponent.new(app: @app, active: :metrics) do %>
<div data-controller="slide-panel">

  <%
    web_allocation = @app.dyno_allocations.includes(:dyno_tier).find_by(process_type: "web")
    tier = web_allocation&.dyno_tier
    total_dynos = @app.dyno_allocations.sum(:count)
  %>
  <div class="border-1.5 border-ink bg-paper mb-6">
    <div class="px-6 py-4 border-b border-rule-soft">
      <h2 class="font-mono text-base font-semibold text-ink"># container</h2>
      <p class="font-mono text-xs text-dim mt-1">// compute + memory allocated to <span class="text-ink"><%= @app.name %></span></p>
    </div>
    <%
      # Bundle v2: render the existing DynoTier under the user-facing box
      # size vocabulary. DynoTier stays as plumbing; users see boxes.
      current_box_size = Plan::DYNO_TIER_TO_BOX_SIZE[tier&.name] || tier&.name
      user_plan = current_user.current_plan
    %>
    <% if tier %>
      <div class="px-6 py-4 grid grid-cols-2 lg:grid-cols-4 gap-4 font-mono">
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">Box size</p>
          <p class="text-sm font-bold text-ink capitalize"><%= current_box_size %></p>
        </div>
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">Memory</p>
          <p class="text-sm text-ink-soft"><%= tier.memory_mb >= 1024 ? "#{tier.memory_mb / 1024} GB" : "#{tier.memory_mb} MB" %></p>
        </div>
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">CPU</p>
          <p class="text-sm text-ink-soft"><%= tier.vcpu_label %></p>
        </div>
        <div>
          <p class="text-[10px] text-dim uppercase tracking-widest mb-1">Plan</p>
          <p class="text-sm font-bold text-ink"><%= user_plan&.name || "Free" %></p>
          <p class="text-[10px] text-dim mt-0.5">flat monthly price · no metering</p>
        </div>
      </div>
      <% if total_dynos > 1 || @app.dyno_allocations.count > 1 %>
        <div class="px-6 py-3 border-t border-rule-soft flex flex-wrap items-center gap-2 font-mono text-xs text-dim">
          <span>Dynos:</span>
          <% @app.dyno_allocations.each do |alloc| %>
            <span class="border border-rule-soft px-2 py-0.5"><%= alloc.process_type %> × <%= alloc.count %></span>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-6 text-center font-mono text-xs text-dim">// no container tier assigned yet — deploy the app once to pick the free tier automatically</div>
    <% end %>

    <%# Bundle v2 box-size picker. DynoTier rows are presented under the
        user-facing box-size labels via Plan::DYNO_TIER_TO_BOX_SIZE. Each
        card shows a plan-aware availability badge so users can see at a
        glance which sizes their plan includes vs requires an upgrade. %>
    <% if @dyno_tiers.any? %>
      <div class="px-6 py-4 border-t border-rule-soft">
        <p class="font-mono text-xs text-dim mb-3">// change box size</p>
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-3">
          <% @dyno_tiers.each do |dt| %>
            <%
              box_size  = Plan::DYNO_TIER_TO_BOX_SIZE[dt.name] || dt.name
              is_current = @current_allocation&.dyno_tier_id == dt.id
              # Available means: plan has at least 1 quota for this size OR
              # (only Team plan) it's listed in addons_available.
              plan_quota = user_plan&.quota_for(box_size).to_i if user_plan
              addon_avail = user_plan&.addons_available&.key?(box_size)
              on_plan = (plan_quota.to_i > 0) || addon_avail
              upgrade_msg = case box_size
                            when "sleeping" then nil
                            when "small"    then "Solo plan or higher"
                            when "medium"   then "Pro plan or higher"
                            when "large"    then "Team plan"
                            when "xlarge"   then "Team plan + buy extra"
                            end
            %>
            <div class="border-1.5 p-3 transition font-mono <%= is_current ? 'border-accent bg-accent-soft' : (on_plan ? 'border-ink bg-paper hover:bg-bg-deep' : 'border-rule-soft bg-bg-deep opacity-60') %>">
              <div class="flex items-baseline justify-between mb-1">
                <h3 class="text-sm font-semibold text-ink capitalize"><%= box_size %></h3>
                <% if is_current %>
                  <span class="text-[10px] font-bold uppercase text-accent">current</span>
                <% elsif on_plan %>
                  <span class="text-[10px] font-bold uppercase text-ink-soft">included</span>
                <% else %>
                  <span class="text-[10px] font-bold uppercase text-dim">upgrade</span>
                <% end %>
              </div>
              <ul class="text-[11px] text-dim space-y-0.5 mb-3">
                <li><%= dt.memory_mb >= 1024 ? "#{dt.memory_mb / 1024} GB" : "#{dt.memory_mb} MB" %> RAM</li>
                <li><%= dt.vcpu_label %></li>
                <% if dt.respond_to?(:storage_mb) && dt.storage_mb > 0 %>
                  <li><%= dt.storage_mb >= 1024 ? "#{dt.storage_mb / 1024} GB" : "#{dt.storage_mb} MB" %> storage</li>
                <% end %>
              </ul>
              <% if is_current %>
                <%# no button — already on this size %>
              <% elsif on_plan %>
                <%= button_to "Resize",
                      change_tier_dashboard_app_scaling_path(@app),
                      params: { dyno_tier_id: dt.id, process_type: "web" },
                      method: :post,
                      data: { turbo_confirm: "Resize to #{box_size.capitalize} box (#{dt.memory_mb >= 1024 ? "#{dt.memory_mb / 1024}GB" : "#{dt.memory_mb}MB"}, #{dt.vcpu_label})?" },
                      class: "w-full text-center px-2 py-1 text-[11px] font-semibold border-1.5 border-ink bg-paper text-ink hover:bg-bg-deep transition cursor-pointer" %>
              <% else %>
                <p class="text-[10px] text-dim text-center px-1 py-1.5 border-1.5 border-rule-soft"><%= upgrade_msg %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Attached Add-ons %>
  <div class="border-1.5 border-ink bg-paper mb-6">
    <div class="px-6 py-4 border-b border-rule-soft flex items-center justify-between gap-3 flex-wrap">
      <div>
        <h2 class="font-mono text-base font-semibold text-ink"># add-ons</h2>
        <p class="font-mono text-xs text-dim mt-1">// databases, caches, and services attached to this app</p>
      </div>
      <button data-action="click->slide-panel#open" class="inline-flex items-center px-3 py-1.5 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer">+ add</button>
    </div>

    <%# Subscribe to the page-refresh channel so this view auto-refreshes
        whenever an addon's status changes (CreateAddonJob progress,
        retry, destroy). Resources page has its own row layout we don't
        want clobbered, so we use the refresh stream instead of the
        replace stream that /dashboard/addons subscribes to. %>
    <%= turbo_stream_from "user_#{current_user.id}_addons_refresh" %>

    <% if @addons.any? %>
      <div class="divide-y divide-rule-soft">
        <% @addons.each do |addon| %>
          <% addon_tier = addon.service_tier %>
          <% addon_monthly = addon_tier&.monthly_price_dollars.to_f %>
          <div class="px-6 py-4 flex items-center justify-between gap-3 flex-wrap hover:bg-bg-deep transition-colors font-mono">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-semibold text-ink"><%= addon.name %></span>
                <span class="text-xs text-dim capitalize"><%= addon.service_type %></span>
                <% if addon.tier_name.present? %>
                  <span class="text-xs text-dim">·</span>
                  <span class="text-xs text-dim capitalize"><%= addon.tier_name.tr("_", " ") %></span>
                <% end %>
                <% if addon.status == "creating" %>
                  <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-warn uppercase tracking-widest">
                    <span class="w-1.5 h-1.5 bg-warn animate-pulse"></span>provisioning
                  </span>
                <% elsif addon.status == "error" %>
                  <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-danger uppercase tracking-widest">
                    <span class="w-1.5 h-1.5 bg-danger"></span>failed
                  </span>
                <% end %>
              </div>
              <% if addon.status == "error" && addon.last_error.present? %>
                <p class="mt-1 text-xs text-danger break-all line-clamp-2"><%= addon.last_error %></p>
              <% end %>
            </div>
            <div class="flex items-center gap-4">
              <% if addon.status == "error" %>
                <%= button_to "retry", retry_dashboard_addon_path(addon), method: :post, class: "text-xs px-3 py-1.5 bg-ink text-bg border-1.5 border-ink font-semibold hover:bg-ink-soft transition cursor-pointer" %>
              <% end %>
              <div class="text-right">
                <% if addon.shared? || addon_monthly.zero? %>
                  <span class="text-xs text-dim">Free</span>
                <% else %>
                  <span class="text-sm font-semibold text-ink-soft"><%= format_usd_for_user(addon_monthly) %></span>
                  <span class="text-xs text-dim">/bln</span>
                <% end %>
              </div>
              <%= link_to "info", dashboard_addon_path(addon), class: "text-xs text-ink-soft hover:text-accent border-1.5 border-ink px-2 py-1 transition" %>
              <%= button_to "remove",
                    dashboard_app_resources_path(@app, addon_id: addon.id),
                    method: :delete,
                    data: { turbo_confirm: "Remove #{addon.name}? This will delete all data in this service." },
                    class: "text-xs text-dim hover:text-danger transition cursor-pointer bg-transparent border-0" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <h3 class="font-mono text-sm font-medium text-ink-soft">// no add-ons yet</h3>
        <p class="font-mono text-xs text-dim mt-1">Add a database, cache, or other service to get started.</p>
        <div class="mt-4">
          <button data-action="click->slide-panel#open" class="inline-flex items-center px-3 py-1.5 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer">+ add an add-on</button>
        </div>
      </div>
    <% end %>
  </div>

  <%# Estimated total — container + addons. Mirrors the right-side card on
      apps#show so users see the same number wherever they land. %>
  <%
    container_monthly_usd = tier ? total_dynos * tier.monthly_price_dollars : 0.0
    addons_monthly_usd = @addons.sum { |a| addon_monthly_share(a).first }
    total_monthly_usd = container_monthly_usd + addons_monthly_usd
  %>
  <div class="border-1.5 border-ink bg-paper mb-6">
    <div class="px-6 py-4">
      <p class="font-mono text-xs text-dim uppercase tracking-widest mb-3">estimated_monthly_cost</p>
      <div class="space-y-1.5 font-mono text-sm">
        <div class="flex items-center justify-between text-ink-soft">
          <span>Container · <span class="text-dim"><%= tier&.name&.upcase || "—" %> × <%= total_dynos %></span></span>
          <span><%= tier&.free? ? "Free" : format_usd_for_user(container_monthly_usd) %></span>
        </div>
        <% @addons.each do |a| %>
          <% am, link_count = addon_monthly_share(a) %>
          <% atier = a.tier_name.to_s.tr("_", " ").upcase.presence || a.service_type.upcase %>
          <% shared_suffix = link_count > 1 ? " · 1/#{link_count} shared" : "" %>
          <div class="flex items-center justify-between text-ink-soft">
            <span><%= a.name %> <span class="text-dim"><%= atier %><%= shared_suffix %></span></span>
            <span><%= a.shared? || am.zero? ? "Free" : format_usd_for_user(am) %></span>
          </div>
        <% end %>
      </div>
      <div class="border-t border-rule-soft mt-3 pt-3 flex items-baseline justify-between font-mono">
        <span class="text-sm font-semibold text-ink">Total</span>
        <span class="text-lg font-bold text-accent"><%= format_usd_for_user(total_monthly_usd) %><%= price_period(Wokku::LaunchMode.idr_only? ? "idr" : nil) %></span>
      </div>
    </div>
  </div>

  <%# Add-on Slide Panel %>
  <%= render layout: "dashboard/shared/slide_panel", locals: { title: "New Add-on", subtitle: "Provision a database or service for #{@app.name}" } do %>
    <%
      tiers_by_type = ServiceTier.available.where.not(name: "shared_free")
                                 .order(:monthly_price_cents).group_by(&:service_type)
      tier_payload = tiers_by_type.transform_values do |tiers|
        tiers.map { |t| { name: t.name, monthly_price_cents: t.monthly_price_cents, spec: t.spec } }
      end
      service_type_options = [
        ["PostgreSQL", "postgres"], ["MySQL", "mysql"], ["MongoDB", "mongodb"],
        ["Redis", "redis"], ["Memcached", "memcached"],
        ["Elasticsearch", "elasticsearch"], ["RabbitMQ", "rabbitmq"]
      ]
      label_classes = "block font-mono text-[10px] font-bold text-dim mb-1.5 uppercase tracking-widest"
      input_classes = "w-full bg-bg border-1.5 border-ink px-3 py-2.5 font-mono text-sm text-ink placeholder-dim focus:outline-none focus:border-accent transition-colors"
    %>
    <%= form_with url: dashboard_addons_path, method: :post, class: "space-y-5",
                  data: { controller: "addon-tier-picker", "addon-tier-picker-tiers-value": tier_payload.to_json } do |f| %>
      <%# App is fixed on this page — submit it as hidden so the form
          posts to the canonical DatabasesController#create path. %>
      <%= hidden_field_tag "database_service[app_id]", @app.id %>

      <div>
        <label class="<%= label_classes %>">Attached to</label>
        <div class="border-1.5 border-ink bg-bg px-4 py-2.5 font-mono text-sm text-ink">
          <%= @app.name %> <span class="text-dim">· <%= @app.server.name %></span>
        </div>
        <p class="font-mono text-[11px] text-dim mt-1">Linked automatically; runs on the same server.</p>
      </div>

      <div>
        <label for="database_service_name" class="<%= label_classes %>">Name</label>
        <%= text_field_tag "database_service[name]", nil, class: input_classes, placeholder: "my-database" %>
      </div>

      <div>
        <label class="<%= label_classes %>">Service Type</label>
        <%= combobox_tag "database_service[service_type]", service_type_options, value: "postgres", placeholder: "Select a service type",
            data: { "addon-tier-picker-target": "serviceType", action: "change->addon-tier-picker#refresh" } %>
      </div>

      <div>
        <label class="<%= label_classes %>">Plan</label>
        <%= hidden_field_tag "database_service[tier_name]", "basic", data: { "addon-tier-picker-target": "tierInput" } %>
        <div class="grid grid-cols-1 gap-2" data-addon-tier-picker-target="cards">
          <div class="font-mono text-xs text-dim px-3 py-2">Loading plans…</div>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <button type="submit" class="flex-1 py-2.5 px-4 bg-ink text-bg font-mono text-sm border-1.5 border-ink shadow-brutal-sm hover:shadow-brutal transition-all cursor-pointer">Create Add-on</button>
        <button type="button" data-action="click->slide-panel#close" class="py-2.5 px-4 font-mono text-sm text-ink border-1.5 border-ink bg-paper hover:bg-bg-deep transition-colors cursor-pointer">Cancel</button>
      </div>
    <% end %>
  <% end %>

</div>
<% end %>
<% end %>
