<%# Same card as devise/sessions/new.html.erb. %>
<div class="min-h-screen flex items-center justify-center px-5 bg-bg text-ink font-sans">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <h1 class="font-headline text-2xl font-semibold tracking-tight text-ink"><%= t("auth.two_factor_challenge.title") %></h1>
      <p class="text-xs text-dim mt-2"><%= t("auth.two_factor_challenge.sub") %></p>
    </div>
    <div class="border border-line bg-paper rounded-md p-6 space-y-3">
      <% if flash[:alert] %>
        <div class="border border-danger bg-danger-soft rounded-md p-2.5 text-xs text-danger"><%= flash[:alert] %></div>
      <% end %>

      <%= form_with url: users_two_factor_path, method: :post, data: { turbo: false } do |f| %>
        <div class="space-y-3">
          <div>
            <label for="code" class="block text-xs font-semibold text-ink-soft mb-1"><%= t("auth.two_factor_challenge.code_label") %></label>
            <%= f.text_field :code, id: "code", autofocus: true, autocomplete: "one-time-code", required: true,
                  spellcheck: false, autocapitalize: "off", maxlength: 32,
                  class: "w-full px-3 py-2.5 border border-dark-line bg-bg rounded-md text-sm focus:outline-none focus:shadow-brutal-sm" %>
            <p class="text-[11px] text-dim mt-1"><%= t("auth.two_factor_challenge.hint") %></p>
          </div>
          <%= f.submit t("auth.two_factor_challenge.submit"),
                class: Atoms::ButtonComponent.new(variant: :primary, size: :md, class: "w-full").classes %>
        </div>
      <% end %>
    </div>
    <p class="text-center mt-5 text-[11px] text-dim">
      <%= link_to t("auth.two_factor_challenge.back"), new_user_session_path, class: "hover:text-accent" %>
    </p>
  </div>
</div>
