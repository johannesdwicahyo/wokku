<%= render Organisms::AuthShellComponent.new do %>
  <div>
    <h1 class="text-[38px] font-normal tracking-[-.04em] leading-[1.05] m-0"><%= t("auth.two_factor_challenge.title") %></h1>
    <p class="text-ink-soft text-base mt-1.5 mb-0"><%= t("auth.two_factor_challenge.sub") %></p>
  </div>

  <%= render "devise/shared/auth_flash" %>

  <%# id signin-form: typing the code wakes the light wall, like the password form. %>
  <%= form_with url: users_two_factor_path, method: :post, id: "signin-form", class: "flex flex-col gap-[22px]", data: { turbo: false } do |f| %>
    <div class="flex flex-col gap-2">
      <label for="code" class="font-mono text-[11px] uppercase tracking-[.12em] text-muted"><%= t("auth.two_factor_challenge.code_label") %></label>
      <%= f.text_field :code, id: "code", autofocus: true, autocomplete: "one-time-code", required: true,
            spellcheck: false, autocapitalize: "off", maxlength: 32, inputmode: "text",
            aria: { describedby: "code-hint" }, class: "auth-input font-mono tracking-[.2em]" %>
      <p id="code-hint" class="text-[13px] text-muted m-0"><%= t("auth.two_factor_challenge.hint") %></p>
    </div>
    <%= f.button t("auth.two_factor_challenge.submit"), type: "submit",
          class: Atoms::ButtonComponent.new(variant: :primary, class: "w-full h-[50px]").classes %>
  <% end %>

  <p class="text-[15px] m-0">
    <%= link_to t("auth.two_factor_challenge.back"), new_user_session_path, class: "text-ink-soft hover:text-ink" %>
  </p>
<% end %>
