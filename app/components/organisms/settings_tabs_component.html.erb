<div class="border-b border-line-soft">
  <div class="flex items-center gap-1 pb-3 text-sm overflow-x-auto">
    <% tabs.each do |t| %>
      <%= link_to tab_label(t), tab_href(t),
            class: "px-3 py-1.5 rounded-md whitespace-nowrap transition-colors #{t == active_tab ? 'bg-rule-soft text-ink font-medium' : 'text-ink-soft hover:bg-rule-soft/60'}" %>
    <% end %>
  </div>
</div>

<div class="pt-5">
  <%= content %>
</div>
