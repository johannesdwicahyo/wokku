<div class="mb-5 inline-flex border-1.5 border-ink rounded-md overflow-hidden shadow-brutal-sm max-w-full overflow-x-auto">
  <% Organisms::AppSettingsComponent::SECTIONS.each do |s| %>
    <%= link_to s.to_s.titleize, helpers.section_path(:settings, app, s),
                class: "px-3 py-1.5 text-xs font-semibold whitespace-nowrap border-r-1.5 border-ink last:border-r-0 transition-colors #{active == s ? 'bg-ink text-paper' : 'bg-paper text-dim hover:bg-bg-deep'}" %>
  <% end %>
</div>
<div><%= content %></div>

<% shared_tenants = app.database_services.shared_tenants.order(:service_type) %>
<% if Addons::SharedProvisioner.feature_enabled? && shared_tenants.any? %>
  <section class="app-settings__addons mt-8" data-controller="addons-stream"
           data-turbo-stream-channel="user_<%= app.created_by_id %>_addons">
    <h2 class="font-mono text-[13px] font-bold uppercase mb-4">Add-ons</h2>
    <% shared_tenants.each do |db| %>
      <%= render Organisms::App::SharedAddonCardComponent.new(app: app, database_service: db) %>
    <% end %>
  </section>
<% end %>
