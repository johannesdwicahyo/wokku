<div class="mb-5 inline-flex border-1.5 border-ink rounded-md overflow-hidden shadow-brutal-sm max-w-full overflow-x-auto">
  <% Organisms::PerformanceTabsComponent::SECTIONS.each do |s| %>
    <%= link_to section_label(s), section_href(s),
                class: "px-3 py-1.5 text-xs font-semibold whitespace-nowrap border-r-1.5 border-ink last:border-r-0 transition-colors #{active == s ? 'bg-ink text-paper' : 'bg-paper text-dim hover:bg-bg-deep'}" %>
  <% end %>
</div>
<div><%= content %></div>
