<nav class="docs-side" aria-label="<%= t("docs.top.guides") %>" data-controller="docs-sidebar">
  <% sidebar.each do |section| %>
    <details class="cat" <%= "open" if section_open?(section) %>>
      <summary><span><%= section["title"] %></span></summary>
      <ul>
        <% section["items"].each do |item| %>
          <li><%= render Molecules::DocsNavLinkComponent.new(
                label: item["title"],
                href: "/docs/#{item['path']}",
                active: active?(item)
              ) %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</nav>
