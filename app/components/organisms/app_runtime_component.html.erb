<div class="mb-5 inline-flex border border-line rounded-md overflow-hidden shadow-brutal-sm max-w-full overflow-x-auto">
  <% Organisms::AppRuntimeComponent::SECTIONS.each do |s| %>
    <%= link_to s.to_s.titleize, helpers.section_path(:runtime, app, s),
                class: "px-3 py-1.5 text-xs font-semibold whitespace-nowrap border-r border-line last:border-r-0 transition-colors #{active == s ? 'bg-ink text-paper' : 'bg-paper text-dim hover:bg-bg-deep'}" %>
  <% end %>
</div>
<div><%= content %></div>
