<nav class="docs-pager" aria-label="<%= t("docs.pager.label") %>">
  <% if prev_item %>
    <%= link_to "/docs/#{prev_item['path']}" do %>
      <span class="docs-label">← <%= t("docs.pager.previous") %></span>
      <b><%= prev_item["title"] %></b>
    <% end %>
  <% else %>
    <span></span>
  <% end %>
  <% if next_item %>
    <%= link_to "/docs/#{next_item['path']}", class: "is-next" do %>
      <span class="docs-label"><%= t("docs.pager.next") %> →</span>
      <b><%= next_item["title"] %></b>
    <% end %>
  <% end %>
</nav>
