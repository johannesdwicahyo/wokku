<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_360px] gap-4">
  <div class="min-w-0 space-y-4">
    <%= render Organisms::AppStatusBoardComponent.new(app: app, stats: stats, current_release: current_release) %>
    <%= render Organisms::AppMetricsPanelComponent.new(stats: stats) %>
    <%= render Organisms::AppProcessesComponent.new(app: app, can_update: can_update) %>
    <%= render Organisms::AppLiveLogComponent.new(app: app, process_types: process_types) %>
  </div>

  <div class="min-w-0 space-y-4">
    <%= render Organisms::AppDeploysTimelineComponent.new(app: app, releases: releases, current_release: current_release, can_update: can_update) %>
    <%= render Organisms::AppConnectedComponent.new(app: app) %>
    <%= render Organisms::AppDomainsPanelComponent.new(app: app, domains: domains) %>
    <%= render Organisms::AppResourcesPanelComponent.new(app: app) %>
    <% if storage %>
      <%= render Molecules::ObjectStorageCardComponent.new(bucket: storage) %>
    <% end %>
    <% if databases? %>
      <%= render Molecules::BackupsSummaryCardComponent.new(app: app, current_user: helpers.current_user, can_update: can_update) %>
    <% end %>
  </div>
</div>
