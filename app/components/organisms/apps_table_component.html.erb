<%# app/components/organisms/apps_table_component.html.erb %>
<div class="bg-paper border-1.5 border-ink rounded-md shadow-brutal overflow-x-auto">
  <table class="w-full text-[13.5px]">
    <thead>
      <tr class="bg-bg border-b-1.5 border-ink text-[10.5px] font-bold uppercase tracking-[.06em] text-dim text-left">
        <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.apps.columns.app", default: "App") %></th>
        <th scope="col" class="px-3.5 py-2.5 font-bold"><%= t("dashboard.apps.columns.status", default: "Status") %></th>
        <th scope="col" class="hidden sm:table-cell px-3.5 py-2.5 font-bold"><%= t("dashboard.apps.columns.size", default: "Size") %></th>
        <th scope="col" class="hidden md:table-cell px-3.5 py-2.5 font-bold"><%= t("dashboard.apps.columns.domain", default: "Domain") %></th>
        <th scope="col" class="hidden md:table-cell px-3.5 py-2.5 font-bold"><%= t("dashboard.apps.columns.last_deploy", default: "Last deploy") %></th>
      </tr>
    </thead>
    <tbody data-controller="grid-nav" data-action="keydown->grid-nav#keydown">
      <% apps.each do |app| %>
        <% deployed_at = last_deployed_at(app) %>
        <% status_pill = Atoms::StatusPillComponent.new(status: app.display_status) %>
        <%# Rows are focusable (tabindex/role/aria-label) and grid-nav above
            handles Arrow/Home/End/Space; Enter fires a native click. Making
            the row focusable also fixes slide-panel's focus-restore: it
            stores document.activeElement on open, which is now the row
            instead of <body>, so closing the panel returns focus here. %>
        <tr data-grid-nav-target="row" tabindex="0" role="button"
            aria-label="<%= app.name %>, <%= status_pill.spec[:label] %>"
            data-action="click->record-panel#show" data-record-panel-src-param="<%= panel_dashboard_app_path(app) %>"
            class="border-b border-line last:border-b-0 hover:bg-bg-deep transition-colors cursor-pointer">
          <td class="px-3.5 py-2.5">
            <%= link_to dashboard_app_path(app), class: "flex items-center gap-2.5 font-semibold hover:underline" do %>
              <span class="w-[22px] h-[22px] border-1.5 border-ink rounded grid place-items-center font-extrabold text-[11px] bg-paper flex-shrink-0"><%= app_mark(app) %></span>
              <%= app.name %>
            <% end %>
            <% if (stats = stats_line(app)) %>
              <div class="pl-8 mt-0.5 text-[11.5px] text-dim font-mono"><%= stats %></div>
            <% end %>
          </td>
          <td class="px-3.5 py-2.5"><%= status_pill.render_in(self) %></td>
          <td class="hidden sm:table-cell px-3.5 py-2.5 text-[12.5px] text-dim"><%= box_label(app) %></td>
          <td class="hidden md:table-cell px-3.5 py-2.5 text-[12.5px] text-dim"><%= primary_domain(app) || "—" %></td>
          <td class="hidden md:table-cell px-3.5 py-2.5 text-[12.5px] text-dim"><%= if deployed_at then "#{time_ago_in_words(deployed_at)} ago" elsif status_pill.status == "deploy_failed" then "failed" else "never" end %></td>
        </tr>
      <% end %>
      <tr class="border-t border-dashed border-faint hover:bg-bg-deep transition-colors">
        <td colspan="5" class="px-3.5 py-2.5">
          <%= link_to "+ New app", new_dashboard_app_path, data: { turbo_frame: "_top" },
                class: "block text-[13px] font-semibold text-faint hover:text-ink" %>
        </td>
      </tr>
    </tbody>
  </table>
</div>
