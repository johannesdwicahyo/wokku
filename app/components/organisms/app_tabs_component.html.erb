<% active = active_tab %>
<% unless active == :overview %>
  <p class="mb-2 flex items-center gap-2 font-mono text-[13px]">
    <%= render Atoms::StatusLightComponent.new(state: app.display_status) %>
    <%= link_to app.name, helpers.dashboard_app_path(app), class: "text-ink hover:underline truncate" %>
  </p>
<% end %>
<nav aria-label="<%= t("dashboard.app_header.tabs_label") %>" class="mb-5 border-b border-line overflow-x-auto">
  <ul class="flex gap-1 min-w-max">
    <% TABS.each do |t| %>
      <li>
        <%= link_to tab_label(t), tab_href(t),
              "aria-current": (t == active ? "page" : nil),
              class: "block px-3.5 py-2.5 text-[13px] font-semibold whitespace-nowrap border-b-2 -mb-px transition-colors #{t == active ? 'border-live text-ink' : 'border-transparent text-dim hover:text-ink'}" %>
      </li>
    <% end %>
  </ul>
</nav>

<%# target: "_top" — links and forms in a tab navigate the whole page, so the
    URL updates, flash messages (rendered outside this frame) show, and pages
    without this frame don't render "Content missing". Nested frames keep
    their own targets. %>
<%= helpers.turbo_frame_tag "app_tab_content", target: "_top", class: "block", style: "animation: wk-tab-in var(--t-default) var(--ease);" do %>
  <%= content %>
<% end %>
