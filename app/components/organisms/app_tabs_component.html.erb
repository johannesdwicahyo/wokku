<div class="mb-5">
  <div class="flex items-center gap-3 flex-wrap">
    <div class="text-[13px] text-dim whitespace-nowrap">
      <%= link_to "Apps", helpers.dashboard_apps_path, class: "hover:text-ink hover:underline" %>
      <span class="mx-1">/</span>
      <span class="text-ink font-semibold"><%= app.name %></span>
    </div>
    <div class="inline-flex border border-line rounded-md overflow-hidden shadow-brutal-sm max-w-full overflow-x-auto">
      <% TABS.each do |t| %>
        <%= link_to tab_label(t), tab_href(t),
              class: "px-4 py-[7px] text-[13px] font-semibold whitespace-nowrap border-r border-line last:border-r-0 transition-colors #{t == active_tab ? 'bg-ink text-paper' : 'bg-paper text-dim hover:bg-bg-deep'}" %>
      <% end %>
    </div>
  </div>
</div>

<%# target: "_top" — links and forms in a tab navigate the whole page, so the
    URL updates, flash messages (rendered outside this frame) show, and pages
    without this frame don't render "Content missing". Nested frames keep
    their own targets. %>
<%= helpers.turbo_frame_tag "app_tab_content", target: "_top", class: "block", style: "animation: wk-tab-in var(--t-default) var(--ease);" do %>
  <%= content %>
<% end %>
