<aside class="fixed inset-y-0 left-0 z-30 w-[232px] bg-paper border-r-1.5 border-ink flex flex-col -translate-x-full lg:translate-x-0 transition-transform duration-200 px-3 pt-3.5 pb-3"
       id="dashboard-sidebar"
       data-mobile-nav-target="sidebar">
  <%# Workspace switcher — falls back to the plain logo when there's no
      multi-workspace context (admin layout). %>
  <div class="pb-2.5">
    <% if show_workspace_switcher? %>
      <div class="relative" data-controller="dropdown">
        <button type="button" data-action="click->dropdown#toggle"
                class="w-full flex items-center gap-2 px-2 py-1.5 rounded font-bold text-sm hover:bg-bg-deep transition-colors cursor-pointer"
                aria-haspopup="true">
          <%= render Atoms::LogoComponent.new(variant: :mark, size: :sm, animated: true) %>
          <span class="truncate flex-1 text-left"><%= workspace_option_label(current_workspace) %></span>
          <span class="ml-auto text-faint text-[10px]">▾</span>
        </button>
        <div data-dropdown-target="menu"
             class="hidden absolute left-0 top-full mt-1 w-64 bg-paper border-1.5 border-ink rounded-md shadow-brutal-sm z-50">
          <div class="px-3 py-2 border-b border-rule-soft">
            <p class="text-[11px] font-medium text-dim">Workspaces</p>
          </div>
          <% workspaces.each do |ws| %>
            <% if ws.id == current_workspace.id %>
              <div class="flex items-center justify-between px-3 py-2 bg-bg-deep text-xs">
                <span class="text-ink font-semibold truncate"><%= workspace_option_label(ws) %></span>
                <span class="text-[11px] font-medium text-accent">Current</span>
              </div>
            <% else %>
              <%= button_to switch_dashboard_workspace_path(ws), method: :post,
                    class: "w-full flex items-center justify-between px-3 py-2 text-xs text-ink-soft hover:bg-bg-deep hover:text-ink transition-colors" do %>
                <span class="truncate"><%= workspace_option_label(ws) %></span>
                <span class="text-[11px] font-medium text-dim"><%= ws.kind %></span>
              <% end %>
            <% end %>
          <% end %>
          <% if workspace_new_path %>
            <%= link_to workspace_new_path,
                  class: "block px-3 py-2 text-xs text-accent border-t border-rule-soft hover:bg-bg-deep transition-colors" do %>
              + New workspace
            <% end %>
          <% end %>
          <% if workspaces_index_path %>
            <%= link_to workspaces_index_path,
                  class: "block px-3 py-2 text-[11px] text-dim hover:bg-bg-deep hover:text-ink transition-colors" do %>
              Manage →
            <% end %>
          <% end %>
        </div>
      </div>
    <% else %>
      <%= render Atoms::LogoComponent.new(size: :sm, href: "/", animated: true) %>
    <% end %>
  </div>

  <%# App search — ⌘K field per spec §1. This is the command menu's trigger:
      clicking it opens the same palette as ⌘K (command_menu_controller
      delegates clicks on [data-command-menu-open]). A mouse path matters
      because some browsers reserve ⌘K for their own UI. %>
  <% if search_url.present? %>
    <button type="button" data-command-menu-open
            aria-label="<%= search_placeholder %>"
            class="flex items-center gap-2 w-full mx-0 mb-2.5 px-2.5 py-1.5 border-1.5 border-line rounded-md bg-bg text-[13px] text-faint cursor-pointer hover:border-ink transition-colors">
      <span class="w-3.5 h-3.5 [&>svg]:w-3.5 [&>svg]:h-3.5"><%= render "shared/icons/search" %></span>
      <span class="flex-1 text-left text-dim text-xs"><%= search_placeholder %></span>
      <kbd class="ml-auto text-[10.5px] font-semibold text-dim border border-line rounded bg-paper px-1.5">⌘K</kbd>
    </button>
  <% end %>

  <%# Nav groups — first group unlabeled (objects), later groups labeled. %>
  <div class="flex-1 overflow-y-auto">
    <% groups.each_with_index do |group, i| %>
      <div class="<%= "mt-4" if i.positive? %>">
        <% if group[:label].present? %>
          <div class="px-2 pb-1.5 mt-4 text-[11px] font-bold uppercase tracking-[.06em] text-dim"><%= group[:label] %></div>
        <% end %>
        <% group[:items].each do |item| %>
          <%= render Molecules::SidebarNavItemComponent.new(
                label: item[:label],
                key: item[:key],
                active: item[:active],
                href: item[:href],
                external: item.fetch(:external, false),
                icon: item[:icon],
                count: item[:count]
              ) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Rail footer — Docs · Support · locale, then the user block,
      then the version line (spec §1). %>
  <% if show_footer? %>
    <div class="border-t border-line pt-2.5">
      <% if footer_links.any? || locale_toggle_path.present? %>
        <div class="px-1 text-xs text-dim mb-2">
          <% if footer_links.any? %>
            <div class="flex items-center gap-3 mb-1.5">
              <% footer_links.each do |l| %>
                <%= link_to l[:label], l[:href],
                      class: "font-medium hover:text-ink hover:underline py-2 -my-2 px-1",
                      **(l[:external] ? { target: "_blank", rel: "noopener" } : {}) %>
              <% end %>
            </div>
          <% end %>
          <div class="flex items-center gap-2">
            <% if locale_toggle_path.present? %>
              <%= button_to locale.to_s.upcase, locale_toggle_path, method: :post,
                    form_class: "contents", title: locale_toggle_title,
                    class: "w-7 h-7 grid place-items-center border-1.5 border-line rounded text-[10px] font-bold text-dim hover:border-ink hover:text-ink transition-colors cursor-pointer p-0" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if show_user_block? %>
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle"
                  class="w-full flex items-center gap-2 px-1 py-1 rounded hover:bg-bg-deep transition-colors cursor-pointer"
                  aria-haspopup="true">
            <span class="w-[22px] h-[22px] border-1.5 border-ink rounded-full grid place-items-center font-extrabold text-[11px] bg-paper overflow-hidden flex-shrink-0">
              <% if user_avatar_url.present? %>
                <img src="<%= user_avatar_url %>" alt="avatar" class="w-full h-full object-cover">
              <% else %>
                <%= user_initial %>
              <% end %>
            </span>
            <span class="flex-1 min-w-0 text-left">
              <span class="block text-[12.5px] font-semibold text-ink truncate"><%= user_email %></span>
              <span class="block text-[11px] text-faint truncate"><%= user_role %></span>
            </span>
            <span class="ml-auto text-faint">⋯</span>
          </button>
          <div data-dropdown-target="menu"
               class="hidden absolute left-0 right-0 bottom-full mb-1 bg-paper border-1.5 border-ink rounded-md shadow-brutal-sm z-50">
            <%= link_to sign_out_label, sign_out_path, data: { turbo_method: :delete },
                  class: "block px-3 py-2 text-xs text-ink-soft hover:bg-bg-deep hover:text-ink transition-colors" %>
          </div>
        </div>
      <% end %>

      <% if version_line.present? %>
        <div class="px-1 pt-1 text-[10.5px] text-faint"><%= version_line %></div>
      <% end %>
    </div>
  <% end %>
</aside>
