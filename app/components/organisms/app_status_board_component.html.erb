<%= render Molecules::PanelComponent.new(ticks: true) do %>
  <section aria-label="<%= t("apps.detail.board.label") %>" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.15fr)_repeat(3,minmax(0,1fr))] [&>div]:min-w-0 [&>div]:flex [&>div]:flex-col [&>div]:gap-2 [&>div]:px-5 [&>div]:py-5 [&>div]:border-b [&>div]:border-line lg:[&>div]:border-b-0 lg:[&>div]:border-r lg:[&>div:last-child]:border-r-0">
    <div>
      <span class="font-mono text-[11px] uppercase tracking-[.12em] text-dim"><%= t("apps.detail.board.processes", count: count) %></span>
      <%= render Organisms::LightBoardComponent.new(mode: :fleet, data: fleet, label: board_label) %>
    </div>
    <%= render Molecules::ReadoutComponent.new(label: t("apps.detail.board.release"), value: release_value, sub: release_sub) %>
    <%= render Molecules::ReadoutComponent.new(label: t("apps.detail.board.response"), value: p95 || none, sub: (p95 && t("apps.detail.board.response_sub"))) %>
    <%= render Molecules::ReadoutComponent.new(label: t("apps.detail.board.errors"), value: err_pct || none, sub: err_sub) %>
  </section>
<% end %>
