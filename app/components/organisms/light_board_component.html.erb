<% if mode == :story %>
<div data-controller="light-board" data-light-board-mode-value="story"
     data-light-board-story-value="<%= data.to_json %>">
  <canvas class="wk-light-poster block w-full h-40 sm:h-56" aria-hidden="true" data-light-board-target="canvas"></canvas>
  <div class="mt-2 flex justify-between gap-4 font-mono text-[11px] uppercase tracking-wider text-muted" aria-hidden="true">
    <span data-light-board-target="left"><%= data[:repo] %></span>
    <span data-light-board-target="right"><%= story_status %></span>
  </div>
  <span class="sr-only"><%= label %></span>
</div>
<% elsif mode == :text %>
<canvas class="block w-full h-16" role="img" aria-label="<%= label %>"
        data-controller="light-board"
        data-light-board-mode-value="text"
        data-light-board-text-value="<%= data %>"></canvas>
<% else %>
<canvas class="block w-full h-16" aria-hidden="true"
        data-controller="light-board"
        data-light-board-mode-value="<%= mode %>"
        data-light-board-data-value="<%= data.to_json %>"></canvas>
<span class="sr-only"><%= label %></span>
<% end %>
