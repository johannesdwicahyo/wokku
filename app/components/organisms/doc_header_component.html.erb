<%# Doc article header: eyebrow → title → summary → meta row. %>
<% if eyebrow.present? %><div class="docs-label mb-2"><%= eyebrow %></div><% end %>
<h1 class="docs-title"><%= title %></h1>

<% if summary.present? %>
  <p class="docs-summary"><%= summary.html_safe %></p>
<% end %>

<div class="docs-meta">
  <% badges.each do |b| %>
    <%= render Atoms::TagComponent.new(tone: b[:tone]) do %><%= b[:label] %><% end %>
  <% end %>
  <% if edited.present? %><span><%= t("docs.header.edited_at", when: edited) %></span><% end %>
  <%= link_to "#{t('docs.header.edit_on_github')} ↗", source %>
</div>
