<aside class="docs-toc" aria-labelledby="docs-toc-label">
  <span id="docs-toc-label" class="docs-label"><%= t("docs.toc.label") %></span>
  <ol data-controller="docs-scrollspy">
    <% items.each_with_index do |item, i| %>
      <li><a href="#<%= item[:id] %>"
             class="toc-link <%= 'is-h3' if item[:level] == 3 %>"
             data-docs-scrollspy-target="link"
             <%= 'aria-current="true"'.html_safe if i.zero? %>><%= item[:label] || item[:text] %></a></li>
    <% end %>
  </ol>
</aside>
