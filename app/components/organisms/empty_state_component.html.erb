<div class="border border-line bg-bg-deep rounded-md p-12 text-center">
  <h3 class="font-headline text-xl font-extrabold mb-2"><%= headline %></h3>
  <p class="text-ink-soft mb-6 max-w-md mx-auto"><%= body %></p>
  <% if cta_label && cta_href %>
    <div class="flex justify-center gap-3">
      <%= render Atoms::ButtonComponent.new(variant: :primary, size: :md, href: cta_href) do %><%= cta_label %><% end %>
      <% if secondary_label && secondary_href %>
        <%= render Atoms::ButtonComponent.new(variant: :outline, size: :md, href: secondary_href) do %><%= secondary_label %><% end %>
      <% end %>
    </div>
  <% end %>
</div>
