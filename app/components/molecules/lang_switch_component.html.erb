<%#
  Locale switch for the marketing/landing surface. Uses the app's
  existing LocalesController (POST /locale → cookie-persisted, 1yr,
  + redirect_back) — NOT a ?locale= URL param. Same mechanism as the
  console topbar's locale toggle, so the choice persists and the URL
  stays clean.
%>
<div class="inline-flex p-0.5 bg-paper border border-line rounded-full">
  <% %i[en id].each do |loc| %>
    <%= button_to public_locale_path(locale: loc),
          method: :post,
          form_class: "contents",
          title: t_label(loc),
          aria: { label: "#{loc.to_s.upcase}, #{t_label(loc)}", current: (active?(loc) ? "true" : nil) },
          lang: (loc == :id ? "id" : nil),
          class: "#{cell_classes(loc)} rounded-full border-0" do %><%= loc.to_s.upcase %><% end %>
  <% end %>
</div>
