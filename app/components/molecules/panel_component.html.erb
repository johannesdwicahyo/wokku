<div class="<%= "corner " if ticks %>border border-line bg-paper rounded-lg">
  <% if label.present? %>
    <div class="flex items-center justify-between px-4 py-2.5 border-b border-rule-soft text-[11px] font-medium text-dim normal-case tracking-normal">
      <span><%= label %></span>
      <% if kicker.present? %><span class="text-dim normal-case tracking-tight"><%= kicker %></span><% end %>
    </div>
  <% end %>
  <%= content %>
</div>
