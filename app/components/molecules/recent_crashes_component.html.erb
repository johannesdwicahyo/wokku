<div class="border-1.5 border-ink bg-paper p-5">
  <div class="font-mono text-[10.5px] uppercase tracking-widest text-ink-soft mb-3">// recent crashes</div>
  <% crashes.each do |c| %>
    <div class="font-mono text-xs text-ink-soft border-t-1.5 border-ink pt-2 mt-2 first:border-t-0 first:pt-0 first:mt-0">
      <div>
        <span class="text-ink"><%= c.exited_at.strftime("%b %d %H:%M") %></span>
        &middot; exit <span class="text-ink"><%= c.exit_code %></span><% if c.oom_killed %> &middot; <span class="text-accent font-semibold">OOM-killed</span><% end %>
      </div>
      <% if c.log_excerpt.present? %>
        <pre class="mt-1 whitespace-pre-wrap break-all bg-bg border-1.5 border-ink px-2 py-1 text-dim"><%= c.log_excerpt.to_s.lines.last(6).join %></pre>
      <% end %>
    </div>
  <% end %>
</div>
