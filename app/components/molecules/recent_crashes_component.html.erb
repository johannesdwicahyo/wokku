<div class="border border-line bg-paper rounded-lg p-5">
  <div class="text-[11px] font-medium text-dim normal-case tracking-normal mb-3">Recent crashes</div>
  <% crashes.each do |c| %>
    <div class="text-xs text-ink-soft border-t border-line pt-2 mt-2 first:border-t-0 first:pt-0 first:mt-0">
      <div>
        <span class="text-ink"><%= c.exited_at.strftime("%b %d %H:%M") %></span>
        &middot; exit <span class="text-ink"><%= c.exit_code %></span><% if c.oom_killed %> &middot; <span class="text-accent font-semibold">OOM-killed</span><% end %>
      </div>
      <% if c.log_excerpt.present? %>
        <pre class="mt-1 whitespace-pre-wrap break-all bg-bg border border-line rounded-md px-2 py-1 font-mono text-dim"><%= c.log_excerpt.to_s.lines.last(6).join %></pre>
      <% end %>
    </div>
  <% end %>
</div>
