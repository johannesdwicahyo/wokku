<div class="border-1.5 border-ink bg-paper p-4">
  <div class="font-mono text-[10.5px] uppercase tracking-widest text-ink-soft mb-2">// backups</div>
  <div class="text-sm">
    <% if last_backup %>
      <b>Last: <%= time_ago_in_words(last_backup.created_at) %> ago</b>
    <% elsif has_database %>
      <b>No backups yet</b>
    <% else %>
      <b class="text-dim">No database attached</b>
    <% end %>
  </div>
  <div class="font-mono text-[10px] text-dim mt-2"><%= policy_label %></div>

  <% if has_database %>
    <div class="mt-3">
      <%= render Atoms::OptimisticButtonComponent.new(
            label: "backup now",
            url: helpers.backup_now_dashboard_app_path(app),
            method: :post,
            pending_label: "queueing…",
            kind: :secondary
          ) %>
    </div>
  <% end %>
</div>
