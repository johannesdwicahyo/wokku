<div class="border border-line bg-paper rounded-lg p-4">
  <div class="text-[11px] font-medium text-dim normal-case tracking-normal mb-2">Backups</div>
  <div class="text-sm">
    <% if last_backup %>
      <b>Last: <%= time_ago_in_words(last_backup.created_at) %> ago</b>
    <% elsif has_database %>
      <b>No backups yet</b>
    <% else %>
      <b class="text-dim">No database attached</b>
    <% end %>
  </div>
  <div class="text-[11px] text-dim mt-2"><%= policy_label %></div>

  <% if has_database %>
    <div class="mt-3">
      <%= render Atoms::OptimisticButtonComponent.new(
            label: "backup now",
            url: helpers.backup_now_dashboard_app_path(app),
            method: :post,
            pending_label: "queueing…",
            kind: :secondary
          ) %>
    </div>
  <% end %>
</div>
