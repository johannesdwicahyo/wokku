<div>
  <div class="font-mono text-[11px] uppercase tracking-[.1em] text-dim"><%= label %></div>
  <div class="font-mono tabular-nums text-[30px] leading-tight <%= value_class %>"><%= value %></div>
  <% if sub.present? %><div data-sub class="font-mono text-[11px] text-dim"><%= sub %></div><% end %>
</div>
