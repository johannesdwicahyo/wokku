<%= button_to path, method: :post, data: data, form_class: (wide ? "col-span-2" : nil),
      aria: { label: accessible_name }, class: button_classes do %>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" class="shrink-0">
    <%= icon %>
  </svg>
  <span><%= label %></span>
<% end %>
