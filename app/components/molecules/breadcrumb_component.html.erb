<nav class="font-mono text-xs text-dim mb-6 flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
  <% crumbs.each_with_index do |(label, href), i| %>
    <% if i.positive? %><span style="color: var(--color-rule-soft)">/</span><% end %>
    <% last = i == crumbs.size - 1 %>
    <% if href && !last %>
      <%= link_to label, href, class: "no-underline hover:text-ink" %>
    <% else %>
      <span class="<%= 'text-accent' if last %>"><%= label %></span>
    <% end %>
  <% end %>
</nav>
