<div class="p-4 bg-paper border border-line rounded-lg flex flex-col gap-3.5" style="aspect-ratio: 1;">
  <img src="<%= asset_path("icons/#{icon}.svg") rescue "/assets/icons/#{icon}.svg" %>" class="w-8 h-8" alt=""/>
  <div class="mt-auto">
    <div class="font-sans text-base font-bold text-ink tracking-tight"><%= name %></div>
    <div class="text-[11px] font-medium text-dim mt-1 normal-case tracking-normal"><%= category %></div>
    <div class="font-mono text-[10px] text-accent mt-1.5"><%= cmd %></div>
  </div>
</div>
