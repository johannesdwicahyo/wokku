<%# app/components/molecules/skeleton_component.html.erb %>
<div class="skeleton relative" data-skeleton-variant="<%= variant %>" aria-busy="true" aria-live="polite">
  <% case variant %>
  <% when :table %>
    <div class="border border-line rounded-lg">
      <% rows.times do %>
        <div data-skeleton-row class="flex items-center gap-4 px-4 py-3 border-b border-line last:border-b-0">
          <div class="<%= bar %> h-3 w-1/4"></div>
          <div class="<%= bar %> h-3 w-1/5"></div>
          <div class="<%= bar %> h-3 w-1/6 ml-auto"></div>
        </div>
      <% end %>
    </div>
  <% when :tiles %>
    <div class="grid grid-cols-1 gap-3" style="grid-template-columns: repeat(<%= cols %>, minmax(0, 1fr));">
      <% cols.times do %>
        <div class="border border-line rounded-lg p-5 space-y-3">
          <div class="<%= bar %> h-2.5 w-1/3"></div>
          <div class="<%= bar %> h-7 w-2/3"></div>
        </div>
      <% end %>
    </div>
  <% when :chart %>
    <div class="border border-line rounded-lg p-5">
      <div class="<%= bar %> h-2.5 w-1/4 mb-4"></div>
      <div class="<%= bar %> h-40 w-full"></div>
    </div>
  <% when :text %>
    <div class="border border-line bg-paper rounded-lg p-3 space-y-2 min-h-[6rem]">
      <div class="bg-line motion-safe:animate-pulse h-2.5 w-3/4"></div>
      <div class="bg-line motion-safe:animate-pulse h-2.5 w-2/3"></div>
      <div class="bg-line motion-safe:animate-pulse h-2.5 w-1/2"></div>
    </div>
  <% else %>
    <div class="border border-line rounded-lg p-5 space-y-3">
      <div class="<%= bar %> h-2.5 w-1/3"></div>
      <div class="<%= bar %> h-4 w-full"></div>
      <div class="<%= bar %> h-4 w-5/6"></div>
    </div>
  <% end %>
  <div class="wk-skeleton-loader"><%= render Atoms::LightsLoaderComponent.new(decorative: true, size: :lg) %></div>
</div>
