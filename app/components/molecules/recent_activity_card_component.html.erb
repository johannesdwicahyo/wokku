<div class="border border-line bg-paper rounded-lg p-5">
  <div class="text-[11px] font-medium text-dim normal-case tracking-normal mb-3"><%= t("dashboard.recent_activity") %></div>
  <% if empty? %>
    <div class="text-sm text-dim">Nothing here yet. Deploy an app to see activity.</div>
  <% else %>
    <ul class="space-y-1.5">
      <% events.each do |e| %>
        <li class="text-[13px] leading-relaxed">
          <span class="text-dim"><%= time_ago(e.created_at) %></span>
          ·
          <%= e.respond_to?(:description) ? e.description : e.to_s %>
          <% if e.respond_to?(:target_name) && e.target_name.present? %>
            <span class="text-ink-soft"><%= e.target_name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
