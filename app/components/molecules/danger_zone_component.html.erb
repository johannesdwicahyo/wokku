<div class="border border-danger rounded-md bg-danger-soft">
  <div class="px-6 py-4 border-b border-rule-soft">
    <h2 class="font-headline font-bold text-danger"><%= title %></h2>
    <% if body.present? %>
      <p class="text-sm text-ink-soft mt-1"><%= body %></p>
    <% end %>
  </div>

  <div class="px-6 py-5">
    <%= content %>
  </div>
</div>
