<div class="px-7 py-8 bg-paper <%= border_classes %>">
  <div class="flex items-center justify-between mb-4">
    <div class="inline-flex items-center gap-2.5 font-mono text-[11px] text-dim tracking-widest">
      <span class="w-2.5 h-2.5 rounded-full <%= dot_class %>"></span>
      <%= num %>
    </div>
    <span class="font-mono text-[10px] text-dim tracking-widest uppercase"><%= tag %></span>
  </div>
  <h3 class="font-sans text-3xl font-bold tracking-tight text-ink m-0 leading-tight"><%= title %></h3>
  <p class="font-sans text-base leading-relaxed text-ink-soft mt-3.5 mb-0 max-w-md"><%= body %></p>
</div>
