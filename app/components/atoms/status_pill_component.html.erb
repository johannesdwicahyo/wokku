<span class="inline-flex items-center gap-1.5 border-1.5 px-3 py-1 font-mono text-[11px] uppercase tracking-wider <%= spec[:color] %>"
      data-controller="motion--status-pulse"
      data-motion--status-pulse-status-value="<%= status %>">
  <span class="wk-dot" style="background: <%= spec[:dot_color] %>"></span><%= spec[:label] %>
</span>
