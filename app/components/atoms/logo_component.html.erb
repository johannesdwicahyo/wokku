<% wrapper_tag = href ? :a : :span %>
<%= content_tag(wrapper_tag, href: href, class: "inline-flex items-center gap-2.5 no-underline") do %>
  <span class="inline-flex items-center justify-center font-sans font-extrabold tracking-tightest text-bg bg-ink rounded-md"
        style="width: <%= size %>px; height: <%= size %>px; font-size: <%= (size * 0.62).round %>px;">w</span>
  <span class="font-sans font-bold text-ink tracking-tightest" style="font-size: <%= (size * 0.58).round %>px;"><%= t('brand.name') %></span>
<% end %>
