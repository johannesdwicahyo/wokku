<% wrapper_tag = href ? :a : :span %>
<%= content_tag(wrapper_tag, href: href, class: "inline-flex items-center no-underline text-ink") do %>
  <% if variant == :lockup %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="20 64 664 128" height="<%= size %>" role="img" aria-label="Wokku" fill="currentColor">
      <% SQUARES.each do |x, y| %><rect x="<%= x %>" y="<%= y %>" width="40" height="40" rx="10"/><% end %>
      <rect x="108" y="108" width="40" height="40" rx="10" fill="<%= LIVE %>"/>
      <%= render "shared/logo_wordmark_path" %>
    </svg>
  <% else %>
    <% tile = variant == :tile %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="<%= size %>" height="<%= size %>" role="img" aria-label="Wokku" fill="<%= tile ? "#FFFFFF" : "currentColor" %>">
      <% if tile %><rect width="256" height="256" rx="48" fill="#141414"/><% end %>
      <g<% if tile %> transform="translate(128 128) scale(.9) translate(-128 -128)"<% end %>>
        <% SQUARES.each do |x, y| %><rect x="<%= x %>" y="<%= y %>" width="40" height="40" rx="10"/><% end %>
        <rect x="108" y="108" width="40" height="40" rx="10" fill="<%= LIVE %>"/>
      </g>
    </svg>
  <% end %>
<% end %>
