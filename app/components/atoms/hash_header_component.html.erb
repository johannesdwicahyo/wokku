<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-6">
  <h2 class="font-semibold tracking-tighter text-ink m-0 break-words min-w-0 <%= size %>">
    <%= title %>
  </h2>
  <% if kicker.present? %>
    <span class="text-[11px] font-medium text-dim normal-case tracking-normal break-words"><%= kicker %></span>
  <% end %>
</div>
